import React, { useEffect, useMemo, useState } from "react";
import {
  Activity,
  BarChart3,
  BellRing,
  BookOpen,
  Building2,
  CalendarDays,
  Database,
  GraduationCap,
  Layers3,
  Loader2,
  ShieldCheck,
  UsersRound,
  Wrench,
} from "lucide-react";
import {
  Area,
  AreaChart,
  Bar,
  BarChart,
  CartesianGrid,
  Cell,
  Pie,
  PieChart,
  RadialBar,
  RadialBarChart,
  ResponsiveContainer,
  Tooltip,
  XAxis,
  YAxis,
} from "recharts";
import { getPlatformAnalytics, type PlatformAnalytics } from "../../services/djangoApiService";

const chartColors = ["#4f46e5", "#06b6d4", "#10b981", "#f59e0b", "#f43f5e", "#8b5cf6"];

function ChartCard({
  title,
  subtitle,
  children,
  className = "",
}: {
  title: string;
  subtitle: string;
  children: React.ReactNode;
  className?: string;
}) {
  return (
    <section className={`min-w-0 overflow-hidden rounded-[22px] border border-slate-200 bg-white p-3 shadow-[0_16px_44px_rgba(15,23,42,0.06)] dark:border-slate-800 dark:bg-slate-900 sm:rounded-[30px] sm:p-5 md:p-6 ${className}`}>
      <div className="min-w-0">
        <h3 className="break-words text-base font-black leading-tight text-slate-950 dark:text-white sm:text-lg">{title}</h3>
        <p className="mt-1 break-words text-[11px] font-semibold leading-relaxed text-slate-500 dark:text-slate-400 sm:text-xs">{subtitle}</p>
      </div>
      <div className="mt-4 min-w-0 sm:mt-5">{children}</div>
    </section>
  );
}

function MetricCard({
  label,
  value,
  meta,
  icon: Icon,
  accent,
}: {
  label: string;
  value: number | string;
  meta: string;
  icon: React.ComponentType<{ size?: number }>;
  accent: string;
}) {
  return (
    <article className="group relative min-w-0 overflow-hidden rounded-[22px] border border-slate-200 bg-white p-4 sm:rounded-[26px] sm:p-5 shadow-[0_14px_38px_rgba(15,23,42,0.06)] transition hover:-translate-y-1 hover:shadow-[0_22px_52px_rgba(15,23,42,0.1)] dark:border-slate-800 dark:bg-slate-900">
      <div className={`absolute -right-8 -top-10 h-28 w-28 rounded-full opacity-15 blur-2xl ${accent}`} />
      <div className="relative flex min-w-0 items-start justify-between gap-3 sm:gap-4">
        <div className="min-w-0">
          <div className="text-[10px] font-black uppercase tracking-[0.14em] text-slate-500 dark:text-slate-400">{label}</div>
          <div className="mt-3 break-words text-2xl font-black text-slate-950 dark:text-white sm:text-3xl">{value}</div>
          <div className="mt-1 break-words text-xs font-bold text-slate-500 dark:text-slate-400">{meta}</div>
        </div>
        <span className={`grid h-10 w-10 shrink-0 place-items-center rounded-2xl sm:h-12 sm:w-12 text-white shadow-lg ${accent}`}><Icon size={21} /></span>
      </div>
    </article>
  );
}

function ChartLegend({
  items,
}: {
  items: Array<{ label: string; color: string; value?: string | number }>;
}) {
  return (
    <div className="mt-3 grid min-w-0 grid-cols-2 gap-2 sm:flex sm:flex-wrap sm:items-center sm:justify-center sm:gap-x-4 sm:gap-y-2">
      {items.map((item) => (
        <div
          key={item.label}
          className="flex min-w-0 items-center gap-2 rounded-xl bg-slate-50 px-2.5 py-2 dark:bg-slate-800/80 sm:bg-transparent sm:px-0 sm:py-0 sm:dark:bg-transparent"
        >
          <span className="h-2.5 w-2.5 shrink-0 rounded-full" style={{ backgroundColor: item.color }} />
          <span className="min-w-0 break-words text-[10px] font-black leading-tight text-slate-600 dark:text-slate-300 sm:text-[11px]">
            {item.label}
          </span>
          {item.value !== undefined && (
            <span className="ml-auto shrink-0 text-[10px] font-black text-slate-950 dark:text-white sm:ml-0 sm:text-[11px]">
              {item.value}
            </span>
          )}
        </div>
      ))}
    </div>
  );
}

function EmptyChart() {
  return <div className="grid h-64 place-items-center rounded-2xl border border-dashed border-slate-300 text-sm font-bold text-slate-400 dark:border-slate-700">No data recorded yet</div>;
}

export default function PlatformAnalyticsOverview() {
  const [data, setData] = useState<PlatformAnalytics | null>(null);
  const [loading, setLoading] = useState(true);
  const [error, setError] = useState("");

  const load = async () => {
    setLoading(true);
    setError("");
    try {
      setData(await getPlatformAnalytics());
    } catch (err: any) {
      setError(err?.message || "Could not load platform analytics.");
    } finally {
      setLoading(false);
    }
  };

  useEffect(() => {
    void load();
  }, []);

  const radialData = useMemo(
    () => [
      { name: "Attendance", value: data?.summary.attendance_rate || 0, fill: "#4f46e5" },
      { name: "Features", value: data?.summary.feature_enablement_rate || 0, fill: "#06b6d4" },
    ],
    [data]
  );

  if (loading && !data) {
    return <div className="grid min-h-[460px] place-items-center rounded-[30px] border border-slate-200 bg-white dark:border-slate-800 dark:bg-slate-900"><div className="flex items-center gap-3 font-black text-slate-600 dark:text-slate-300"><Loader2 size={22} className="animate-spin text-indigo-600" /> Loading real platform analytics...</div></div>;
  }

  if (!data) {
    return <div className="rounded-[30px] border border-rose-200 bg-rose-50 p-6 text-sm font-bold text-rose-700 dark:border-rose-500/25 dark:bg-rose-500/10 dark:text-rose-300">{error || "Analytics are not available."}</div>;
  }

  const summary = data.summary;
  const cards = [
    { label: "Institutions", value: summary.institutions, meta: `${summary.active_institutions} active`, icon: Building2, accent: "bg-indigo-600" },
    { label: "Departments", value: summary.departments, meta: `${summary.active_departments} active`, icon: Layers3, accent: "bg-cyan-500" },
    { label: "Active Users", value: summary.active_users, meta: `${summary.users} total accounts`, icon: UsersRound, accent: "bg-emerald-500" },
    { label: "Students", value: summary.students, meta: `${summary.teachers} teachers`, icon: GraduationCap, accent: "bg-violet-500" },
    { label: "Active Schedules", value: summary.quran_schedules + summary.tuition_schedules, meta: `${summary.quran_schedules} Qur'an · ${summary.tuition_schedules} Tuition`, icon: CalendarDays, accent: "bg-amber-500" },
    { label: "Learning Records", value: summary.quran_lessons + summary.tuition_enrollments, meta: `${summary.quran_lessons} lessons · ${summary.tuition_enrollments} enrollments`, icon: BookOpen, accent: "bg-rose-500" },
    { label: "Backups", value: summary.backups, meta: "Protected database copies", icon: Database, accent: "bg-slate-700" },
    { label: "Communication", value: summary.active_notices + summary.active_maintenance, meta: `${summary.active_notices} notices · ${summary.active_maintenance} maintenance`, icon: BellRing, accent: "bg-fuchsia-500" },
  ];

  return (
    <div className="min-w-0 space-y-4 sm:space-y-6">
      {error && <div className="rounded-2xl border border-amber-200 bg-amber-50 px-4 py-3 text-sm font-bold text-amber-700 dark:border-amber-500/25 dark:bg-amber-500/10 dark:text-amber-300">{error}</div>}

      <div className="grid grid-cols-1 gap-4 sm:grid-cols-2 xl:grid-cols-4">
        {cards.map((card) => <MetricCard key={card.label} {...card} />)}
      </div>

      <div className="grid gap-6 xl:grid-cols-[1.5fr_0.8fr]">
        <ChartCard title="14-Day Platform Activity" subtitle="Qur'an attendance, Tuition attendance, lessons, and Main Admin changes from the database.">
          {data.activity_timeline.length ? (
            <>
              <div className="h-[220px] w-full min-w-0 overflow-hidden sm:h-[300px] lg:h-[330px]">
                <ResponsiveContainer width="100%" height="100%" minWidth={0}>
                  <AreaChart data={data.activity_timeline} margin={{ top: 8, right: 2, left: -28, bottom: 0 }}>
                    <defs>
                      <linearGradient id="quranActivity" x1="0" y1="0" x2="0" y2="1"><stop offset="5%" stopColor="#4f46e5" stopOpacity={0.34}/><stop offset="95%" stopColor="#4f46e5" stopOpacity={0}/></linearGradient>
                      <linearGradient id="tuitionActivity" x1="0" y1="0" x2="0" y2="1"><stop offset="5%" stopColor="#06b6d4" stopOpacity={0.3}/><stop offset="95%" stopColor="#06b6d4" stopOpacity={0}/></linearGradient>
                    </defs>
                    <CartesianGrid strokeDasharray="4 6" vertical={false} stroke="#e2e8f0" />
                    <XAxis dataKey="label" interval="preserveStartEnd" minTickGap={18} tick={{ fontSize: 9, fontWeight: 700, fill: "#64748b" }} axisLine={false} tickLine={false} />
                    <YAxis width={34} tick={{ fontSize: 9, fontWeight: 700, fill: "#64748b" }} axisLine={false} tickLine={false} allowDecimals={false} />
                    <Tooltip contentStyle={{ borderRadius: 16, border: "1px solid #e2e8f0", fontSize: 12, fontWeight: 700 }} />
                    <Area type="monotone" dataKey="quran_attendance" name="Qur'an Attendance" stroke="#4f46e5" strokeWidth={3} fill="url(#quranActivity)" />
                    <Area type="monotone" dataKey="tuition_attendance" name="Tuition Attendance" stroke="#06b6d4" strokeWidth={3} fill="url(#tuitionActivity)" />
                    <Area type="monotone" dataKey="lessons" name="Lessons" stroke="#10b981" strokeWidth={2.5} fillOpacity={0} />
                    <Area type="monotone" dataKey="admin_activity" name="Admin Activity" stroke="#f59e0b" strokeWidth={2.5} fillOpacity={0} />
                  </AreaChart>
                </ResponsiveContainer>
              </div>
              <ChartLegend items={[
                { label: "Qur'an Attendance", color: "#4f46e5" },
                { label: "Tuition Attendance", color: "#06b6d4" },
                { label: "Lessons", color: "#10b981" },
                { label: "Admin Activity", color: "#f59e0b" },
              ]} />
            </>
          ) : <EmptyChart />}
        </ChartCard>

        <ChartCard title="Platform Performance" subtitle="Attendance and permission enablement shown as live completion gauges.">
          <div className="relative h-[220px] w-full min-w-0 overflow-hidden sm:h-[300px] lg:h-[330px]">
            <ResponsiveContainer width="100%" height="100%" minWidth={0}>
              <RadialBarChart cx="50%" cy="48%" innerRadius="44%" outerRadius="78%" barSize={18} data={radialData} startAngle={210} endAngle={-30}>
                <RadialBar dataKey="value" background cornerRadius={18} />
                <Tooltip formatter={(value) => `${value}%`} contentStyle={{ borderRadius: 16, border: "1px solid #e2e8f0", fontSize: 12, fontWeight: 700 }} />
              </RadialBarChart>
            </ResponsiveContainer>
            <div className="pointer-events-none absolute inset-x-0 top-[41%] text-center">
              <div className="text-2xl font-black text-slate-950 dark:text-white sm:text-3xl">{summary.attendance_rate}%</div>
              <div className="text-[9px] font-black uppercase tracking-[0.1em] text-slate-400 sm:text-[10px]">Attendance rate</div>
            </div>
          </div>
          <ChartLegend items={[
            { label: "Attendance", color: "#4f46e5", value: `${summary.attendance_rate}%` },
            { label: "Features", color: "#06b6d4", value: `${summary.feature_enablement_rate}%` },
          ]} />
        </ChartCard>
      </div>

      <div className="grid gap-6 xl:grid-cols-2">
        <ChartCard title="Users by Role" subtitle="Every active portal category represented from the accounts database.">
          {data.users_by_role.length ? <div className="h-[270px] sm:h-[300px] lg:h-[320px]"><ResponsiveContainer width="100%" height="100%"><BarChart data={data.users_by_role} layout="vertical" margin={{ left: 18, right: 20 }}><CartesianGrid strokeDasharray="4 6" horizontal={false} stroke="#e2e8f0" /><XAxis type="number" allowDecimals={false} axisLine={false} tickLine={false} tick={{ fontSize: 10, fontWeight: 700, fill: "#64748b" }} /><YAxis type="category" dataKey="label" width={92} axisLine={false} tickLine={false} tick={{ fontSize: 10, fontWeight: 800, fill: "#475569" }} /><Tooltip cursor={{ fill: "rgba(99,102,241,0.06)" }} contentStyle={{ borderRadius: 16, border: "1px solid #e2e8f0", fontSize: 12, fontWeight: 700 }} /><Bar dataKey="value" name="Accounts" radius={[0, 12, 12, 0]}>{data.users_by_role.map((item, index) => <Cell key={item.key} fill={chartColors[index % chartColors.length]} />)}</Bar></BarChart></ResponsiveContainer></div> : <EmptyChart />}
        </ChartCard>

        <ChartCard title="Department Portfolio" subtitle="Distribution of Qur'an, Tuition, and future department types.">
          {data.department_types.length ? <div className="grid items-center gap-4 sm:grid-cols-[1fr_0.9fr]"><div className="h-[240px] sm:h-[280px]"><ResponsiveContainer width="100%" height="100%"><PieChart><Pie data={data.department_types} dataKey="value" nameKey="label" innerRadius={65} outerRadius={105} paddingAngle={5} cornerRadius={10}>{data.department_types.map((item, index) => <Cell key={item.key} fill={chartColors[index % chartColors.length]} />)}</Pie><Tooltip contentStyle={{ borderRadius: 16, border: "1px solid #e2e8f0", fontSize: 12, fontWeight: 700 }} /></PieChart></ResponsiveContainer></div><div className="space-y-3">{data.department_types.map((item, index) => <div key={item.key} className="flex items-center justify-between rounded-2xl bg-slate-50 px-4 py-3 dark:bg-slate-800"><span className="flex items-center gap-2 text-xs font-black"><span className="h-3 w-3 rounded-full" style={{ backgroundColor: chartColors[index % chartColors.length] }} />{item.label}</span><span className="text-sm font-black">{item.value}</span></div>)}</div></div> : <EmptyChart />}
        </ChartCard>
      </div>

      <div className="grid gap-6 xl:grid-cols-[1.05fr_0.95fr]">
        <ChartCard title="Attendance Status" subtitle="Combined comparison between Qur'an and Tuition attendance records.">
          {data.attendance_status.some((item) => item.total > 0) ? (
            <>
              <div className="h-[230px] w-full min-w-0 overflow-hidden sm:h-[300px]">
                <ResponsiveContainer width="100%" height="100%" minWidth={0}>
                  <BarChart data={data.attendance_status} margin={{ top: 8, right: 2, left: -28, bottom: 0 }}>
                    <CartesianGrid strokeDasharray="4 6" vertical={false} stroke="#e2e8f0" />
                    <XAxis dataKey="status" interval={0} axisLine={false} tickLine={false} tick={{ fontSize: 9, fontWeight: 800, fill: "#475569" }} />
                    <YAxis width={34} allowDecimals={false} axisLine={false} tickLine={false} tick={{ fontSize: 9, fontWeight: 700, fill: "#64748b" }} />
                    <Tooltip contentStyle={{ borderRadius: 16, border: "1px solid #e2e8f0", fontSize: 12, fontWeight: 700 }} />
                    <Bar dataKey="quran" name="Qur'an" stackId="attendance" fill="#4f46e5" radius={[0, 0, 8, 8]} />
                    <Bar dataKey="tuition" name="Tuition" stackId="attendance" fill="#06b6d4" radius={[8, 8, 0, 0]} />
                  </BarChart>
                </ResponsiveContainer>
              </div>
              <ChartLegend items={[
                { label: "Qur'an", color: "#4f46e5" },
                { label: "Tuition", color: "#06b6d4" },
              ]} />
            </>
          ) : <EmptyChart />}
        </ChartCard>

        <ChartCard title="Department Access Health" subtitle="Percentage of configured portal permissions currently enabled.">
          <div className="space-y-5">{data.feature_health.length ? data.feature_health.map((item, index) => <div key={item.key}><div className="flex items-end justify-between gap-3"><div><div className="text-sm font-black text-slate-900 dark:text-white">{item.label}</div><div className="mt-1 text-[11px] font-bold text-slate-400">{item.enabled} of {item.total} permissions enabled</div></div><div className="text-2xl font-black" style={{ color: chartColors[index % chartColors.length] }}>{item.rate}%</div></div><div className="mt-3 h-3 overflow-hidden rounded-full bg-slate-100 dark:bg-slate-800"><div className="h-full rounded-full transition-all" style={{ width: `${Math.min(item.rate, 100)}%`, backgroundColor: chartColors[index % chartColors.length] }} /></div></div>) : <EmptyChart />}</div>
        </ChartCard>
      </div>

      <ChartCard title="Largest Departments" subtitle="Departments ranked by currently active primary user accounts.">
        <div className="grid gap-3 md:grid-cols-2 xl:grid-cols-4">{data.top_departments.length ? data.top_departments.map((item, index) => <article key={item.id} className="rounded-[22px] border border-slate-200 bg-slate-50 p-4 dark:border-slate-700 dark:bg-slate-800/70"><div className="flex items-start justify-between gap-3"><span className="grid h-10 w-10 place-items-center rounded-2xl text-white" style={{ backgroundColor: chartColors[index % chartColors.length] }}><BarChart3 size={17} /></span><span className="text-2xl font-black text-slate-950 dark:text-white">{item.users}</span></div><h4 className="mt-4 break-words text-sm font-black sm:truncate">{item.name}</h4><p className="mt-1 break-words sm:truncate text-[11px] font-bold text-slate-400">{item.institution} · {item.department_type === "quran" ? "Qur'an" : item.department_type}</p></article>) : <div className="col-span-full"><EmptyChart /></div>}</div>
      </ChartCard>

      <section className="grid gap-4 md:grid-cols-3">
        <div className="rounded-[24px] border border-emerald-200 bg-emerald-50 p-5 dark:border-emerald-500/25 dark:bg-emerald-500/10"><ShieldCheck className="text-emerald-600" /><div className="mt-4 text-2xl font-black text-emerald-800 dark:text-emerald-200">{summary.active_institutions}/{summary.institutions}</div><div className="mt-1 text-xs font-black text-emerald-700 dark:text-emerald-300">Active institution health</div></div>
        <div className="rounded-[24px] border border-indigo-200 bg-indigo-50 p-5 dark:border-indigo-500/25 dark:bg-indigo-500/10"><Activity className="text-indigo-600" /><div className="mt-4 text-2xl font-black text-indigo-800 dark:text-indigo-200">{summary.attendance_records}</div><div className="mt-1 text-xs font-black text-indigo-700 dark:text-indigo-300">Recorded attendance events</div></div>
        <div className="rounded-[24px] border border-amber-200 bg-amber-50 p-5 dark:border-amber-500/25 dark:bg-amber-500/10"><Wrench className="text-amber-600" /><div className="mt-4 text-2xl font-black text-amber-800 dark:text-amber-200">{summary.active_maintenance}</div><div className="mt-1 text-xs font-black text-amber-700 dark:text-amber-300">Active maintenance scopes</div></div>
      </section>
    </div>
  );
}

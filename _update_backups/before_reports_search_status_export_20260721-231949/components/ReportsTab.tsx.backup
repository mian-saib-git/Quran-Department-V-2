import React, { useEffect, useMemo, useState } from "react";
import { showFeatureLocked } from "../services/featureAccess";
import {
  AppState,
  AttendanceRecord,
  AttendanceStatus,
  EntityType,
  Student,
  Teacher,
} from "../types";

import {
  getLessons,
  type LessonPayload,
  type ProgressStatus,
} from "../services/djangoApiService";

import {
  Download,
  CalendarDays,
  Filter,
  FileSpreadsheet,
  FileText,
  FileDown,
  Users,
  User,
  CheckCircle2,
  XCircle,
  PauseCircle,
  MinusCircle,
  Info,
  BookOpen,
  GraduationCap,
  UserRound,
  TrendingUp,
  Sparkles,
  RefreshCw,
  Loader2,
  Award,
  ClipboardList,
} from "lucide-react";

type Period = "daily" | "weekly" | "monthly" | "yearly" | "custom";
type DateFilterBasis = "attendance_date" | "last_updated";
type ReportStatus = AttendanceStatus | "Unmarked";

type Row = {
  date: string;
  entityType: EntityType;
  teacherName: string;
  studentName: string;
  status: ReportStatus;
  updatedAt: number | null;
};

type StudentReport = {
  student: Student;
  teacher?: Teacher;
  lessons: LessonPayload[];
  attendanceRows: AttendanceRecord[];
  present: number;
  absent: number;
  leave: number;
  unmarked: number;
  attendancePercent: number;
  latestLesson?: LessonPayload;
  progressCounts: Record<string, number>;
  subjects: string[];
};

type TeacherReport = {
  teacher: Teacher;
  students: Student[];
  lessons: LessonPayload[];
  attendanceRows: AttendanceRecord[];
  subjects: string[];
  present: number;
  absent: number;
  leave: number;
  lessonCount: number;
};

const REPORT_PAGE_SIZE = 20;
const CARD_PAGE_SIZE = 10;

function paginate<T>(items: T[], page: number, pageSize: number) {
  const totalPages = Math.max(1, Math.ceil(items.length / pageSize));
  const safePage = Math.min(Math.max(page, 1), totalPages);
  const startIndex = (safePage - 1) * pageSize;

  return {
    totalPages,
    safePage,
    items: items.slice(startIndex, startIndex + pageSize),
    startIndex,
  };
}

const todayStr = () => new Date().toISOString().split("T")[0];

const timestampToLocalDate = (value: number | string | null | undefined) => {
  if (value === null || value === undefined || value === "") return "";

  const parsed = new Date(value);
  if (Number.isNaN(parsed.getTime())) return "";

  const year = parsed.getFullYear();
  const month = String(parsed.getMonth() + 1).padStart(2, "0");
  const day = String(parsed.getDate()).padStart(2, "0");
  return `${year}-${month}-${day}`;
};

const toDate = (yyyyMmDd: string) => {
  const [y, m, d] = yyyyMmDd.split("-").map((v) => parseInt(v, 10));
  return new Date(y, (m ?? 1) - 1, d ?? 1);
};

const fmt = (d: Date) => {
  const y = d.getFullYear();
  const m = String(d.getMonth() + 1).padStart(2, "0");
  const day = String(d.getDate()).padStart(2, "0");
  return `${y}-${m}-${day}`;
};

const addDays = (d: Date, days: number) => {
  const copy = new Date(d);
  copy.setDate(copy.getDate() + days);
  return copy;
};

const clampRange = (start: string, end: string) => {
  if (!start || !end) return { start, end };
  return start <= end ? { start, end } : { start: end, end: start };
};

const dateListInclusive = (start: string, end: string, maxDays = 370): string[] => {
  if (!start || !end) return [];
  const { start: s, end: e } = clampRange(start, end);
  const out: string[] = [];
  let cur = toDate(s);
  const last = toDate(e);
  let guard = 0;

  while (cur <= last && guard < maxDays) {
    out.push(fmt(cur));
    cur = addDays(cur, 1);
    guard += 1;
  }

  return out;
};

const getRangeForPeriod = (period: Period, anchorDate: string) => {
  const a = toDate(anchorDate);

  if (period === "daily") {
    const d = fmt(a);
    return { start: d, end: d };
  }

  if (period === "weekly") {
    const day = a.getDay();
    const diffToMonday = (day + 6) % 7;
    const start = addDays(a, -diffToMonday);
    const end = addDays(start, 6);
    return { start: fmt(start), end: fmt(end) };
  }

  if (period === "monthly") {
    const start = new Date(a.getFullYear(), a.getMonth(), 1);
    const end = new Date(a.getFullYear(), a.getMonth() + 1, 0);
    return { start: fmt(start), end: fmt(end) };
  }

  if (period === "yearly") {
    const start = new Date(a.getFullYear(), 0, 1);
    const end = new Date(a.getFullYear(), 11, 31);
    return { start: fmt(start), end: fmt(end) };
  }

  return { start: "", end: "" };
};

function formatDate(value: string) {
  if (!value) return "-";

  try {
    return new Date(`${value}T00:00:00`).toLocaleDateString("en-US", {
      month: "short",
      day: "numeric",
      year: "numeric",
    });
  } catch {
    return value;
  }
}

function statusPill(status: ReportStatus) {
  if (status === AttendanceStatus.PRESENT) {
    return {
      label: "Present",
      cls: "bg-emerald-50 text-emerald-700 border-emerald-100",
      icon: <CheckCircle2 size={14} />,
    };
  }

  if (status === AttendanceStatus.ABSENT) {
    return {
      label: "Absent",
      cls: "bg-rose-50 text-rose-700 border-rose-100",
      icon: <XCircle size={14} />,
    };
  }

  if (status === AttendanceStatus.LEAVE) {
    return {
      label: "Leave",
      cls: "bg-amber-50 text-amber-800 border-amber-100",
      icon: <PauseCircle size={14} />,
    };
  }

  return {
    label: "Unmarked",
    cls: "bg-slate-50 text-slate-700 border-slate-200",
    icon: <MinusCircle size={14} />,
  };
}

function progressLabel(status?: ProgressStatus | string) {
  const value = String(status || "").trim();

  if (value === "excellent") return "Excellent";
  if (value === "good") return "Good";
  if (value === "satisfactory") return "Satisfactory";
  if (value === "needs_improvement") return "Needs Improvement";

  return "Unmarked";
}

function progressTone(status?: ProgressStatus | string) {
  const value = String(status || "").trim();

  if (value === "excellent") return "bg-emerald-50 text-emerald-700 border-emerald-100";
  if (value === "good") return "bg-blue-50 text-blue-700 border-blue-100";
  if (value === "satisfactory") return "bg-amber-50 text-amber-800 border-amber-100";
  if (value === "needs_improvement") return "bg-rose-50 text-rose-700 border-rose-100";

  return "bg-slate-50 text-slate-600 border-slate-200";
}

function initials(name: string) {
  return (
    name
      .split(" ")
      .filter(Boolean)
      .map((part) => part[0])
      .slice(0, 2)
      .join("")
      .toUpperCase() || "U"
  );
}

function Segmented({
  value,
  onChange,
  options,
}: {
  value: string;
  onChange: (v: string) => void;
  options: { value: string; label: string }[];
}) {
  return (
    <div className="inline-flex rounded-2xl bg-white/70 border border-slate-200/70 p-1 shadow-sm overflow-x-auto">
      {options.map((o) => {
        const active = value === o.value;

        return (
          <button
            key={o.value}
            type="button"
            onClick={() => onChange(o.value)}
            className={`px-3 py-2 rounded-xl text-xs font-extrabold transition whitespace-nowrap ${
              active
                ? "bg-white text-indigo-700 shadow-[0_10px_22px_rgba(15,23,42,0.08)] border border-slate-200/70"
                : "text-slate-600 hover:text-slate-900"
            }`}
          >
            {o.label}
          </button>
        );
      })}
    </div>
  );
}

function IconButton({
  onClick,
  icon,
  label,
  tone,
  enabled = true,
}: {
  onClick: () => void;
  icon: React.ReactNode;
  label: string;
  tone: string;
  enabled?: boolean;
}) {
  return (
    <button
      onClick={() => {
        if (!enabled) {
          showFeatureLocked(
            `${label} Export`,
            `${label} export is currently not enabled for your department. Please contact the Main Administrator or software provider to request activation.`
          );
          return;
        }
        onClick();
      }}
      aria-disabled={!enabled}
      className={`inline-flex items-center gap-2 px-4 py-2 rounded-2xl text-xs font-extrabold transition active:scale-[0.99] ${
        enabled
          ? tone
          : "border border-slate-200 bg-slate-100 text-slate-500 opacity-75 hover:bg-slate-200"
      }`}
      type="button"
      title={enabled ? label : `${label} is not enabled`}
    >
      {icon}
      {label}
      {!enabled && <span className="ml-1 text-[10px]">🔒</span>}
    </button>
  );
}

function StatCard({
  label,
  value,
  icon,
  tone,
}: {
  label: string;
  value: number | string;
  icon: React.ReactNode;
  tone: string;
  show?: boolean;
}) {
  return (
    <div className={`rounded-3xl border p-5 shadow-[0_14px_34px_rgba(15,23,42,0.06)] ${tone}`}>
      <div className="flex items-center justify-between gap-3">
        <div>
          <div className="text-xs font-extrabold uppercase tracking-wide opacity-80">
            {label}
          </div>
          <div className="mt-2 text-3xl font-black">{value}</div>
        </div>

        <div className="h-12 w-12 rounded-2xl bg-white/70 border border-white/70 flex items-center justify-center shadow-sm">
          {icon}
        </div>
      </div>
    </div>
  );
}

type ReportsTabProps = {
  appState: AppState;
  generatedBy?: string;
  canExportPdf?: boolean;
  canExportCsv?: boolean;
  canExportExcel?: boolean;
};

export function ReportsTab({
  appState,
  generatedBy = "Coordinator",
  canExportPdf = true,
  canExportCsv = true,
  canExportExcel = true,
}: ReportsTabProps) {
  const [period, setPeriod] = useState<Period>("weekly");
  const [anchor, setAnchor] = useState<string>(todayStr());
  const [start, setStart] = useState<string>(todayStr());
  const [end, setEnd] = useState<string>(todayStr());
  const [teacherId, setTeacherId] = useState<string>("all");
  const [studentId, setStudentId] = useState<string>("all");
  const [includeTeacherRow, setIncludeTeacherRow] = useState(true);
  const [includeUnmarked, setIncludeUnmarked] = useState(false);
  const [dateFilterBasis, setDateFilterBasis] = useState<DateFilterBasis>("attendance_date");
  const [activeView, setActiveView] = useState<"attendance" | "students" | "teachers" | "parent">("attendance");

  const [lessons, setLessons] = useState<LessonPayload[]>([]);
  const [lessonsLoading, setLessonsLoading] = useState(false);
  const [lessonMessage, setLessonMessage] = useState("");
  const [attendancePage, setAttendancePage] = useState(1);
const [studentPage, setStudentPage] = useState(1);
const [teacherPage, setTeacherPage] = useState(1);
const [parentPage, setParentPage] = useState(1);

  const loadLessons = async () => {
    try {
      setLessonsLoading(true);
      setLessonMessage("");

      const res = await getLessons();
      setLessons(res.results || []);
    } catch (err: any) {
      setLessonMessage(err?.message || "Could not load lesson reports.");
    } finally {
      setLessonsLoading(false);
    }
  };

  useEffect(() => {
    void loadLessons();
  }, []);

  useEffect(() => {
  setAttendancePage(1);
  setStudentPage(1);
  setTeacherPage(1);
  setParentPage(1);
}, [
  activeView,
  period,
  anchor,
  start,
  end,
  teacherId,
  studentId,
  includeTeacherRow,
  includeUnmarked,
  dateFilterBasis,
]);

  const teacherById = useMemo(() => {
    const m = new Map<string, Teacher>();
    for (const t of appState.teachers) m.set(String(t.id), t);
    return m;
  }, [appState.teachers]);

  const studentById = useMemo(() => {
    const m = new Map<string, Student>();
    for (const s of appState.students) m.set(String(s.id), s);
    return m;
  }, [appState.students]);

  const studentsForTeacher = useMemo(() => {
    if (teacherId === "all") return appState.students;
    return appState.students.filter((s) => String(s.teacherId) === String(teacherId));
  }, [appState.students, teacherId]);

  const teachersSorted = useMemo(
    () => appState.teachers.slice().sort((a, b) => a.name.localeCompare(b.name)),
    [appState.teachers]
  );

  const studentsSorted = useMemo(
    () => studentsForTeacher.slice().sort((a, b) => a.name.localeCompare(b.name)),
    [studentsForTeacher]
  );

  const effectiveRange = useMemo(() => {
    if (period === "custom") return clampRange(start, end);
    return getRangeForPeriod(period, anchor);
  }, [period, anchor, start, end]);

  const filteredLessons = useMemo(() => {
    const s = effectiveRange.start;
    const e = effectiveRange.end;

    return lessons.filter((lesson) => {
      if (s && lesson.date < s) return false;
      if (e && lesson.date > e) return false;

      if (teacherId !== "all" && String(lesson.teacher_id) !== String(teacherId)) {
        return false;
      }

      if (studentId !== "all" && String(lesson.student_id) !== String(studentId)) {
        return false;
      }

      return true;
    });
  }, [lessons, effectiveRange, teacherId, studentId]);

  const scope = useMemo(() => {
    const teacher = teacherId !== "all" ? teacherById.get(String(teacherId)) : undefined;
    const student = studentId !== "all" ? studentById.get(String(studentId)) : undefined;

    if (student) {
      const t = teacherById.get(String(student.teacherId));

      return {
        teachers: includeTeacherRow && t ? [t] : [],
        students: [student],
      };
    }

    if (teacher) {
      return {
        teachers: includeTeacherRow ? [teacher] : [],
        students: appState.students.filter((s) => String(s.teacherId) === String(teacher.id)),
      };
    }

    return {
      teachers: includeTeacherRow ? appState.teachers : [],
      students: appState.students,
    };
  }, [
    teacherId,
    studentId,
    includeTeacherRow,
    teacherById,
    studentById,
    appState.teachers,
    appState.students,
  ]);

  const recordMap = useMemo(() => {
    const map = new Map<string, AttendanceRecord>();

    for (const r of appState.attendance) {
      map.set(`${r.date}:${r.entityType}:${r.entityId}`, r);
    }

    return map;
  }, [appState.attendance]);

  const rows = useMemo(() => {
    const { start: s, end: e } = effectiveRange;

    if (!s || !e) return [] as Row[];

    const dates = dateListInclusive(s, e, 400);
    const filteringByUpdatedAt = dateFilterBasis === "last_updated";
    const wantsUnmarked =
      !filteringByUpdatedAt &&
      includeUnmarked &&
      (teacherId !== "all" || studentId !== "all");

    if (!filteringByUpdatedAt && includeUnmarked && !wantsUnmarked) return [] as Row[];

    const out: Row[] = [];

    const pushFromRecord = (r: AttendanceRecord) => {
      const comparisonDate = filteringByUpdatedAt
        ? timestampToLocalDate(r.timestamp)
        : r.date;

      if (!comparisonDate || comparisonDate < s || comparisonDate > e) return;

      if (teacherId !== "all") {
        if (r.entityType === EntityType.TEACHER && String(r.entityId) !== String(teacherId)) return;

        if (r.entityType === EntityType.STUDENT) {
          const st = studentById.get(String(r.entityId));
          if (!st || String(st.teacherId) !== String(teacherId)) return;
        }
      }

      if (studentId !== "all") {
        if (r.entityType !== EntityType.STUDENT || String(r.entityId) !== String(studentId)) return;
      }

      if (r.entityType === EntityType.TEACHER) {
        const t = teacherById.get(String(r.entityId));

        out.push({
          date: r.date,
          entityType: r.entityType,
          teacherName: t?.name ?? "Unknown Teacher",
          studentName: "—",
          status: r.status,
          updatedAt: r.timestamp,
        });
      } else {
        const st = studentById.get(String(r.entityId));
        const t = st ? teacherById.get(String(st.teacherId)) : undefined;

        out.push({
          date: r.date,
          entityType: r.entityType,
          teacherName: t?.name ?? "Unknown Teacher",
          studentName: st?.name ?? "Unknown Student",
          status: r.status,
          updatedAt: r.timestamp,
        });
      }
    };

    if (filteringByUpdatedAt || !wantsUnmarked) {
      for (const r of appState.attendance) pushFromRecord(r);

      return out.sort((a, b) =>
        a.date === b.date
          ? a.teacherName.localeCompare(b.teacherName)
          : a.date.localeCompare(b.date)
      );
    }

    for (const d of dates) {
      for (const t of scope.teachers) {
        const key = `${d}:${EntityType.TEACHER}:${t.id}`;
        const r = recordMap.get(key);

        out.push({
          date: d,
          entityType: EntityType.TEACHER,
          teacherName: t.name,
          studentName: "—",
          status: r?.status ?? "Unmarked",
          updatedAt: r?.timestamp ?? null,
        });
      }

      for (const sObj of scope.students) {
        const key = `${d}:${EntityType.STUDENT}:${sObj.id}`;
        const r = recordMap.get(key);

        out.push({
          date: d,
          entityType: EntityType.STUDENT,
          teacherName: teacherById.get(String(sObj.teacherId))?.name ?? "Unknown Teacher",
          studentName: sObj.name,
          status: r?.status ?? "Unmarked",
          updatedAt: r?.timestamp ?? null,
        });
      }
    }

    return out;
  }, [
    appState.attendance,
    effectiveRange,
    includeUnmarked,
    dateFilterBasis,
    teacherId,
    studentId,
    scope,
    recordMap,
    teacherById,
    studentById,
  ]);

  const summary = useMemo(() => {
    const counts: Record<string, number> = {
      Present: 0,
      Absent: 0,
      Leave: 0,
      Unmarked: 0,
    };

    for (const r of rows) {
      counts[r.status] = (counts[r.status] ?? 0) + 1;
    }

    return counts;
  }, [rows]);

  const studentReports = useMemo<StudentReport[]>(() => {
    const list = scope.students.map((student) => {
      const teacher = teacherById.get(String(student.teacherId));

      const studentLessons = filteredLessons
        .filter((lesson) => String(lesson.student_id) === String(student.id))
        .sort((a, b) => String(b.date || "").localeCompare(String(a.date || "")));

      const attendanceRows = appState.attendance.filter((item) => {
        return (
          item.entityType === EntityType.STUDENT &&
          String(item.entityId) === String(student.id) &&
          item.date >= effectiveRange.start &&
          item.date <= effectiveRange.end
        );
      });

      const present = attendanceRows.filter((item) => item.status === AttendanceStatus.PRESENT).length;
      const absent = attendanceRows.filter((item) => item.status === AttendanceStatus.ABSENT).length;
      const leave = attendanceRows.filter((item) => item.status === AttendanceStatus.LEAVE).length;
      const totalMarked = present + absent + leave;
      const attendancePercent = totalMarked > 0 ? Math.round((present / totalMarked) * 100) : 0;

      const progressCounts: Record<string, number> = {
        excellent: 0,
        good: 0,
        satisfactory: 0,
        needs_improvement: 0,
        blank: 0,
      };

      const subjectSet = new Set<string>();

      for (const lesson of studentLessons) {
        const key = lesson.progress_status || "blank";
        progressCounts[key] = (progressCounts[key] || 0) + 1;

        if (lesson.subject) {
          subjectSet.add(lesson.subject);
        }
      }

      return {
        student,
        teacher,
        lessons: studentLessons,
        attendanceRows,
        present,
        absent,
        leave,
        unmarked: 0,
        attendancePercent,
        latestLesson: studentLessons[0],
        progressCounts,
        subjects: Array.from(subjectSet),
      };
    });

    return list.sort((a, b) => a.student.name.localeCompare(b.student.name));
  }, [scope.students, teacherById, filteredLessons, appState.attendance, effectiveRange]);

  const teacherReports = useMemo<TeacherReport[]>(() => {
    const list = scope.teachers.map((teacher) => {
      const students = appState.students.filter((student) => String(student.teacherId) === String(teacher.id));

      const teacherLessons = filteredLessons.filter((lesson) => {
        return String(lesson.teacher_id) === String(teacher.id);
      });

      const attendanceRows = appState.attendance.filter((item) => {
        if (item.date < effectiveRange.start || item.date > effectiveRange.end) return false;

        if (item.entityType === EntityType.TEACHER) {
          return String(item.entityId) === String(teacher.id);
        }

        if (item.entityType === EntityType.STUDENT) {
          const student = studentById.get(String(item.entityId));
          return String(student?.teacherId || "") === String(teacher.id);
        }

        return false;
      });

      const present = attendanceRows.filter((item) => item.status === AttendanceStatus.PRESENT).length;
      const absent = attendanceRows.filter((item) => item.status === AttendanceStatus.ABSENT).length;
      const leave = attendanceRows.filter((item) => item.status === AttendanceStatus.LEAVE).length;

      const subjectSet = new Set<string>();

      for (const lesson of teacherLessons) {
        if (lesson.subject) subjectSet.add(lesson.subject);
      }

      return {
        teacher,
        students,
        lessons: teacherLessons,
        attendanceRows,
        subjects: Array.from(subjectSet),
        present,
        absent,
        leave,
        lessonCount: teacherLessons.length,
      };
    });

    return list.sort((a, b) => a.teacher.name.localeCompare(b.teacher.name));
  }, [scope.teachers, appState.students, appState.attendance, effectiveRange, filteredLessons, studentById]);

  const topProgressStatus = (counts: Record<string, number>) => {
    const best = Object.entries(counts)
      .filter(([key]) => key !== "blank")
      .sort((a, b) => b[1] - a[1])[0];

    return best?.[0] || "";
  };

  const exportCSV = () => {
  if (!canExportCsv) {
    showFeatureLocked("CSV Export");
    return;
  }

    if (rows.length === 0) {
      alert("No rows to export for the current filters.");
      return;
    }

    const headers = ["Date", "Teacher", "Student", "Type", "Status", "Last Updated"];

    const escape = (v: string) => {
      const needs = v.includes(",") || v.includes('"') || v.includes("\n");
      const safe = v.replace(/"/g, '""');
      return needs ? `"${safe}"` : safe;
    };

    const lines = rows.map((r) =>
      [
        r.date,
        r.teacherName,
        r.studentName,
        r.entityType,
        r.status,
        r.updatedAt ? new Date(r.updatedAt).toLocaleString() : "",
      ]
        .map((x) => escape(String(x)))
        .join(",")
    );

    const csvContent = "data:text/csv;charset=utf-8," + [headers.join(","), ...lines].join("\n");
    const link = document.createElement("a");

    link.href = encodeURI(csvContent);
    link.download = `attendance_report_${effectiveRange.start}_to_${effectiveRange.end}.csv`;

    document.body.appendChild(link);
    link.click();
    document.body.removeChild(link);
  };

const exportExcel = async () => {
  if (!canExportExcel) {
    showFeatureLocked("Excel Export");
    return;
  }

  if (rows.length === 0) {
    alert('No rows to export for the current filters.');
    return;
  }

  const ExcelJS = await import('exceljs');

  const workbook = new ExcelJS.Workbook();
  const worksheet = workbook.addWorksheet('Attendance');

  worksheet.columns = [
    { header: 'Date', key: 'date', width: 16 },
    { header: 'Teacher', key: 'teacherName', width: 28 },
    { header: 'Student', key: 'studentName', width: 28 },
    { header: 'Type', key: 'entityType', width: 16 },
    { header: 'Status', key: 'status', width: 16 },
    { header: 'Last Updated', key: 'updatedAt', width: 24 },
  ];

  rows.forEach((r) => {
    worksheet.addRow({
      date: r.date,
      teacherName: r.teacherName,
      studentName: r.studentName,
      entityType: r.entityType,
      status: r.status,
      updatedAt: r.updatedAt ? new Date(r.updatedAt).toLocaleString() : '',
    });
  });

  worksheet.getRow(1).font = { bold: true };

  const buffer = await workbook.xlsx.writeBuffer();

  const blob = new Blob([buffer], {
    type: 'application/vnd.openxmlformats-officedocument.spreadsheetml.sheet',
  });

  const url = URL.createObjectURL(blob);
  const link = document.createElement('a');
  link.href = url;
  link.download = `attendance_report_${effectiveRange.start}_to_${effectiveRange.end}.xlsx`;
  document.body.appendChild(link);
  link.click();
  document.body.removeChild(link);
  URL.revokeObjectURL(url);
};

const exportPDF = async () => {
  if (!canExportPdf) {
    showFeatureLocked("PDF Export");
    return;
  }

  if (rows.length === 0) {
    alert("No rows to export for the current filters.");
    return;
  }

  const { default: jsPDF } = await import("jspdf");
  const autoTable = (await import("jspdf-autotable")).default;

  const doc = new jsPDF({
    orientation: "portrait",
    unit: "mm",
    format: "a4",
  });

  const pageWidth = doc.internal.pageSize.getWidth();
  const pageHeight = doc.internal.pageSize.getHeight();

  const BLUE: [number, number, number] = [0, 163, 224];
  const BLUE_DARK: [number, number, number] = [0, 109, 170];
  const BLUE_SOFT: [number, number, number] = [232, 248, 255];
  const INDIGO: [number, number, number] = [79, 70, 229];
  const DARK: [number, number, number] = [29, 33, 42];
  const TEXT: [number, number, number] = [24, 31, 42];
  const MUTED: [number, number, number] = [92, 104, 121];
  const LIGHT_BG: [number, number, number] = [247, 250, 253];
  const CARD: [number, number, number] = [255, 255, 255];
  const LINE: [number, number, number] = [220, 229, 240];
  const GREEN: [number, number, number] = [22, 163, 74];
  const RED: [number, number, number] = [220, 38, 38];
  const AMBER: [number, number, number] = [180, 83, 9];

  const TABLE_X = 10;
  const TABLE_W = pageWidth - 20;

  const TABLE_COLS = {
    sl: 11,
    date: 25,
    teacher: 37,
    student: 35,
    type: 17,
    status: 20,
    updated: 45,
  };

  const TABLE_WIDTHS = [
    TABLE_COLS.sl,
    TABLE_COLS.date,
    TABLE_COLS.teacher,
    TABLE_COLS.student,
    TABLE_COLS.type,
    TABLE_COLS.status,
    TABLE_COLS.updated,
  ];

  const tableCenterX = (index: number) => {
    const before = TABLE_WIDTHS.slice(0, index).reduce(
      (sum, value) => sum + value,
      0
    );

    return TABLE_X + before + TABLE_WIDTHS[index] / 2;
  };

  const generatedAt = new Date();

  const reportNo = `ATT-${generatedAt.getFullYear()}${String(
    generatedAt.getMonth() + 1
  ).padStart(2, "0")}${String(generatedAt.getDate()).padStart(2, "0")}`;

  const generatedDate = generatedAt.toLocaleDateString("en-US", {
    year: "numeric",
    month: "short",
    day: "2-digit",
  });

  const generatedTime = generatedAt.toLocaleTimeString("en-US", {
    hour: "2-digit",
    minute: "2-digit",
    second: "2-digit",
    hour12: true,
  });

  const teacherName =
    teacherId !== "all"
      ? teacherById.get(String(teacherId))?.name || "Selected Teacher"
      : "All Teachers";

  const studentName =
    studentId !== "all"
      ? studentById.get(String(studentId))?.name || "Selected Student"
      : "All Students";

  const totalPresent = Number(summary.Present ?? 0);
  const totalAbsent = Number(summary.Absent ?? 0);
  const totalLeave = Number(summary.Leave ?? 0);
  const totalUnmarked = Number(summary.Unmarked ?? 0);
  const totalRows = rows.length;

  const attendanceScore =
    totalRows > 0 ? Math.round((totalPresent / totalRows) * 100) : 0;

  const loadImageAsDataUrl = async (url: string): Promise<string | null> => {
    try {
      const image = await new Promise<HTMLImageElement>((resolve, reject) => {
        const img = new Image();
        img.crossOrigin = "anonymous";
        img.onload = () => resolve(img);
        img.onerror = reject;
        img.src = url;
      });

      const canvas = document.createElement("canvas");
      canvas.width = image.naturalWidth;
      canvas.height = image.naturalHeight;

      const ctx = canvas.getContext("2d");
      if (!ctx) return null;

      ctx.drawImage(image, 0, 0);
      return canvas.toDataURL("image/png");
    } catch {
      return null;
    }
  };

  const logoDataUrl = await loadImageAsDataUrl("/ivs-logo.png");

  const drawBackground = () => {
    doc.setFillColor(...LIGHT_BG);
    doc.rect(0, 0, pageWidth, pageHeight, "F");

    doc.setFillColor(235, 248, 255);
    doc.circle(pageWidth - 24, 24, 34, "F");

    doc.setFillColor(241, 245, 255);
    doc.circle(16, pageHeight - 34, 44, "F");

    doc.setFillColor(248, 250, 252);
    doc.circle(pageWidth - 38, pageHeight - 58, 28, "F");
  };

  const drawBrand = () => {
    if (logoDataUrl) {
      doc.addImage(logoDataUrl, "PNG", 15, 13, 18, 18);
    } else {
      doc.setFillColor(...BLUE);
      doc.roundedRect(15, 13, 18, 18, 4, 4, "F");

      doc.setTextColor(255, 255, 255);
      doc.setFont("helvetica", "bold");
      doc.setFontSize(8);
      doc.text("IVS", 24, 24, { align: "center" });
    }

    doc.setTextColor(...TEXT);
    doc.setFont("helvetica", "bold");
    doc.setFontSize(13);
    doc.text("IQRA VIRTUAL SCHOOL", 37, 19);

    doc.setTextColor(...MUTED);
    doc.setFont("helvetica", "normal");
    doc.setFontSize(7);
    doc.text("Qur'an Department", 37, 24);
    doc.text("Attendance Management System", 37, 28);

    doc.setTextColor(...MUTED);
    doc.setFont("helvetica", "normal");
    doc.setFontSize(7);
    doc.text("www.iqravirtualschool.com", pageWidth - 15, 20, {
      align: "right",
    });
  };

  const drawInfoCard = (
    x: number,
    y: number,
    w: number,
    h: number,
    title: string
  ) => {
    doc.setFillColor(...CARD);
    doc.roundedRect(x, y, w, h, 5, 5, "F");

    doc.setDrawColor(...LINE);
    doc.setLineWidth(0.25);
    doc.roundedRect(x, y, w, h, 5, 5, "S");

    doc.setFillColor(...BLUE_SOFT);
    doc.roundedRect(x + 4, y + 4, 30, 7, 2, 2, "F");

    doc.setTextColor(...BLUE);
    doc.setFont("helvetica", "bold");
    doc.setFontSize(6.8);
    doc.text(title.toUpperCase(), x + 7, y + 9);

    doc.setFillColor(...BLUE);
    doc.circle(x + w - 9, y + 8, 1.2, "F");

    doc.setFillColor(...INDIGO);
    doc.circle(x + w - 14, y + 8, 1.2, "F");
  };

  const drawReportDetails = () => {
    const detailsY = 74;
    const cardH = 46;
    const leftCardX = 15;
    const rightCardX = 108;
    const cardW = 87;

    drawInfoCard(leftCardX, detailsY, cardW, cardH, "Report Info");
    drawInfoCard(rightCardX, detailsY, cardW, cardH, "Scope");

    doc.setFontSize(7.3);
    doc.setFont("helvetica", "normal");
    doc.setTextColor(...MUTED);

    doc.text("Report #", leftCardX + 6, detailsY + 18);
    doc.text("Generated by", leftCardX + 6, detailsY + 25);
    doc.text("Generated at", leftCardX + 6, detailsY + 32);
    doc.text("Date range", leftCardX + 6, detailsY + 39);

    doc.setTextColor(...TEXT);
    doc.setFont("helvetica", "bold");

    doc.text(reportNo, leftCardX + 36, detailsY + 18, {
      maxWidth: 43,
    });

    doc.text(generatedBy || "Coordinator", leftCardX + 36, detailsY + 25, {
      maxWidth: 43,
    });

    doc.text(
      `${generatedDate}, ${generatedTime}`,
      leftCardX + 36,
      detailsY + 32,
      {
        maxWidth: 45,
      }
    );

    doc.text(
      `${effectiveRange.start} to ${effectiveRange.end}`,
      leftCardX + 36,
      detailsY + 39,
      {
        maxWidth: 45,
      }
    );

    doc.setFontSize(7.3);
    doc.setFont("helvetica", "normal");
    doc.setTextColor(...MUTED);

    doc.text("Teacher", rightCardX + 6, detailsY + 18);
    doc.text("Student", rightCardX + 6, detailsY + 25);
    doc.text("Period", rightCardX + 6, detailsY + 32);
    doc.text("Rows", rightCardX + 6, detailsY + 39);

    doc.setTextColor(...TEXT);
    doc.setFont("helvetica", "bold");

    doc.text(teacherName, rightCardX + 35, detailsY + 18, {
      maxWidth: 45,
    });

    doc.text(studentName, rightCardX + 35, detailsY + 25, {
      maxWidth: 45,
    });

    doc.text(period.toUpperCase(), rightCardX + 35, detailsY + 32);
    doc.text(String(totalRows), rightCardX + 35, detailsY + 39);
  };

  const drawTableHeader = () => {
    const barY = 132;
    const barH = 14;

    doc.setFillColor(...DARK);
    doc.roundedRect(TABLE_X, barY, 73, barH, 3, 3, "F");

    doc.setFillColor(...BLUE);
    doc.roundedRect(TABLE_X + 64, barY, TABLE_W - 64, barH, 3, 3, "F");

    doc.setFillColor(...BLUE_DARK);
    doc.triangle(
      TABLE_X + 61,
      barY,
      TABLE_X + 84,
      barY,
      TABLE_X + 72,
      barY + barH,
      "F"
    );

    doc.setFillColor(0, 130, 195);
    doc.triangle(
      TABLE_X + 76,
      barY,
      TABLE_X + 99,
      barY,
      TABLE_X + 87,
      barY + barH,
      "F"
    );

    doc.setTextColor(255, 255, 255);
    doc.setFont("helvetica", "bold");
    doc.setFontSize(6.8);

    const headers = [
      "SL.",
      "DATE",
      "TEACHER",
      "STUDENT",
      "TYPE",
      "STATUS",
      "LAST UPDATED",
    ];

    headers.forEach((label, index) => {
      doc.text(label, tableCenterX(index), barY + 9, {
        align: "center",
      });
    });
  };

  const drawTablePageHeader = () => {
    drawBackground();
    drawBrand();

    doc.setTextColor(...DARK);
    doc.setFont("helvetica", "bold");
    doc.setFontSize(25);
    doc.text("ATTENDANCE", 15, 48);
    doc.text("REPORT", 15, 59);

    doc.setDrawColor(...BLUE);
    doc.setLineWidth(1.4);
    doc.line(15, 64, 66, 64);

    doc.setDrawColor(...INDIGO);
    doc.setLineWidth(0.5);
    doc.line(15, 66, 48, 66);

    drawReportDetails();
    drawTableHeader();
  };

  const drawFooter = () => {
    const footerY = pageHeight - 28;

    doc.setDrawColor(...LINE);
    doc.setLineWidth(0.3);
    doc.line(15, footerY - 7, pageWidth - 15, footerY - 7);

    doc.setFont("helvetica", "normal");
    doc.setFontSize(7);
    doc.setTextColor(...MUTED);

    doc.text("Iqra Virtual School", 15, footerY);
    doc.text("Qur'an Department Attendance Report", 15, footerY + 5);

    const pageNumber = doc.getCurrentPageInfo().pageNumber;

    doc.text(`Page ${pageNumber}`, pageWidth - 15, footerY, {
      align: "right",
    });

    doc.setFillColor(...DARK);
    doc.rect(0, pageHeight - 13, 68, 13, "F");

    doc.setFillColor(...BLUE);
    doc.rect(68, pageHeight - 13, pageWidth - 68, 13, "F");

    doc.setFillColor(...BLUE_DARK);
    doc.triangle(58, pageHeight - 13, 80, pageHeight - 13, 69, pageHeight, "F");

    doc.setFillColor(0, 130, 195);
    doc.triangle(72, pageHeight - 13, 94, pageHeight - 13, 83, pageHeight, "F");
  };

  const drawStatIcon = (
    cx: number,
    cy: number,
    color: [number, number, number],
    icon: "present" | "absent" | "leave" | "total"
  ) => {
    doc.setDrawColor(...color);
    doc.setTextColor(...color);
    doc.setLineWidth(0.62);

    if (icon === "present") {
      doc.circle(cx, cy, 2.25, "S");
      doc.line(cx - 0.9, cy + 0.05, cx - 0.2, cy + 0.85);
      doc.line(cx - 0.2, cy + 0.85, cx + 1.15, cy - 0.95);
      return;
    }

    if (icon === "absent") {
      doc.circle(cx, cy, 2.25, "S");
      doc.line(cx - 1.0, cy - 1.0, cx + 1.0, cy + 1.0);
      doc.line(cx + 1.0, cy - 1.0, cx - 1.0, cy + 1.0);
      return;
    }

    if (icon === "leave") {
      doc.circle(cx, cy, 2.25, "S");
      doc.line(cx, cy, cx, cy - 1.15);
      doc.line(cx, cy, cx + 1.0, cy + 0.55);
      return;
    }

    doc.roundedRect(cx - 2.0, cy - 2.45, 4.1, 5.0, 0.55, 0.55, "S");
    doc.line(cx - 0.95, cy - 0.9, cx + 1.1, cy - 0.9);
    doc.line(cx - 0.95, cy + 0.3, cx + 1.1, cy + 0.3);
    doc.line(cx - 0.95, cy + 1.5, cx + 0.7, cy + 1.5);
  };

  const drawMiniStat = (
    x: number,
    y: number,
    w: number,
    title: string,
    value: string,
    color: [number, number, number],
    icon: "present" | "absent" | "leave" | "total"
  ) => {
    const softColor: [number, number, number] =
      icon === "present"
        ? [236, 253, 245]
        : icon === "absent"
        ? [254, 242, 242]
        : icon === "leave"
        ? [255, 251, 235]
        : [232, 248, 255];

    const accentColor: [number, number, number] =
      icon === "present"
        ? [187, 247, 208]
        : icon === "absent"
        ? [254, 205, 211]
        : icon === "leave"
        ? [253, 230, 138]
        : [186, 230, 253];

    doc.setFillColor(255, 255, 255);
    doc.roundedRect(x, y, w, 29, 6, 6, "F");

    doc.setDrawColor(...LINE);
    doc.setLineWidth(0.3);
    doc.roundedRect(x, y, w, 29, 6, 6, "S");

    doc.setFillColor(...accentColor);
    doc.roundedRect(x + 3, y + 2.6, w - 6, 1.3, 1, 1, "F");

    doc.setFillColor(...softColor);
    doc.circle(x + 10.5, y + 14.5, 4.8, "F");

    doc.setFillColor(255, 255, 255);
    doc.circle(x + 10.5, y + 14.5, 3.35, "F");

    drawStatIcon(x + 10.5, y + 14.5, color, icon);

    doc.setTextColor(...MUTED);
    doc.setFont("helvetica", "bold");
    doc.setFontSize(6.2);
    doc.text(title.toUpperCase(), x + 19, y + 11);

    doc.setTextColor(...TEXT);
    doc.setFont("helvetica", "bold");
    doc.setFontSize(16);
    doc.text(value, x + 19, y + 21.5);

    doc.setDrawColor(...accentColor);
    doc.setLineWidth(0.45);
    doc.line(x + 19, y + 24.5, x + w - 6, y + 24.5);
  };

  const drawSummaryPage = () => {
    doc.addPage();

    drawBackground();
    drawBrand();

    doc.setFillColor(...DARK);
    doc.roundedRect(15, 43, pageWidth - 30, 42, 8, 8, "F");

    doc.setFillColor(...BLUE);
    doc.roundedRect(pageWidth - 88, 43, 73, 42, 8, 8, "F");

    doc.setFillColor(...BLUE_DARK);
    doc.triangle(
      pageWidth - 102,
      43,
      pageWidth - 70,
      43,
      pageWidth - 88,
      85,
      "F"
    );

    doc.setFillColor(0, 130, 195);
    doc.triangle(
      pageWidth - 84,
      43,
      pageWidth - 52,
      43,
      pageWidth - 70,
      85,
      "F"
    );

    doc.setTextColor(255, 255, 255);
    doc.setFont("helvetica", "bold");
    doc.setFontSize(24);
    doc.text("REPORT", 24, 59);
    doc.text("SUMMARY", 24, 72);

    doc.setFontSize(8);
    doc.setFont("helvetica", "normal");

    doc.text(`Report # ${reportNo}`, pageWidth - 24, 58, {
      align: "right",
    });

    doc.text(`${effectiveRange.start} to ${effectiveRange.end}`, pageWidth - 24, 66, {
      align: "right",
    });

    doc.text(`Generated by ${generatedBy || "Coordinator"}`, pageWidth - 24, 74, {
      align: "right",
    });

    doc.setFillColor(255, 255, 255);
    doc.roundedRect(15, 98, 74, 58, 7, 7, "F");

    doc.setDrawColor(...LINE);
    doc.setLineWidth(0.25);
    doc.roundedRect(15, 98, 74, 58, 7, 7, "S");

    doc.setTextColor(...BLUE);
    doc.setFont("helvetica", "bold");
    doc.setFontSize(10);
    doc.text("Attendance Score", 24, 111);

    doc.setTextColor(...TEXT);
    doc.setFontSize(31);
    doc.text(`${attendanceScore}%`, 24, 134);

    doc.setTextColor(...MUTED);
    doc.setFont("helvetica", "normal");
    doc.setFontSize(7.5);

    doc.text("Present rows compared with total report rows.", 24, 145, {
      maxWidth: 54,
    });

    doc.setFillColor(255, 255, 255);
    doc.roundedRect(97, 98, 98, 58, 7, 7, "F");

    doc.setDrawColor(...LINE);
    doc.setLineWidth(0.25);
    doc.roundedRect(97, 98, 98, 58, 7, 7, "S");

    doc.setTextColor(...BLUE);
    doc.setFont("helvetica", "bold");
    doc.setFontSize(10);
    doc.text("Report Scope", 106, 111);

    doc.setFontSize(8);
    doc.setFont("helvetica", "normal");
    doc.setTextColor(...MUTED);

    doc.text("Teacher", 106, 123);
    doc.text("Student", 106, 133);
    doc.text("Period", 106, 143);

    doc.setFont("helvetica", "bold");
    doc.setTextColor(...TEXT);

    doc.text(teacherName, 132, 123, {
      maxWidth: 54,
    });

    doc.text(studentName, 132, 133, {
      maxWidth: 54,
    });

    doc.text(period.toUpperCase(), 132, 143);

    drawMiniStat(15, 171, 43, "Present", String(totalPresent), GREEN, "present");
    drawMiniStat(63, 171, 43, "Absent", String(totalAbsent), RED, "absent");
    drawMiniStat(111, 171, 43, "Leave", String(totalLeave), AMBER, "leave");
    drawMiniStat(159, 171, 36, "Total", String(totalRows), BLUE, "total");

    doc.setFillColor(255, 255, 255);
    doc.roundedRect(15, 212, 85, 38, 7, 7, "F");

    doc.setDrawColor(...LINE);
    doc.roundedRect(15, 212, 85, 38, 7, 7, "S");

    doc.setTextColor(...BLUE);
    doc.setFont("helvetica", "bold");
    doc.setFontSize(10);
    doc.text("Report Notes", 24, 225);

    doc.setTextColor(...MUTED);
    doc.setFont("helvetica", "normal");
    doc.setFontSize(7.5);

    doc.text("This report is generated from current attendance records.", 24, 235, {
      maxWidth: 64,
    });

    doc.text("Please verify data before sharing with parents or staff.", 24, 243, {
      maxWidth: 64,
    });

    const sigX = 120;
    const sigY = 226;

    doc.setTextColor(...DARK);
    doc.setFont("helvetica", "bold");
    doc.setFontSize(13);

    doc.text("Coordinator Signature", sigX + 37, sigY, {
      align: "center",
    });

    doc.setDrawColor(...DARK);
    doc.setLineWidth(0.35);
    doc.line(sigX, sigY + 14, sigX + 74, sigY + 14);

    doc.setTextColor(...MUTED);
    doc.setFont("helvetica", "normal");
    doc.setFontSize(7.5);

    doc.text("Authorized Signature", sigX + 37, sigY + 22, {
      align: "center",
    });

    drawFooter();
  };

  const body = rows.map((r, index) => [
    String(index + 1),
    r.date,
    r.teacherName,
    r.studentName,
    r.entityType,
    r.status,
    r.updatedAt ? new Date(r.updatedAt).toLocaleString() : "—",
  ]);

  autoTable(doc, {
    body,
    startY: 146,
    margin: {
      left: TABLE_X,
      right: TABLE_X,
      top: 146,
      bottom: 40,
    },
    showHead: "never",
    theme: "plain",
    tableWidth: TABLE_W,
    styles: {
      font: "helvetica",
      fontSize: 6.9,
      textColor: TEXT,
      cellPadding: {
        top: 3.8,
        right: 2.2,
        bottom: 3.8,
        left: 2.2,
      },
      overflow: "linebreak",
      lineWidth: 0.25,
      lineColor: [255, 255, 255],
      minCellHeight: 11.5,
      valign: "middle",
    },
    columnStyles: {
      0: {
        cellWidth: TABLE_COLS.sl,
        halign: "center",
        fontStyle: "bold",
      },
      1: {
        cellWidth: TABLE_COLS.date,
        halign: "center",
      },
      2: {
        cellWidth: TABLE_COLS.teacher,
      },
      3: {
        cellWidth: TABLE_COLS.student,
      },
      4: {
        cellWidth: TABLE_COLS.type,
        halign: "center",
      },
      5: {
        cellWidth: TABLE_COLS.status,
        halign: "center",
      },
      6: {
        cellWidth: TABLE_COLS.updated,
        halign: "center",
      },
    },
    didParseCell: (data: any) => {
      if (data.section !== "body") return;

      const rowIndex = data.row.index;

      data.cell.styles.fillColor =
        rowIndex % 2 === 0 ? [248, 250, 252] : [235, 239, 245];

      if (data.column.index === 0) {
        data.cell.styles.textColor = [71, 85, 105];
        data.cell.styles.fontStyle = "bold";
      }

      if (data.column.index === 2 || data.column.index === 3) {
        data.cell.styles.fontStyle = "bold";
        data.cell.styles.textColor = [15, 23, 42];
      }

      if (data.column.index === 4) {
        data.cell.styles.textColor = [71, 85, 105];
        data.cell.styles.fontStyle = "bold";
      }

      if (data.column.index === 5) {
        data.cell.text = [""];
      }

      if (data.column.index === 6) {
        data.cell.styles.fontSize = 6.5;
        data.cell.styles.textColor = [71, 85, 105];
      }
    },
    didDrawCell: (data: any) => {
      if (data.section !== "body") return;
      if (data.column.index !== 5) return;

      const status = String(data.cell.raw || "");
      const cx = data.cell.x + data.cell.width / 2;
      const cy = data.cell.y + data.cell.height / 2;

      let pillColor: [number, number, number] = [100, 116, 139];
      let pillBg: [number, number, number] = [241, 245, 249];
      let label = status || "—";

      if (status === AttendanceStatus.PRESENT) {
        pillColor = GREEN;
        pillBg = [236, 253, 245];
        label = "Present";
      } else if (status === AttendanceStatus.ABSENT) {
        pillColor = RED;
        pillBg = [254, 242, 242];
        label = "Absent";
      } else if (status === AttendanceStatus.LEAVE) {
        pillColor = AMBER;
        pillBg = [255, 251, 235];
        label = "Leave";
      }

      const pillW = 17;
      const pillH = 6.2;
      const pillX = cx - pillW / 2;
      const pillY = cy - pillH / 2;

      doc.setFillColor(...pillBg);
      doc.roundedRect(pillX, pillY, pillW, pillH, 2.8, 2.8, "F");

      doc.setDrawColor(...pillColor);
      doc.setLineWidth(0.18);
      doc.roundedRect(pillX, pillY, pillW, pillH, 2.8, 2.8, "S");

      doc.setTextColor(...pillColor);
      doc.setFont("helvetica", "bold");
      doc.setFontSize(5.2);

      doc.text(label, cx, pillY + 4.2, {
        align: "center",
      });
    },
    willDrawPage: () => {
      drawTablePageHeader();
    },
    didDrawPage: () => {
      drawFooter();
    },
  });

  drawSummaryPage();

  const pageCount = doc.getNumberOfPages();

  for (let i = 1; i <= pageCount; i += 1) {
    doc.setPage(i);
    drawFooter();
  }

  doc.save(`attendance_report_${effectiveRange.start}_to_${effectiveRange.end}.pdf`);
};
  const rangeText = `${effectiveRange.start || "----"} → ${effectiveRange.end || "----"}`;
  const showUnmarkedTip = includeUnmarked && teacherId === "all" && studentId === "all";

const attendanceRowsForDisplay = useMemo(() => rows.slice().reverse(), [rows]);

const pagedAttendance = useMemo(
  () => paginate(attendanceRowsForDisplay, attendancePage, REPORT_PAGE_SIZE),
  [attendanceRowsForDisplay, attendancePage]
);

const pagedStudents = useMemo(
  () => paginate(studentReports, studentPage, CARD_PAGE_SIZE),
  [studentReports, studentPage]
);

const pagedTeachers = useMemo(
  () => paginate(teacherReports, teacherPage, CARD_PAGE_SIZE),
  [teacherReports, teacherPage]
);

const pagedParents = useMemo(
  () => paginate(studentReports, parentPage, CARD_PAGE_SIZE),
  [studentReports, parentPage]
);

  return (
    <div className="w-full max-w-none mx-auto space-y-6">
      <div className="relative overflow-hidden rounded-[34px] border border-slate-200/70 bg-white/75 backdrop-blur-xl shadow-[0_24px_70px_rgba(15,23,42,0.09)] p-6">
        <div className="pointer-events-none absolute -top-28 -right-28 h-80 w-80 rounded-full bg-emerald-200/35 blur-3xl" />
        <div className="pointer-events-none absolute -bottom-28 -left-28 h-80 w-80 rounded-full bg-indigo-200/25 blur-3xl" />

        <div className="relative flex flex-col xl:flex-row xl:items-start justify-between gap-5">
          <div>
            <div className="inline-flex items-center gap-2 rounded-full bg-emerald-50 text-emerald-700 border border-emerald-100 px-3 py-1.5 text-xs font-extrabold">
              <FileText size={14} />
              Reports & Parent Summary
            </div>

            <h2 className="mt-4 text-2xl md:text-3xl font-black text-slate-950 tracking-tight">
              Reports Dashboard
            </h2>

            <p className="mt-2 text-sm text-slate-500 max-w-2xl">
              Review attendance, student progress, teacher performance, and parent-ready summaries in one report view.
            </p>
          </div>

          <div className="flex flex-wrap gap-2">
            <IconButton
              enabled={canExportCsv}
              onClick={exportCSV}
              icon={<FileDown size={16} />}
              label="CSV"
              tone="bg-slate-900 hover:bg-slate-800 text-white shadow-[0_18px_36px_-18px_rgba(15,23,42,0.55)]"
            />

            <IconButton
              enabled={canExportExcel}
              onClick={exportExcel}
              icon={<FileSpreadsheet size={16} />}
              label="Excel"
              tone="bg-blue-600 hover:bg-blue-700 text-white shadow-[0_18px_36px_-18px_rgba(37,99,235,0.55)]"
            />

            <IconButton
              enabled={canExportPdf}
              onClick={exportPDF}
              icon={<FileText size={16} />}
              label="PDF"
              tone="bg-emerald-600 hover:bg-emerald-700 text-white shadow-[0_18px_36px_-18px_rgba(16,185,129,0.55)]"
            />

            <button
              type="button"
              onClick={() => void loadLessons()}
              disabled={lessonsLoading}
              className="inline-flex items-center gap-2 px-4 py-2 rounded-2xl text-xs font-extrabold bg-white border border-slate-200 text-slate-700 hover:bg-slate-50 transition disabled:opacity-60"
            >
              {lessonsLoading ? <Loader2 size={16} className="animate-spin" /> : <RefreshCw size={16} />}
              Refresh Lessons
            </button>
          </div>
        </div>

        <div className="relative mt-6 grid grid-cols-2 lg:grid-cols-4 gap-4">
          <StatCard
            label="Present"
            value={summary.Present ?? 0}
            icon={<CheckCircle2 size={22} />}
            tone="bg-emerald-50 border-emerald-100 text-emerald-700"
          />

          <StatCard
            label="Absent"
            value={summary.Absent ?? 0}
            icon={<XCircle size={22} />}
            tone="bg-rose-50 border-rose-100 text-rose-700"
          />

          <StatCard
            label="Leave"
            value={summary.Leave ?? 0}
            icon={<PauseCircle size={22} />}
            tone="bg-amber-50 border-amber-100 text-amber-800"
          />

          <StatCard
            label="Unmarked"
            value={summary.Unmarked ?? 0}
            icon={<MinusCircle size={22} />}
            tone="bg-slate-50 border-slate-200 text-slate-700"
          />
        </div>
      </div>

      {lessonMessage && (
        <div className="rounded-2xl border border-amber-200 bg-amber-50 px-4 py-3 text-sm font-semibold text-amber-800">
          {lessonMessage}
        </div>
      )}

      <div className="rounded-[30px] border border-slate-200/70 bg-white/80 backdrop-blur-xl shadow-[0_18px_55px_rgba(15,23,42,0.07)] p-5">
        <div className="flex flex-col xl:flex-row xl:items-end xl:justify-between gap-4">
          <div className="flex flex-wrap items-center gap-2">
            <div className="inline-flex items-center gap-2 rounded-2xl bg-white/75 border border-slate-200/70 px-3 py-2 shadow-sm">

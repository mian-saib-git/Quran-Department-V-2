import {
  AlertCircle,
  BookOpen,
  CalendarClock,
  CheckCircle2,
  Copy,
  Edit3,
  GraduationCap,
  Loader2,
  Plus,
  RefreshCw,
  Search,
  ShieldCheck,
  Trash2,
  Upload,
  UserRound,
  Users,
  X,
} from "lucide-react";

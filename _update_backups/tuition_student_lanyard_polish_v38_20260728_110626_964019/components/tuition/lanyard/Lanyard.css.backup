/* IVS_TUITION_STUDENT_PORTAL_V37_FREE_DRAG_CONNECTED_STRAP */
.lanyard-wrapper {
  position: absolute;
  inset: 0;
  z-index: 70;
  width: 100%;
  height: 100%;
  min-height: 100%;
  overflow: visible;
  pointer-events: none;
  touch-action: pan-y;
  user-select: none;
  -webkit-user-select: none;
}

.lanyard-wrapper canvas {
  position: absolute;
  inset: 0;
  z-index: 2;
  display: block;
  width: 100% !important;
  height: 100% !important;
  overflow: visible;
  outline: none;
  pointer-events: none;
}

/* No dedicated panel exists. This layer spans the complete Overview surface. */
.tuition-overview-lanyard-layer {
  position: absolute;
  inset: -24px 0 0;
  z-index: 70;
  overflow: visible;
  pointer-events: none;
  isolation: isolate;
}

@media (max-width: 767px) {
  .tuition-overview-lanyard-layer {
    inset: -12px -10px 0;
  }
}

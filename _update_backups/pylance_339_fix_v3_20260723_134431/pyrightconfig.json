{
  "include": [
    "backend"
  ],
  "exclude": [
    "backend/venv",
    "backend/**/__pycache__",
    "backend/**/migrations"
  ],
  "venvPath": "backend",
  "venv": "venv",
  "typeCheckingMode": "basic",
  "reportMissingImports": "error",
  "reportMissingModuleSource": "warning",
  "executionEnvironments": [
    {
      "root": "backend",
      "extraPaths": [
        "backend"
      ]
    }
  ]
}

import React, { useEffect, useMemo, useState } from "react";
import {
  AlertTriangle,
  Bot,
  Check,
  CheckCircle2,
  ChevronLeft,
  ChevronRight,
  Clipboard,
  Database,
  Download,
  Eye,
  EyeOff,
  FileArchive,
  Globe2,
  HardDrive,
  HeartPulse,
  KeyRound,
  Loader2,
  LockKeyhole,
  Pencil,
  Plus,
  RefreshCw,
  Save,
  Search,
  Server,
  ShieldCheck,
  SlidersHorizontal,
  Trash2,
  Upload,
  UserCog,
  UsersRound,
  X,
} from "lucide-react";

import {
  createPlatformBackup,
  createPlatformPortalAdministrator,
  deletePlatformBackup,
  downloadPlatformBackup,
  getPlatformApplicationSettings,
  getPlatformAuditLogs,
  getPlatformBackups,
  getPlatformPortalAdministrators,
  getPlatformSystemHealth,
  resetPlatformPortalAdministratorPassword,
  testPlatformGeminiConnection,
  updatePlatformApplicationSettings,
  updatePlatformPortalAdministrator,
  uploadPlatformBackup,
  type PlatformApplicationSettings,
  type PlatformAuditLog,
  type PlatformBackupCapabilities,
  type PlatformBackupItem,
  type PlatformDepartment,
  type PlatformPortalAdministrator,
  type PlatformSystemHealth,
} from "../../services/djangoApiService";

type ModalProps = {
  title: string;
  subtitle?: string;
  onClose: () => void;
  children: React.ReactNode;
  maxWidth?: string;
};

function Modal({ title, subtitle, onClose, children, maxWidth = "max-w-2xl" }: ModalProps) {
  useEffect(() => {
    const onKeyDown = (event: KeyboardEvent) => {
      if (event.key === "Escape") onClose();
    };
    window.addEventListener("keydown", onKeyDown);
    return () => window.removeEventListener("keydown", onKeyDown);
  }, [onClose]);

  return (
    <div className="fixed inset-0 z-[120] flex items-center justify-center bg-slate-950/55 p-4 backdrop-blur-sm">
      <button type="button" aria-label="Close dialog" className="absolute inset-0" onClick={onClose} />
      <section className={`relative max-h-[92vh] w-full ${maxWidth} overflow-y-auto rounded-[30px] border border-slate-200 bg-white shadow-[0_30px_100px_rgba(15,23,42,0.35)] [scrollbar-width:thin] dark:border-slate-700 dark:bg-slate-900`}>
        <header className="sticky top-0 z-10 flex items-start justify-between gap-4 border-b border-slate-200 bg-white/95 p-5 backdrop-blur-xl dark:border-slate-700 dark:bg-slate-900/95">
          <div>
            <h2 className="text-xl font-black text-slate-950 dark:text-white">{title}</h2>
            {subtitle && <p className="mt-1 text-xs font-semibold text-slate-500 dark:text-slate-400">{subtitle}</p>}
          </div>
          <button type="button" onClick={onClose} className="grid h-10 w-10 shrink-0 place-items-center rounded-2xl border border-slate-200 text-slate-500 transition hover:bg-slate-100 hover:text-slate-950 dark:border-slate-700 dark:hover:bg-slate-800 dark:hover:text-white">
            <X size={18} />
          </button>
        </header>
        <div className="p-5">{children}</div>
      </section>
    </div>
  );
}

function SectionHeader({
  icon: Icon,
  eyebrow,
  title,
  subtitle,
  actions,
}: {
  icon: React.ComponentType<{ size?: number }>;
  eyebrow: string;
  title: string;
  subtitle: string;
  actions?: React.ReactNode;
}) {
  return (
    <div className="flex flex-col gap-4 rounded-[28px] border border-slate-200 bg-white p-5 shadow-[0_18px_46px_rgba(15,23,42,0.06)] dark:border-slate-700 dark:bg-slate-900 md:flex-row md:items-center md:justify-between">
      <div className="flex min-w-0 items-center gap-4">
        <span className="grid h-14 w-14 shrink-0 place-items-center rounded-[20px] border border-indigo-100 bg-gradient-to-br from-white to-indigo-100 text-indigo-600 shadow-[0_12px_26px_rgba(79,70,229,0.15)] dark:border-indigo-500/30 dark:from-slate-800 dark:to-indigo-500/15 dark:text-indigo-300">
          <Icon size={23} />
        </span>
        <div className="min-w-0">
          <div className="text-[10px] font-black uppercase tracking-[0.18em] text-indigo-600 dark:text-indigo-300">{eyebrow}</div>
          <h2 className="mt-1 text-xl font-black tracking-tight text-slate-950 dark:text-white md:text-2xl">{title}</h2>
          <p className="mt-1 text-sm font-semibold text-slate-500 dark:text-slate-400">{subtitle}</p>
        </div>
      </div>
      {actions && <div className="flex shrink-0 flex-wrap items-center gap-2">{actions}</div>}
    </div>
  );
}

function Notice({ text, tone = "neutral" }: { text: string; tone?: "neutral" | "success" | "danger" | "warning" }) {
  if (!text) return null;
  const classes = {
    neutral: "border-slate-200 bg-white text-slate-700 dark:border-slate-700 dark:bg-slate-900 dark:text-slate-200",
    success: "border-emerald-200 bg-emerald-50 text-emerald-800 dark:border-emerald-500/25 dark:bg-emerald-500/10 dark:text-emerald-200",
    danger: "border-rose-200 bg-rose-50 text-rose-700 dark:border-rose-500/25 dark:bg-rose-500/10 dark:text-rose-200",
    warning: "border-amber-200 bg-amber-50 text-amber-800 dark:border-amber-500/25 dark:bg-amber-500/10 dark:text-amber-200",
  }[tone];
  return <div className={`rounded-2xl border px-4 py-3 text-sm font-bold ${classes}`}>{text}</div>;
}

function SpinnerCard({ label = "Loading..." }: { label?: string }) {
  return (
    <div className="flex min-h-[260px] items-center justify-center rounded-[28px] border border-slate-200 bg-white dark:border-slate-700 dark:bg-slate-900">
      <div className="flex items-center gap-3 text-sm font-black text-slate-600 dark:text-slate-300">
        <Loader2 size={20} className="animate-spin text-indigo-600" />
        {label}
      </div>
    </div>
  );
}

function PasswordInput({ value, onChange, placeholder = "Current Main Admin password" }: { value: string; onChange: (value: string) => void; placeholder?: string }) {
  const [visible, setVisible] = useState(false);
  return (
    <div className="relative">
      <LockKeyhole size={17} className="pointer-events-none absolute left-3.5 top-1/2 -translate-y-1/2 text-slate-400" />
      <input
        type={visible ? "text" : "password"}
        value={value}
        onChange={(event) => onChange(event.target.value)}
        placeholder={placeholder}
        autoComplete="current-password"
        className="w-full rounded-2xl border border-slate-200 bg-white py-3 pl-10 pr-11 text-sm font-bold text-slate-900 outline-none transition focus:border-indigo-400 focus:ring-4 focus:ring-indigo-100 dark:border-slate-700 dark:bg-slate-800 dark:text-white dark:focus:ring-indigo-500/15"
      />
      <button type="button" onClick={() => setVisible((item) => !item)} className="absolute right-2.5 top-1/2 grid h-8 w-8 -translate-y-1/2 place-items-center rounded-xl text-slate-400 hover:bg-slate-100 hover:text-slate-700 dark:hover:bg-slate-700 dark:hover:text-white">
        {visible ? <EyeOff size={16} /> : <Eye size={16} />}
      </button>
    </div>
  );
}

function formatDate(value: string | null | undefined) {
  if (!value) return "Never";
  const date = new Date(value);
  if (Number.isNaN(date.getTime())) return "Unknown";
  return date.toLocaleString([], { dateStyle: "medium", timeStyle: "short" });
}

function formatBytes(value: number) {
  if (!Number.isFinite(value) || value <= 0) return "0 B";
  const units = ["B", "KB", "MB", "GB", "TB"];
  const index = Math.min(Math.floor(Math.log(value) / Math.log(1024)), units.length - 1);
  return `${(value / 1024 ** index).toFixed(index === 0 ? 0 : 1)} ${units[index]}`;
}

async function copyText(value: string) {
  await navigator.clipboard.writeText(value);
}

const emptyAdminForm = {
  full_name: "",
  username: "",
  email: "",
  role: "department_admin" as "department_admin" | "coordinator" | "institution_admin",
  department_id: "",
  is_active: true,
  new_password: "",
  current_password: "",
};

export function PortalAdministratorsPanel() {
  const [administrators, setAdministrators] = useState<PlatformPortalAdministrator[]>([]);
  const [departments, setDepartments] = useState<PlatformDepartment[]>([]);
  const [loading, setLoading] = useState(true);
  const [notice, setNotice] = useState("");
  const [error, setError] = useState("");
  const [search, setSearch] = useState("");
  const [departmentFilter, setDepartmentFilter] = useState("");
  const [roleFilter, setRoleFilter] = useState("");
  const [editing, setEditing] = useState<PlatformPortalAdministrator | "new" | null>(null);
  const [form, setForm] = useState(emptyAdminForm);
  const [saving, setSaving] = useState(false);
  const [resetTarget, setResetTarget] = useState<PlatformPortalAdministrator | null>(null);
  const [resetPassword, setResetPassword] = useState("");
  const [resetCurrentPassword, setResetCurrentPassword] = useState("");
  const [temporaryPassword, setTemporaryPassword] = useState("");

  const load = async () => {
    setLoading(true);
    setError("");
    try {
      const response = await getPlatformPortalAdministrators();
      setAdministrators(response.administrators || []);
      setDepartments(response.departments || []);
    } catch (err: any) {
      setError(err?.message || "Could not load portal administrators.");
    } finally {
      setLoading(false);
    }
  };

  useEffect(() => {
    void load();
  }, []);

  const filtered = useMemo(() => {
    const query = search.trim().toLowerCase();
    return administrators.filter((item) => {
      if (departmentFilter && String(item.department?.id || "") !== departmentFilter) return false;
      if (roleFilter && item.role !== roleFilter) return false;
      if (!query) return true;
      return [item.full_name, item.username, item.email, item.department?.name, item.institution?.name, item.role_label]
        .filter(Boolean)
        .some((value) => String(value).toLowerCase().includes(query));
    });
  }, [administrators, departmentFilter, roleFilter, search]);

  const openNew = () => {
    setForm({ ...emptyAdminForm, department_id: departments[0] ? String(departments[0].id) : "" });
    setEditing("new");
    setError("");
  };

  const openEdit = (item: PlatformPortalAdministrator) => {
    setForm({
      full_name: item.full_name,
      username: item.username,
      email: item.email || "",
      role: item.role,
      department_id: item.department ? String(item.department.id) : "",
      is_active: item.is_active,
      new_password: "",
      current_password: "",
    });
    setEditing(item);
    setError("");
  };

  const saveAdministrator = async () => {
    setError("");
    setNotice("");
    if (!form.full_name.trim() || !form.username.trim() || !form.department_id || !form.current_password) {
      setError("Full name, username, department, and your current Main Admin password are required.");
      return;
    }
    if (editing === "new" && !form.new_password) {
      setError("Enter a starting password for the new administrator.");
      return;
    }
    setSaving(true);
    try {
      const payload = {
        full_name: form.full_name.trim(),
        username: form.username.trim(),
        email: form.email.trim(),
        role: form.role,
        department_id: Number(form.department_id),
        is_active: form.is_active,
        current_password: form.current_password,
        new_password: form.new_password || undefined,
      };
      if (editing === "new") {
        await createPlatformPortalAdministrator(payload);
        setNotice("Portal administrator created successfully.");
      } else if (editing) {
        await updatePlatformPortalAdministrator(editing.id, payload);
        setNotice("Portal administrator updated successfully.");
      }
      setEditing(null);
      setForm(emptyAdminForm);
      await load();
    } catch (err: any) {
      setError(err?.message || "Could not save the portal administrator.");
    } finally {
      setSaving(false);
    }
  };

  const submitReset = async () => {
    if (!resetTarget || !resetCurrentPassword) {
      setError("Enter your current Main Admin password.");
      return;
    }
    setSaving(true);
    setError("");
    try {
      const response = await resetPlatformPortalAdministratorPassword(resetTarget.id, {
        current_password: resetCurrentPassword,
        new_password: resetPassword || undefined,
      });
      if (response.temporary_password) {
        setTemporaryPassword(response.temporary_password);
      } else {
        setNotice(`Password updated for ${resetTarget.username}.`);
        setResetTarget(null);
      }
      setResetPassword("");
      setResetCurrentPassword("");
    } catch (err: any) {
      setError(err?.message || "Could not reset the password.");
    } finally {
      setSaving(false);
    }
  };

  return (
    <div className="space-y-5">
      <SectionHeader
        icon={UsersRound}
        eyebrow="Account control"
        title="Portal Administrators"
        subtitle="Manage manager usernames, names, email addresses, status, department assignments, and password resets. Existing passwords are never displayed."
        actions={
          <>
            <button type="button" onClick={() => void load()} className="grid h-11 w-11 place-items-center rounded-2xl border border-slate-200 bg-white text-slate-600 transition hover:bg-slate-50 dark:border-slate-700 dark:bg-slate-800 dark:text-slate-300 dark:hover:bg-slate-700" title="Refresh administrators">
              <RefreshCw size={18} />
            </button>
            <button type="button" onClick={openNew} className="inline-flex h-11 items-center gap-2 rounded-2xl bg-indigo-600 px-4 text-sm font-black text-white shadow-[0_12px_24px_rgba(79,70,229,0.24)] transition hover:-translate-y-0.5 hover:bg-indigo-700">
              <Plus size={18} /> Add Administrator
            </button>
          </>
        }
      />

      <Notice text={notice} tone="success" />
      <Notice text={error} tone="danger" />

      <div className="grid gap-3 rounded-[24px] border border-slate-200 bg-white p-4 dark:border-slate-700 dark:bg-slate-900 md:grid-cols-[minmax(260px,1fr)_220px_190px]">
        <label className="relative">
          <Search size={17} className="absolute left-3.5 top-1/2 -translate-y-1/2 text-slate-400" />
          <input value={search} onChange={(event) => setSearch(event.target.value)} placeholder="Search name, username or department..." className="w-full rounded-2xl border border-slate-200 bg-slate-50 py-3 pl-10 pr-4 text-sm font-bold outline-none focus:border-indigo-400 focus:ring-4 focus:ring-indigo-100 dark:border-slate-700 dark:bg-slate-800 dark:focus:ring-indigo-500/15" />
        </label>
        <select value={departmentFilter} onChange={(event) => setDepartmentFilter(event.target.value)} className="rounded-2xl border border-slate-200 bg-slate-50 px-4 py-3 text-sm font-bold outline-none focus:border-indigo-400 dark:border-slate-700 dark:bg-slate-800">
          <option value="">All departments</option>
          {departments.map((item) => <option key={item.id} value={item.id}>{item.institution.name} · {item.name}</option>)}
        </select>
        <select value={roleFilter} onChange={(event) => setRoleFilter(event.target.value)} className="rounded-2xl border border-slate-200 bg-slate-50 px-4 py-3 text-sm font-bold outline-none focus:border-indigo-400 dark:border-slate-700 dark:bg-slate-800">
          <option value="">All manager roles</option>
          <option value="institution_admin">Institution Admin</option>
          <option value="department_admin">Department Admin</option>
          <option value="coordinator">Coordinator</option>
        </select>
      </div>

      {loading ? <SpinnerCard label="Loading portal administrators..." /> : (
        <div className="overflow-hidden rounded-[28px] border border-slate-200 bg-white shadow-sm dark:border-slate-700 dark:bg-slate-900">
          <div className="hidden grid-cols-[minmax(280px,1.25fr)_minmax(240px,1fr)_150px_140px_220px] gap-4 border-b border-slate-200 bg-slate-50 px-5 py-4 text-[10px] font-black uppercase tracking-[0.12em] text-slate-500 dark:border-slate-700 dark:bg-slate-800/80 xl:grid">
            <span>Administrator</span><span>Scope</span><span>Role</span><span>Status</span><span className="text-right">Actions</span>
          </div>
          {filtered.length === 0 ? (
            <div className="p-12 text-center text-sm font-bold text-slate-500">No portal administrators match the selected filters.</div>
          ) : filtered.map((item) => (
            <div key={item.id} className="grid gap-4 border-b border-slate-200 px-5 py-4 last:border-b-0 dark:border-slate-700 xl:grid-cols-[minmax(280px,1.25fr)_minmax(240px,1fr)_150px_140px_220px] xl:items-center">
              <div className="flex min-w-0 items-center gap-3">
                <span className="grid h-12 w-12 shrink-0 place-items-center rounded-2xl bg-indigo-50 text-indigo-600 dark:bg-indigo-500/12 dark:text-indigo-300"><UserCog size={20} /></span>
                <div className="min-w-0"><div className="truncate text-sm font-black text-slate-950 dark:text-white">{item.full_name}</div><div className="mt-1 truncate text-xs font-semibold text-slate-500">@{item.username}{item.email ? ` · ${item.email}` : ""}</div></div>
              </div>
              <div><div className="text-sm font-black text-slate-800 dark:text-slate-100">{item.department?.name || "Institution scope"}</div><div className="mt-1 text-xs font-semibold text-slate-500">{item.institution?.name || "No institution assigned"}</div></div>
              <span className="w-fit rounded-full border border-indigo-100 bg-indigo-50 px-3 py-1.5 text-xs font-black text-indigo-700 dark:border-indigo-500/25 dark:bg-indigo-500/10 dark:text-indigo-200">{item.role_label}</span>
              <div><span className={`inline-flex rounded-full px-3 py-1.5 text-xs font-black ${item.is_active ? "bg-emerald-50 text-emerald-700 dark:bg-emerald-500/10 dark:text-emerald-200" : "bg-slate-100 text-slate-500 dark:bg-slate-800 dark:text-slate-400"}`}>{item.is_active ? "Active" : "Disabled"}</span><div className="mt-1 text-[10px] font-semibold text-slate-400">Last login: {formatDate(item.last_login)}</div></div>
              <div className="flex flex-wrap justify-start gap-2 xl:justify-end">
                <button type="button" onClick={() => openEdit(item)} className="inline-flex items-center gap-2 rounded-xl border border-slate-200 px-3 py-2 text-xs font-black text-slate-700 transition hover:bg-slate-50 dark:border-slate-700 dark:text-slate-200 dark:hover:bg-slate-800"><Pencil size={15} /> Edit</button>
                <button type="button" onClick={() => { setResetTarget(item); setTemporaryPassword(""); setError(""); }} className="inline-flex items-center gap-2 rounded-xl border border-amber-200 bg-amber-50 px-3 py-2 text-xs font-black text-amber-700 transition hover:bg-amber-100 dark:border-amber-500/25 dark:bg-amber-500/10 dark:text-amber-200"><KeyRound size={15} /> Reset Password</button>
              </div>
            </div>
          ))}
        </div>
      )}

      {editing && (
        <Modal title={editing === "new" ? "Add Portal Administrator" : "Edit Portal Administrator"} subtitle="Sensitive changes require your current Main Admin password." onClose={() => setEditing(null)}>
          <div className="grid gap-4 sm:grid-cols-2">
            <label className="sm:col-span-2"><span className="mb-1.5 block text-xs font-black text-slate-600 dark:text-slate-300">Full name</span><input value={form.full_name} onChange={(event) => setForm({ ...form, full_name: event.target.value })} className="w-full rounded-2xl border border-slate-200 px-4 py-3 text-sm font-bold outline-none focus:border-indigo-400 dark:border-slate-700 dark:bg-slate-800" /></label>
            <label><span className="mb-1.5 block text-xs font-black text-slate-600 dark:text-slate-300">Username</span><input value={form.username} onChange={(event) => setForm({ ...form, username: event.target.value })} className="w-full rounded-2xl border border-slate-200 px-4 py-3 text-sm font-bold outline-none focus:border-indigo-400 dark:border-slate-700 dark:bg-slate-800" /></label>
            <label><span className="mb-1.5 block text-xs font-black text-slate-600 dark:text-slate-300">Email</span><input type="email" value={form.email} onChange={(event) => setForm({ ...form, email: event.target.value })} className="w-full rounded-2xl border border-slate-200 px-4 py-3 text-sm font-bold outline-none focus:border-indigo-400 dark:border-slate-700 dark:bg-slate-800" /></label>
            <label><span className="mb-1.5 block text-xs font-black text-slate-600 dark:text-slate-300">Department</span><select value={form.department_id} onChange={(event) => setForm({ ...form, department_id: event.target.value })} className="w-full rounded-2xl border border-slate-200 px-4 py-3 text-sm font-bold outline-none focus:border-indigo-400 dark:border-slate-700 dark:bg-slate-800"><option value="">Select department</option>{departments.map((item) => <option key={item.id} value={item.id}>{item.institution.name} · {item.name}</option>)}</select></label>
            <label><span className="mb-1.5 block text-xs font-black text-slate-600 dark:text-slate-300">Portal role</span><select value={form.role} onChange={(event) => setForm({ ...form, role: event.target.value as typeof form.role })} className="w-full rounded-2xl border border-slate-200 px-4 py-3 text-sm font-bold outline-none focus:border-indigo-400 dark:border-slate-700 dark:bg-slate-800"><option value="department_admin">Department Admin</option><option value="coordinator">Coordinator</option>{editing !== "new" && <option value="institution_admin">Institution Admin</option>}</select></label>
            <label className="sm:col-span-2"><span className="mb-1.5 block text-xs font-black text-slate-600 dark:text-slate-300">{editing === "new" ? "Starting password" : "Optional new password"}</span><input type="password" value={form.new_password} onChange={(event) => setForm({ ...form, new_password: event.target.value })} autoComplete="new-password" placeholder={editing === "new" ? "At least 10 characters" : "Leave blank to keep the current password"} className="w-full rounded-2xl border border-slate-200 px-4 py-3 text-sm font-bold outline-none focus:border-indigo-400 dark:border-slate-700 dark:bg-slate-800" /></label>
            <label className="sm:col-span-2 flex items-center justify-between rounded-2xl border border-slate-200 bg-slate-50 px-4 py-3 dark:border-slate-700 dark:bg-slate-800"><span><span className="block text-sm font-black">Account active</span><span className="text-xs font-semibold text-slate-500">Disabled administrators cannot log in.</span></span><input type="checkbox" checked={form.is_active} onChange={(event) => setForm({ ...form, is_active: event.target.checked })} className="h-5 w-5 accent-indigo-600" /></label>
            <div className="sm:col-span-2"><span className="mb-1.5 block text-xs font-black text-slate-600 dark:text-slate-300">Confirm with your Main Admin password</span><PasswordInput value={form.current_password} onChange={(value) => setForm({ ...form, current_password: value })} /></div>
          </div>
          <Notice text={error} tone="danger" />
          <div className="mt-5 flex justify-end gap-2"><button type="button" onClick={() => setEditing(null)} className="rounded-2xl border border-slate-200 px-4 py-3 text-sm font-black dark:border-slate-700">Cancel</button><button type="button" onClick={() => void saveAdministrator()} disabled={saving} className="inline-flex items-center gap-2 rounded-2xl bg-indigo-600 px-5 py-3 text-sm font-black text-white disabled:opacity-60">{saving ? <Loader2 size={17} className="animate-spin" /> : <Save size={17} />} Save Administrator</button></div>
        </Modal>
      )}

      {resetTarget && (
        <Modal title="Reset Portal Password" subtitle={`Set a new password for @${resetTarget.username}, or leave the field blank to generate a secure temporary password.`} onClose={() => { setResetTarget(null); setTemporaryPassword(""); }}>
          {temporaryPassword ? (
            <div className="space-y-4">
              <div className="rounded-[24px] border border-emerald-200 bg-emerald-50 p-5 dark:border-emerald-500/25 dark:bg-emerald-500/10"><div className="flex items-center gap-2 text-sm font-black text-emerald-800 dark:text-emerald-200"><CheckCircle2 size={18} /> Password reset successfully</div><p className="mt-2 text-xs font-semibold text-emerald-700/80 dark:text-emerald-200/75">This temporary password is shown once. Copy it before closing.</p><div className="mt-4 flex items-center gap-2 rounded-2xl border border-emerald-200 bg-white p-3 font-mono text-sm font-black text-slate-900 dark:border-emerald-500/25 dark:bg-slate-900 dark:text-white"><span className="min-w-0 flex-1 break-all">{temporaryPassword}</span><button type="button" onClick={() => void copyText(temporaryPassword)} className="grid h-9 w-9 shrink-0 place-items-center rounded-xl bg-emerald-100 text-emerald-700 dark:bg-emerald-500/15 dark:text-emerald-200"><Clipboard size={16} /></button></div></div>
              <button type="button" onClick={() => { setResetTarget(null); setTemporaryPassword(""); }} className="w-full rounded-2xl bg-slate-950 py-3 text-sm font-black text-white dark:bg-white dark:text-slate-950">Done</button>
            </div>
          ) : (
            <div className="space-y-4"><label><span className="mb-1.5 block text-xs font-black text-slate-600 dark:text-slate-300">New password, optional</span><input type="password" value={resetPassword} onChange={(event) => setResetPassword(event.target.value)} autoComplete="new-password" placeholder="Leave blank to generate one" className="w-full rounded-2xl border border-slate-200 px-4 py-3 text-sm font-bold outline-none focus:border-indigo-400 dark:border-slate-700 dark:bg-slate-800" /></label><div><span className="mb-1.5 block text-xs font-black text-slate-600 dark:text-slate-300">Your Main Admin password</span><PasswordInput value={resetCurrentPassword} onChange={setResetCurrentPassword} /></div><Notice text={error} tone="danger" /><button type="button" onClick={() => void submitReset()} disabled={saving} className="inline-flex w-full items-center justify-center gap-2 rounded-2xl bg-amber-500 py-3 text-sm font-black text-white disabled:opacity-60">{saving ? <Loader2 size={17} className="animate-spin" /> : <KeyRound size={17} />} Reset Password</button></div>
          )}
        </Modal>
      )}
    </div>
  );
}

export function BackupRestorePanel() {
  const [backups, setBackups] = useState<PlatformBackupItem[]>([]);
  const [capabilities, setCapabilities] = useState<PlatformBackupCapabilities | null>(null);
  const [loading, setLoading] = useState(true);
  const [working, setWorking] = useState(false);
  const [notice, setNotice] = useState("");
  const [error, setError] = useState("");
  const [createOpen, setCreateOpen] = useState(false);
  const [uploadOpen, setUploadOpen] = useState(false);
  const [deleteTarget, setDeleteTarget] = useState<PlatformBackupItem | null>(null);
  const [password, setPassword] = useState("");
  const [file, setFile] = useState<File | null>(null);
  const [confirmation, setConfirmation] = useState("");
  const [commandTarget, setCommandTarget] = useState<PlatformBackupItem | null>(null);

  const load = async () => {
    setLoading(true);
    setError("");
    try {
      const response = await getPlatformBackups();
      setBackups(response.backups || []);
      setCapabilities(response.capabilities);
    } catch (err: any) {
      setError(err?.message || "Could not load backups.");
    } finally {
      setLoading(false);
    }
  };
  useEffect(() => { void load(); }, []);

  const createBackup = async () => {
    if (!password) { setError("Enter your current Main Admin password."); return; }
    setWorking(true); setError(""); setNotice("");
    try { const item = await createPlatformBackup(password); setNotice(`Backup ${item.filename} created and validated.`); setCreateOpen(false); setPassword(""); await load(); }
    catch (err: any) { setError(err?.message || "Could not create the backup."); }
    finally { setWorking(false); }
  };
  const uploadBackup = async () => {
    if (!file || !password) { setError("Choose a backup file and enter your Main Admin password."); return; }
    setWorking(true); setError(""); setNotice("");
    try { const item = await uploadPlatformBackup(file, password); setNotice(`Backup ${item.filename} uploaded and validated.`); setUploadOpen(false); setFile(null); setPassword(""); await load(); }
    catch (err: any) { setError(err?.message || "Could not upload the backup."); }
    finally { setWorking(false); }
  };
  const removeBackup = async () => {
    if (!deleteTarget || !password || confirmation !== deleteTarget.filename) { setError("Enter your Main Admin password and type the exact filename."); return; }
    setWorking(true); setError("");
    try { await deletePlatformBackup(deleteTarget.id, { current_password: password, confirmation_filename: confirmation }); setNotice(`Backup ${deleteTarget.filename} deleted.`); setDeleteTarget(null); setPassword(""); setConfirmation(""); await load(); }
    catch (err: any) { setError(err?.message || "Could not delete the backup."); }
    finally { setWorking(false); }
  };

  const restoreCommand = commandTarget ? `python manage.py restore_platform_backup --backup-id ${commandTarget.id} --confirm "${commandTarget.filename}"` : "";

  return (
    <div className="space-y-5">
      <SectionHeader icon={Database} eyebrow="Protected data operations" title="Backup & Restore" subtitle="Create, validate, upload, download, and safely prepare PostgreSQL custom-format backups. Live restore remains command-controlled so the website cannot overwrite its own active database connection." actions={<><button type="button" onClick={() => void load()} className="grid h-11 w-11 place-items-center rounded-2xl border border-slate-200 bg-white dark:border-slate-700 dark:bg-slate-800"><RefreshCw size={18} /></button><button type="button" onClick={() => { setUploadOpen(true); setError(""); }} className="inline-flex h-11 items-center gap-2 rounded-2xl border border-indigo-200 bg-indigo-50 px-4 text-sm font-black text-indigo-700 dark:border-indigo-500/25 dark:bg-indigo-500/10 dark:text-indigo-200"><Upload size={17} /> Upload Backup</button><button type="button" onClick={() => { setCreateOpen(true); setError(""); }} className="inline-flex h-11 items-center gap-2 rounded-2xl bg-indigo-600 px-4 text-sm font-black text-white"><Plus size={17} /> Create Backup</button></>} />
      <Notice text={notice} tone="success" /><Notice text={error} tone="danger" />
      {capabilities && <div className="grid gap-3 sm:grid-cols-3"><CapabilityCard label="Backup engine" ok={capabilities.pg_dump_available} detail={capabilities.pg_dump_available ? capabilities.pg_dump_version || "pg_dump available" : "pg_dump not found"} /><CapabilityCard label="Validation engine" ok={capabilities.pg_restore_available} detail={capabilities.pg_restore_available ? capabilities.pg_restore_version || "pg_restore available" : "pg_restore not found"} /><CapabilityCard label="Automatic retention" ok detail={`${capabilities.retention_count} generated backups`} /></div>}
      <div className="rounded-[24px] border border-amber-200 bg-amber-50 p-4 text-sm font-semibold text-amber-800 dark:border-amber-500/25 dark:bg-amber-500/10 dark:text-amber-200"><div className="flex items-start gap-3"><ShieldCheck size={20} className="mt-0.5 shrink-0" /><div><div className="font-black">Restore safety</div><p className="mt-1 text-xs leading-5">Upload and validation are available here. To restore, stop Django and run the generated management command. The command automatically creates a pre-restore backup before changing the database.</p></div></div></div>
      {loading ? <SpinnerCard label="Loading backup library..." /> : (
        <div className="grid gap-4 xl:grid-cols-2">{backups.length === 0 ? <div className="col-span-full rounded-[28px] border border-dashed border-slate-300 bg-white p-12 text-center dark:border-slate-700 dark:bg-slate-900"><FileArchive size={34} className="mx-auto text-slate-400" /><h3 className="mt-3 text-base font-black">No backups yet</h3><p className="mt-1 text-sm font-semibold text-slate-500">Create your first validated PostgreSQL backup.</p></div> : backups.map((item) => <div key={item.id} className="rounded-[26px] border border-slate-200 bg-white p-5 shadow-sm dark:border-slate-700 dark:bg-slate-900"><div className="flex items-start gap-3"><span className="grid h-12 w-12 shrink-0 place-items-center rounded-2xl bg-indigo-50 text-indigo-600 dark:bg-indigo-500/10 dark:text-indigo-300"><FileArchive size={20} /></span><div className="min-w-0 flex-1"><div className="break-all text-sm font-black text-slate-950 dark:text-white">{item.filename}</div><div className="mt-1 text-xs font-semibold text-slate-500">{formatBytes(item.size_bytes)} · {formatDate(item.created_at)} · {item.source.replace("_", " ")}</div></div><span className="rounded-full bg-emerald-50 px-2.5 py-1 text-[10px] font-black uppercase text-emerald-700 dark:bg-emerald-500/10 dark:text-emerald-200">{item.status}</span></div><div className="mt-4 grid gap-2 rounded-2xl bg-slate-50 p-3 text-xs font-semibold text-slate-600 dark:bg-slate-800 dark:text-slate-300"><div className="flex justify-between gap-3"><span>Database</span><strong>{item.database_name || "Unknown"}</strong></div><div className="flex justify-between gap-3"><span>Created by</span><strong>{item.created_by?.full_name || "System"}</strong></div><div className="flex justify-between gap-3"><span>SHA-256</span><strong className="font-mono">{item.checksum_sha256 ? `${item.checksum_sha256.slice(0, 12)}…` : "Unavailable"}</strong></div></div><div className="mt-4 flex flex-wrap gap-2"><button type="button" disabled={!item.download_ready} onClick={() => void downloadPlatformBackup(item).catch((err) => setError(err?.message || "Download failed."))} className="inline-flex items-center gap-2 rounded-xl bg-indigo-600 px-3 py-2 text-xs font-black text-white disabled:opacity-50"><Download size={15} /> Download</button><button type="button" onClick={() => setCommandTarget(item)} className="inline-flex items-center gap-2 rounded-xl border border-slate-200 px-3 py-2 text-xs font-black dark:border-slate-700"><Server size={15} /> Restore Command</button><button type="button" onClick={() => { setDeleteTarget(item); setConfirmation(""); setPassword(""); setError(""); }} className="ml-auto inline-flex items-center gap-2 rounded-xl border border-rose-200 bg-rose-50 px-3 py-2 text-xs font-black text-rose-600 dark:border-rose-500/25 dark:bg-rose-500/10 dark:text-rose-200"><Trash2 size={15} /> Delete</button></div></div>)}</div>
      )}
      {createOpen && <Modal title="Create Database Backup" subtitle="The server will run pg_dump, validate the file, calculate a checksum, and add it to the backup library." onClose={() => { setCreateOpen(false); setPassword(""); }}><div className="space-y-4"><PasswordInput value={password} onChange={setPassword} /><Notice text={error} tone="danger" /><button type="button" onClick={() => void createBackup()} disabled={working} className="inline-flex w-full items-center justify-center gap-2 rounded-2xl bg-indigo-600 py-3 text-sm font-black text-white disabled:opacity-60">{working ? <Loader2 size={17} className="animate-spin" /> : <Database size={17} />} Create and Validate Backup</button></div></Modal>}
      {uploadOpen && <Modal title="Upload Database Backup" subtitle="Only PostgreSQL custom-format .dump or .backup files are accepted and validated." onClose={() => { setUploadOpen(false); setFile(null); setPassword(""); }}><div className="space-y-4"><label className="flex min-h-[150px] cursor-pointer flex-col items-center justify-center rounded-[24px] border-2 border-dashed border-slate-300 bg-slate-50 p-5 text-center transition hover:border-indigo-400 dark:border-slate-700 dark:bg-slate-800"><Upload size={28} className="text-indigo-600" /><span className="mt-3 text-sm font-black">{file ? file.name : "Choose .dump or .backup file"}</span><span className="mt-1 text-xs font-semibold text-slate-500">Maximum upload size: 2 GB</span><input type="file" accept=".dump,.backup" className="hidden" onChange={(event) => setFile(event.target.files?.[0] || null)} /></label><PasswordInput value={password} onChange={setPassword} /><Notice text={error} tone="danger" /><button type="button" onClick={() => void uploadBackup()} disabled={working} className="inline-flex w-full items-center justify-center gap-2 rounded-2xl bg-indigo-600 py-3 text-sm font-black text-white disabled:opacity-60">{working ? <Loader2 size={17} className="animate-spin" /> : <Upload size={17} />} Upload and Validate</button></div></Modal>}
      {deleteTarget && <Modal title="Delete Backup" subtitle="This permanently removes the file from server storage." onClose={() => setDeleteTarget(null)}><div className="space-y-4"><div className="rounded-2xl border border-rose-200 bg-rose-50 p-4 text-sm font-bold text-rose-700 dark:border-rose-500/25 dark:bg-rose-500/10 dark:text-rose-200">Type <strong>{deleteTarget.filename}</strong> exactly.</div><input value={confirmation} onChange={(event) => setConfirmation(event.target.value)} placeholder="Exact backup filename" className="w-full rounded-2xl border border-slate-200 px-4 py-3 text-sm font-bold dark:border-slate-700 dark:bg-slate-800" /><PasswordInput value={password} onChange={setPassword} /><Notice text={error} tone="danger" /><button type="button" onClick={() => void removeBackup()} disabled={working} className="inline-flex w-full items-center justify-center gap-2 rounded-2xl bg-rose-600 py-3 text-sm font-black text-white disabled:opacity-60"><Trash2 size={17} /> Delete Backup</button></div></Modal>}
      {commandTarget && <Modal title="Safe Restore Command" subtitle="Stop Django before running this command inside the backend folder." onClose={() => setCommandTarget(null)}><div className="space-y-4"><div className="rounded-2xl border border-slate-200 bg-slate-950 p-4 font-mono text-xs font-bold leading-6 text-emerald-300 dark:border-slate-700"><span className="break-all">{restoreCommand}</span></div><button type="button" onClick={() => void copyText(restoreCommand)} className="inline-flex w-full items-center justify-center gap-2 rounded-2xl bg-indigo-600 py-3 text-sm font-black text-white"><Clipboard size={17} /> Copy Command</button><div className="rounded-2xl bg-slate-50 p-4 text-xs font-semibold leading-5 text-slate-600 dark:bg-slate-800 dark:text-slate-300">After restore completes, run <strong>python manage.py migrate</strong>, then restart Django. The command creates a pre-restore backup automatically.</div></div></Modal>}
    </div>
  );
}

function CapabilityCard({ label, ok, detail }: { label: string; ok: boolean; detail: string }) {
  return <div className="rounded-[22px] border border-slate-200 bg-white p-4 dark:border-slate-700 dark:bg-slate-900"><div className="flex items-center gap-2 text-sm font-black">{ok ? <CheckCircle2 size={18} className="text-emerald-500" /> : <AlertTriangle size={18} className="text-amber-500" />}{label}</div><div className="mt-2 truncate text-xs font-semibold text-slate-500" title={detail}>{detail}</div></div>;
}

export function ApplicationSettingsPanel() {
  const [settingsState, setSettingsState] = useState<PlatformApplicationSettings | null>(null);
  const [corsText, setCorsText] = useState("");
  const [geminiModel, setGeminiModel] = useState("gemini-2.5-flash");
  const [geminiKey, setGeminiKey] = useState("");
  const [retention, setRetention] = useState("10");
  const [password, setPassword] = useState("");
  const [saving, setSaving] = useState(false);
  const [testing, setTesting] = useState(false);
  const [notice, setNotice] = useState("");
  const [error, setError] = useState("");

  const load = async () => {
    setError("");
    try {
      const response = await getPlatformApplicationSettings();
      setSettingsState(response);
      setCorsText((response.cors_allowed_origins || []).join("\n"));
      setGeminiModel(response.gemini_model || "gemini-2.5-flash");
      setRetention(String(response.backup_retention_count || 10));
    } catch (err: any) {
      setError(err?.message || "Could not load application settings.");
    }
  };

  useEffect(() => {
    void load();
  }, []);

  const saveSettings = async () => {
    if (!password) {
      setError("Enter your current Main Admin password.");
      return;
    }
    setSaving(true);
    setError("");
    setNotice("");
    try {
      const response = await updatePlatformApplicationSettings({
        current_password: password,
        cors_allowed_origins: corsText.split(/\r?\n/).map((item) => item.trim()).filter(Boolean),
        gemini_model: geminiModel.trim(),
        gemini_api_key: geminiKey.trim() || undefined,
        backup_retention_count: Number(retention),
      });
      setSettingsState(response);
      setGeminiKey("");
      setPassword("");
      setNotice("Application settings saved successfully.");
    } catch (err: any) {
      setError(err?.message || "Could not save application settings.");
    } finally {
      setSaving(false);
    }
  };

  const testGemini = async () => {
    setTesting(true);
    setError("");
    setNotice("");
    try {
      const response = await testPlatformGeminiConnection();
      setNotice(`${response.detail} (${response.latency_ms} ms)`);
    } catch (err: any) {
      setError(err?.message || "Gemini connection test failed.");
    } finally {
      setTesting(false);
    }
  };

  return (
    <div className="space-y-5">
      <SectionHeader
        icon={SlidersHorizontal}
        eyebrow="Safe runtime configuration"
        title="Application Settings"
        subtitle="Manage approved operational settings without exposing the complete .env file. Notices and maintenance are now managed from their dedicated secure tab."
        actions={
          <button type="button" onClick={() => void load()} className="grid h-11 w-11 place-items-center rounded-2xl border border-slate-200 bg-white dark:border-slate-700 dark:bg-slate-800">
            <RefreshCw size={18} />
          </button>
        }
      />
      <Notice text={notice} tone="success" />
      <Notice text={error} tone="danger" />

      <div className="grid gap-5 xl:grid-cols-2">
        <section className="rounded-[28px] border border-slate-200 bg-white p-5 dark:border-slate-700 dark:bg-slate-900">
          <div className="flex items-center gap-3">
            <span className="grid h-11 w-11 place-items-center rounded-2xl bg-cyan-50 text-cyan-600 dark:bg-cyan-500/10 dark:text-cyan-300"><Globe2 size={19} /></span>
            <div><h3 className="font-black">Trusted CORS Origins</h3><p className="text-xs font-semibold text-slate-500">One complete http or https origin per line.</p></div>
          </div>
          <textarea value={corsText} onChange={(event) => setCorsText(event.target.value)} rows={8} className="mt-4 w-full rounded-2xl border border-slate-200 bg-slate-50 p-4 font-mono text-xs font-bold outline-none focus:border-indigo-400 dark:border-slate-700 dark:bg-slate-800" placeholder="https://admin.example.com" />
        </section>

        <section className="rounded-[28px] border border-slate-200 bg-white p-5 dark:border-slate-700 dark:bg-slate-900">
          <div className="flex items-center gap-3">
            <span className="grid h-11 w-11 place-items-center rounded-2xl bg-violet-50 text-violet-600 dark:bg-violet-500/10 dark:text-violet-300"><Bot size={19} /></span>
            <div><h3 className="font-black">Gemini Configuration</h3><p className="text-xs font-semibold text-slate-500">The current key is never returned to the browser.</p></div>
          </div>
          <div className="mt-4 space-y-3">
            <label><span className="mb-1.5 block text-xs font-black">Model</span><input value={geminiModel} onChange={(event) => setGeminiModel(event.target.value)} className="w-full rounded-2xl border border-slate-200 px-4 py-3 text-sm font-bold dark:border-slate-700 dark:bg-slate-800" /></label>
            <label><span className="mb-1.5 block text-xs font-black">Replace API key</span><input type="password" value={geminiKey} onChange={(event) => setGeminiKey(event.target.value)} autoComplete="new-password" placeholder={settingsState?.gemini_api_key_configured ? `Configured ${settingsState.gemini_api_key_hint} · leave blank to keep` : "Enter Gemini API key"} className="w-full rounded-2xl border border-slate-200 px-4 py-3 text-sm font-bold dark:border-slate-700 dark:bg-slate-800" /></label>
            <div className="flex items-center justify-between rounded-2xl bg-slate-50 px-4 py-3 text-xs font-bold dark:bg-slate-800"><span>Key source</span><span className="rounded-full bg-white px-2.5 py-1 text-indigo-600 dark:bg-slate-900 dark:text-indigo-300">{settingsState?.gemini_api_key_source || "missing"}</span></div>
            <button type="button" onClick={() => void testGemini()} disabled={testing || !settingsState?.gemini_api_key_configured} className="inline-flex w-full items-center justify-center gap-2 rounded-2xl border border-violet-200 bg-violet-50 py-3 text-sm font-black text-violet-700 disabled:opacity-50 dark:border-violet-500/25 dark:bg-violet-500/10 dark:text-violet-200">{testing ? <Loader2 size={17} className="animate-spin" /> : <HeartPulse size={17} />} Test Gemini Connection</button>
          </div>
        </section>

        <section className="rounded-[28px] border border-slate-200 bg-white p-5 dark:border-slate-700 dark:bg-slate-900 xl:col-span-2">
          <div className="flex items-center gap-3">
            <span className="grid h-11 w-11 place-items-center rounded-2xl bg-indigo-50 text-indigo-600 dark:bg-indigo-500/10 dark:text-indigo-300"><HardDrive size={19} /></span>
            <div><h3 className="font-black">Backup Policy</h3><p className="text-xs font-semibold text-slate-500">Automatic retention applies to generated backups.</p></div>
          </div>
          <label className="mt-4 block"><span className="mb-1.5 block text-xs font-black">Keep latest generated backups</span><input type="number" min={1} max={50} value={retention} onChange={(event) => setRetention(event.target.value)} className="w-full rounded-2xl border border-slate-200 px-4 py-3 text-sm font-bold dark:border-slate-700 dark:bg-slate-800" /></label>
        </section>
      </div>

      <section className="rounded-[28px] border border-indigo-200 bg-indigo-50 p-5 dark:border-indigo-500/25 dark:bg-indigo-500/10">
        <div className="grid items-end gap-4 md:grid-cols-[1fr_auto]">
          <div><span className="mb-1.5 block text-xs font-black text-indigo-800 dark:text-indigo-200">Confirm changes with your Main Admin password</span><PasswordInput value={password} onChange={setPassword} /></div>
          <button type="button" onClick={() => void saveSettings()} disabled={saving} className="inline-flex h-12 items-center justify-center gap-2 rounded-2xl bg-indigo-600 px-6 text-sm font-black text-white disabled:opacity-60">{saving ? <Loader2 size={17} className="animate-spin" /> : <Save size={17} />} Save Settings</button>
        </div>
      </section>
    </div>
  );
}

export function SystemHealthPanel() {
  const [health, setHealth] = useState<PlatformSystemHealth | null>(null);
  const [loading, setLoading] = useState(true);
  const [error, setError] = useState("");
  const load = async () => { setLoading(true); setError(""); try { setHealth(await getPlatformSystemHealth()); } catch (err: any) { setError(err?.message || "Could not load system health."); } finally { setLoading(false); } };
  useEffect(() => { void load(); }, []);
  if (loading) return <SpinnerCard label="Checking system health..." />;
  if (!health) return <Notice text={error || "System health is unavailable."} tone="danger" />;
  return <div className="space-y-5"><SectionHeader icon={HeartPulse} eyebrow="Read-only infrastructure status" title="System Health" subtitle="Review security, database, network, WebSocket, AI, and backup readiness without exposing secret values." actions={<button type="button" onClick={() => void load()} className="inline-flex h-11 items-center gap-2 rounded-2xl border border-slate-200 bg-white px-4 text-sm font-black dark:border-slate-700 dark:bg-slate-800"><RefreshCw size={17} /> Refresh</button>} /><Notice text={error} tone="danger" /><div className="grid gap-4 md:grid-cols-2 xl:grid-cols-3"><HealthCard icon={ShieldCheck} title="Security" ok={!health.environment.debug && health.environment.secret_key_configured} rows={[['Mode', health.environment.mode], ['Debug', health.environment.debug ? 'Enabled' : 'Disabled'], ['Secret key', health.environment.secret_key_configured ? 'Securely configured' : 'Needs attention'], ['Allowed hosts', health.environment.allowed_hosts.join(', ') || 'None']]} /><HealthCard icon={Database} title="Database" ok={health.database.connected} rows={[['Connection', health.database.connected ? 'Connected' : 'Unavailable'], ['Latency', health.database.latency_ms == null ? 'Unknown' : `${health.database.latency_ms} ms`], ['Database', health.database.name], ['Host', `${health.database.host}:${health.database.port}`], ['Username', health.database.username_masked]]} /><HealthCard icon={Globe2} title="Network" ok={health.network.cors_allowed_origins.length > 0} rows={[['API base', health.network.api_base_url], ['WebSocket base', health.network.websocket_base_url], ['CORS origins', String(health.network.cors_allowed_origins.length)]]} /><HealthCard icon={Server} title="WebSocket Layer" ok={health.channels.production_ready} rows={[['Mode', health.channels.mode], ['Production ready', health.channels.production_ready ? 'Yes' : 'Development only']]} /><HealthCard icon={Bot} title="Gemini AI" ok={health.gemini.configured} rows={[['Configured', health.gemini.configured ? 'Yes' : 'No'], ['Model', health.gemini.model], ['Key source', health.gemini.key_source]]} /><HealthCard icon={HardDrive} title="Backups" ok={health.backups.pg_dump_available && health.backups.pg_restore_available} rows={[['pg_dump', health.backups.pg_dump_available ? 'Available' : 'Missing'], ['pg_restore', health.backups.pg_restore_available ? 'Available' : 'Missing'], ['Stored backups', String(health.backups.backup_count)], ['Storage used', formatBytes(health.backups.total_size_bytes)]]} /></div><div className="grid gap-4 sm:grid-cols-2 lg:grid-cols-4">{[['Institutions', health.platform.institutions], ['Departments', health.platform.departments], ['All users', health.platform.users], ['Active users', health.platform.active_users]].map(([label, value]) => <div key={String(label)} className="rounded-[24px] border border-slate-200 bg-white p-5 dark:border-slate-700 dark:bg-slate-900"><div className="text-3xl font-black text-slate-950 dark:text-white">{value}</div><div className="mt-1 text-xs font-black uppercase tracking-[0.12em] text-slate-500">{label}</div></div>)}</div></div>;
}

function HealthCard({ icon: Icon, title, ok, rows }: { icon: React.ComponentType<{ size?: number }>; title: string; ok: boolean; rows: Array<[string, string]> }) {
  return <section className="rounded-[26px] border border-slate-200 bg-white p-5 dark:border-slate-700 dark:bg-slate-900"><div className="flex items-center justify-between gap-3"><div className="flex items-center gap-3"><span className="grid h-11 w-11 place-items-center rounded-2xl bg-slate-100 text-slate-700 dark:bg-slate-800 dark:text-slate-200"><Icon size={19} /></span><h3 className="font-black">{title}</h3></div>{ok ? <CheckCircle2 size={20} className="text-emerald-500" /> : <AlertTriangle size={20} className="text-amber-500" />}</div><div className="mt-4 space-y-2">{rows.map(([label, value]) => <div key={label} className="flex items-start justify-between gap-3 rounded-xl bg-slate-50 px-3 py-2 text-xs dark:bg-slate-800"><span className="font-semibold text-slate-500">{label}</span><strong className="max-w-[65%] break-words text-right text-slate-800 dark:text-slate-100">{value || 'Not configured'}</strong></div>)}</div></section>;
}

export function AuditLogsPanel() {
  const [logs, setLogs] = useState<PlatformAuditLog[]>([]);
  const [categories, setCategories] = useState<string[]>([]);
  const [pagination, setPagination] = useState({ page: 1, page_size: 30, total_items: 0, total_pages: 1 });
  const [search, setSearch] = useState("");
  const [category, setCategory] = useState("");
  const [loading, setLoading] = useState(true);
  const [error, setError] = useState("");
  const load = async (page = pagination.page) => { setLoading(true); setError(""); try { const response = await getPlatformAuditLogs({ search: search.trim() || undefined, category: category || undefined, page, page_size: 30 }); setLogs(response.logs || []); setCategories(response.categories || []); setPagination(response.pagination); } catch (err: any) { setError(err?.message || "Could not load audit logs."); } finally { setLoading(false); } };
  useEffect(() => { void load(1); }, [category]);
  return <div className="space-y-5"><SectionHeader icon={ShieldCheck} eyebrow="Security history" title="Audit Logs" subtitle="Review sensitive Main Admin activity. Passwords, API keys, and secret values are never written into log details." actions={<button type="button" onClick={() => void load()} className="inline-flex h-11 items-center gap-2 rounded-2xl border border-slate-200 bg-white px-4 text-sm font-black dark:border-slate-700 dark:bg-slate-800"><RefreshCw size={17} /> Refresh</button>} /><Notice text={error} tone="danger" /><div className="grid gap-3 rounded-[24px] border border-slate-200 bg-white p-4 dark:border-slate-700 dark:bg-slate-900 md:grid-cols-[1fr_220px_auto]"><label className="relative"><Search size={17} className="absolute left-3.5 top-1/2 -translate-y-1/2 text-slate-400" /><input value={search} onChange={(event) => setSearch(event.target.value)} onKeyDown={(event) => { if (event.key === 'Enter') void load(1); }} placeholder="Search action, administrator or target..." className="w-full rounded-2xl border border-slate-200 bg-slate-50 py-3 pl-10 pr-4 text-sm font-bold dark:border-slate-700 dark:bg-slate-800" /></label><select value={category} onChange={(event) => setCategory(event.target.value)} className="rounded-2xl border border-slate-200 bg-slate-50 px-4 py-3 text-sm font-bold dark:border-slate-700 dark:bg-slate-800"><option value="">All categories</option>{categories.map((item) => <option key={item} value={item}>{item.replace(/_/g, ' ')}</option>)}</select><button type="button" onClick={() => void load(1)} className="rounded-2xl bg-indigo-600 px-5 py-3 text-sm font-black text-white">Search</button></div>{loading ? <SpinnerCard label="Loading audit history..." /> : <div className="overflow-hidden rounded-[28px] border border-slate-200 bg-white dark:border-slate-700 dark:bg-slate-900">{logs.length === 0 ? <div className="p-12 text-center text-sm font-bold text-slate-500">No audit events match the filters.</div> : logs.map((item) => <div key={item.id} className="flex gap-4 border-b border-slate-200 p-5 last:border-b-0 dark:border-slate-700"><span className="mt-0.5 grid h-11 w-11 shrink-0 place-items-center rounded-2xl bg-indigo-50 text-indigo-600 dark:bg-indigo-500/10 dark:text-indigo-300"><ShieldCheck size={18} /></span><div className="min-w-0 flex-1"><div className="flex flex-wrap items-center gap-2"><h3 className="text-sm font-black text-slate-950 dark:text-white">{item.summary}</h3><span className="rounded-full bg-slate-100 px-2.5 py-1 text-[10px] font-black uppercase text-slate-500 dark:bg-slate-800 dark:text-slate-300">{item.category}</span></div><div className="mt-1 text-xs font-semibold text-slate-500">{item.actor?.full_name || 'System'} · @{item.actor?.username || 'system'} · {formatDate(item.created_at)}{item.ip_address ? ` · ${item.ip_address}` : ''}</div>{item.target_label && <div className="mt-2 text-xs font-bold text-slate-600 dark:text-slate-300">Target: {item.target_label}</div>}<details className="mt-2"><summary className="cursor-pointer text-xs font-black text-indigo-600 dark:text-indigo-300">Technical details</summary><pre className="mt-2 overflow-x-auto rounded-xl bg-slate-950 p-3 text-[11px] leading-5 text-slate-200">{JSON.stringify(item.details || {}, null, 2)}</pre></details></div></div>)}</div>}<div className="flex items-center justify-between rounded-[22px] border border-slate-200 bg-white px-4 py-3 dark:border-slate-700 dark:bg-slate-900"><span className="text-xs font-bold text-slate-500">{pagination.total_items} events · Page {pagination.page} of {pagination.total_pages}</span><div className="flex gap-2"><button type="button" disabled={pagination.page <= 1 || loading} onClick={() => void load(pagination.page - 1)} className="grid h-9 w-9 place-items-center rounded-xl border border-slate-200 disabled:opacity-40 dark:border-slate-700"><ChevronLeft size={17} /></button><button type="button" disabled={pagination.page >= pagination.total_pages || loading} onClick={() => void load(pagination.page + 1)} className="grid h-9 w-9 place-items-center rounded-xl border border-slate-200 disabled:opacity-40 dark:border-slate-700"><ChevronRight size={17} /></button></div></div></div>;
}

function formatTime(value: string) {
  const [hours, minutes] = String(value || "00:00").split(":").map(Number);
  if (!Number.isFinite(hours) || !Number.isFinite(minutes)) return value;
  const suffix = hours >= 12 ? "PM" : "AM";
  const hour = hours % 12 || 12;
  return `${hour}:${String(minutes).padStart(2, "0")} ${suffix}`;
}

function TuitionClock() {
  const [now, setNow] = useState(new Date());

  useEffect(() => {
    const timer = window.setInterval(() => setNow(new Date()), 1000);
    return () => window.clearInterval(timer);
  }, []);

  const hourDeg = ((now.getHours() % 12) + now.getMinutes() / 60) * 30;
  const minuteDeg = (now.getMinutes() + now.getSeconds() / 60) * 6;
  const secondDeg = now.getSeconds() * 6;

  return (
    <div className="flex items-center gap-3">
      <div className="relative h-[58px] w-[58px] shrink-0 rounded-full border border-white bg-gradient-to-br from-white to-slate-100 shadow-[0_10px_28px_rgba(15,23,42,0.10),inset_0_1px_0_rgba(255,255,255,0.95)]">
        <span className="absolute left-1/2 top-[3px] -translate-x-1/2 text-[7px] font-black text-slate-400">12</span>
        <span className="absolute right-[5px] top-1/2 -translate-y-1/2 text-[7px] font-black text-slate-400">3</span>
        <span className="absolute bottom-[3px] left-1/2 -translate-x-1/2 text-[7px] font-black text-slate-400">6</span>
        <span className="absolute left-[5px] top-1/2 -translate-y-1/2 text-[7px] font-black text-slate-400">9</span>

        <div
          className="absolute left-1/2 top-1/2 h-[16px] w-[3px] origin-bottom rounded-full bg-slate-800"
          style={{ transform: `translate(-50%, -100%) rotate(${hourDeg}deg)` }}
        />
        <div
          className="absolute left-1/2 top-1/2 h-[21px] w-[2px] origin-bottom rounded-full bg-indigo-600"
          style={{ transform: `translate(-50%, -100%) rotate(${minuteDeg}deg)` }}
        />
        <div
          className="absolute left-1/2 top-1/2 h-[23px] w-px origin-bottom rounded-full bg-rose-500"
          style={{ transform: `translate(-50%, -100%) rotate(${secondDeg}deg)` }}
        />
        <div className="absolute left-1/2 top-1/2 h-2 w-2 -translate-x-1/2 -translate-y-1/2 rounded-full border-2 border-white bg-indigo-600 shadow-sm" />
      </div>

      <div className="tuition-clock-copy min-w-[92px] leading-tight">
        <div className="tuition-clock-time text-sm font-black tabular-nums text-slate-950">
          {now.toLocaleTimeString([], {
            hour: "2-digit",
            minute: "2-digit",
            hour12: true,
          })}
        </div>
        <div className="tuition-clock-day mt-1 text-[10px] font-bold text-slate-500">
          {now.toLocaleDateString(undefined, { weekday: "long" })}
        </div>
        <div className="tuition-clock-date mt-0.5 text-[10px] font-bold text-slate-400">
          {now.toLocaleDateString(undefined, { month: "long", day: "2-digit" })}
        </div>
      </div>
    </div>
  );
}


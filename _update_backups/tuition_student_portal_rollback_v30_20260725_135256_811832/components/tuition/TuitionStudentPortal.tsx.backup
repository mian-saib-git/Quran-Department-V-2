type Tab = "overview" | "attendance" | "assignments" | "schedule";
type PeriodView = "all" | "daily" | "weekly" | "monthly" | "yearly";

type ScheduleTiming = {
  start: Date;
  end: Date;
  duration: number;
  diffMinutes: number;
  isLive: boolean;
  isUpcoming: boolean;
  isPast: boolean;
};

const PAGE_SIZE = 9;
const WEEKDAY_ORDER = [
  "sunday",
  "monday",
  "tuesday",
  "wednesday",
  "thursday",
  "friday",
  "saturday",
];

function localDateKey(date = new Date()) {
  const year = date.getFullYear();
  const month = String(date.getMonth() + 1).padStart(2, "0");
  const day = String(date.getDate()).padStart(2, "0");
  return `${year}-${month}-${day}`;
}

function formatDate(value: string) {
  if (!value) return "—";
  const parsed = new Date(`${value}T00:00:00`);
  if (Number.isNaN(parsed.getTime())) return value;
  return parsed.toLocaleDateString("en-US", {
    weekday: "short",
    month: "short",
    day: "numeric",
    year: "numeric",
  });
}

function formatTime(value: string) {
  const [hoursRaw, minutesRaw] = String(value || "").slice(0, 5).split(":");
  const hours = Number(hoursRaw);
  if (!Number.isFinite(hours) || minutesRaw === undefined) return value || "—";
  const suffix = hours >= 12 ? "PM" : "AM";
  const hour12 = hours % 12 || 12;
  return `${hour12}:${minutesRaw} ${suffix}`;
}

function getInitials(name: string) {
  return (
    String(name || "")
      .split(/\s+/)
      .filter(Boolean)
      .map((part) => part[0])
      .slice(0, 2)
      .join("")
      .toUpperCase() || "S"
  );
}

function getWeekRange(value: string) {
  const selected = new Date(`${value}T00:00:00`);
  const day = selected.getDay();
  const start = new Date(selected);
  start.setDate(selected.getDate() - day);
  const end = new Date(start);
  end.setDate(start.getDate() + 6);
  return { start: localDateKey(start), end: localDateKey(end) };
}

function paginate<T>(items: T[], page: number, size = PAGE_SIZE) {
  const totalPages = Math.max(1, Math.ceil(items.length / size));
  const safePage = Math.min(Math.max(1, page), totalPages);
  const start = (safePage - 1) * size;
  return {
    items: items.slice(start, start + size),
    safePage,
    totalPages,
  };
}

function statusLabel(status?: string) {
  if (status === "present") return "Present";
  if (status === "absent") return "Absent";
  if (status === "leave") return "Leave";
  return "Unmarked";
}

function statusClasses(status?: string) {
  if (status === "present") {
    return {
      badge: "bg-emerald-50 text-emerald-700 border-emerald-200",
      dot: "bg-emerald-500",
      card: "rounded-3xl border border-emerald-200 bg-emerald-50 px-5 py-4 text-emerald-800",
    };
  }
  if (status === "absent") {
    return {
      badge: "bg-rose-50 text-rose-700 border-rose-200",
      dot: "bg-rose-500",
      card: "rounded-3xl border border-rose-200 bg-rose-50 px-5 py-4 text-rose-800",
    };
  }
  if (status === "leave") {
    return {
      badge: "bg-amber-50 text-amber-700 border-amber-200",
      dot: "bg-amber-500",
      card: "rounded-3xl border border-amber-200 bg-amber-50 px-5 py-4 text-amber-800",
    };
  }
  return {
    badge: "bg-slate-50 text-slate-600 border-slate-200",
    dot: "bg-slate-400",
    card: "rounded-3xl border border-slate-200 bg-slate-50 px-5 py-4 text-slate-700",
  };
}

function zonedParts(date: Date, timeZone: string) {
  const formatter = new Intl.DateTimeFormat("en-US", {
    timeZone,
    year: "numeric",
    month: "2-digit",
    day: "2-digit",
    hour: "2-digit",
    minute: "2-digit",
    second: "2-digit",
    hourCycle: "h23",
    weekday: "long",
  });
  const parts = formatter.formatToParts(date);
  const get = (type: string) => parts.find((part) => part.type === type)?.value || "";
  return {
    year: Number(get("year")),
    month: Number(get("month")),
    day: Number(get("day")),
    hour: Number(get("hour")),
    minute: Number(get("minute")),
    second: Number(get("second")),
    weekday: get("weekday").toLowerCase(),
  };
}

function timeZoneOffsetMs(date: Date, timeZone: string) {
  const parts = zonedParts(date, timeZone);
  return Date.UTC(
    parts.year,
    parts.month - 1,
    parts.day,
    parts.hour,
    parts.minute,
    parts.second,
  ) - date.getTime();
}

function zonedLocalToUtc(
  year: number,
  month: number,
  day: number,
  hour: number,
  minute: number,
  timeZone: string,
) {
  const desired = Date.UTC(year, month - 1, day, hour, minute, 0, 0);
  let candidate = desired;
  for (let index = 0; index < 3; index += 1) {
    candidate = desired - timeZoneOffsetMs(new Date(candidate), timeZone);
  }
  return new Date(candidate);
}

function addUtcDays(date: Date, days: number) {
  const next = new Date(date);
  next.setUTCDate(next.getUTCDate() + days);
  return next;
}

function scheduleDuration(schedule: TuitionStudentPortalSchedule) {
  const [startHour, startMinute] = schedule.start_time.split(":").map(Number);
  const [endHour, endMinute] = schedule.end_time.split(":").map(Number);
  const start = (Number.isFinite(startHour) ? startHour : 0) * 60 + (Number.isFinite(startMinute) ? startMinute : 0);
  let end = (Number.isFinite(endHour) ? endHour : 0) * 60 + (Number.isFinite(endMinute) ? endMinute : 0);
  if (end <= start) end += 24 * 60;
  return Math.max(1, end - start);
}

function getScheduleTiming(schedule: TuitionStudentPortalSchedule, now = new Date()): ScheduleTiming {
  const timeZone = schedule.timezone_name || "Asia/Karachi";
  const nowParts = zonedParts(now, timeZone);
  const currentIndex = WEEKDAY_ORDER.indexOf(nowParts.weekday);
  const targetIndex = WEEKDAY_ORDER.indexOf(String(schedule.weekday || "").toLowerCase());
  const daysUntil = ((targetIndex < 0 ? currentIndex : targetIndex) - currentIndex + 7) % 7;
  const localBase = addUtcDays(new Date(Date.UTC(nowParts.year, nowParts.month - 1, nowParts.day)), daysUntil);
  const [hourRaw, minuteRaw] = schedule.start_time.split(":").map(Number);
  let start = zonedLocalToUtc(
    localBase.getUTCFullYear(),
    localBase.getUTCMonth() + 1,
    localBase.getUTCDate(),
    Number.isFinite(hourRaw) ? hourRaw : 0,
    Number.isFinite(minuteRaw) ? minuteRaw : 0,
    timeZone,
  );
  const duration = scheduleDuration(schedule);
  let end = new Date(start.getTime() + duration * 60_000);
  const previousStart = new Date(start.getTime() - 7 * 24 * 60 * 60_000);
  const previousEnd = new Date(previousStart.getTime() + duration * 60_000);

  if (now >= previousStart && now < previousEnd) {
    start = previousStart;
    end = previousEnd;
  } else if (now >= end) {
    start = new Date(start.getTime() + 7 * 24 * 60 * 60_000);
    end = new Date(start.getTime() + duration * 60_000);
  }

  const diffMinutes = Math.ceil((start.getTime() - now.getTime()) / 60_000);
  return {
    start,
    end,
    duration,
    diffMinutes,
    isLive: now >= start && now < end,
    isUpcoming: now < start,
    isPast: now >= end,
  };
}

function formatLocalClassTime(date: Date) {
  return date.toLocaleTimeString("en-US", {
    hour: "numeric",
    minute: "2-digit",
    hour12: true,
  });
}

function formatLocalClassDate(date: Date) {
  return date.toLocaleDateString("en-US", {
    weekday: "short",
    month: "short",
    day: "numeric",
  });
}

function countdownLabel(minutes: number) {
  if (minutes <= 1) return "Starting now";
  if (minutes < 60) return `${minutes} min`;
  const hours = Math.floor(minutes / 60);
  const remainder = minutes % 60;
  return remainder ? `${hours}h ${remainder}m` : `${hours}h`;
}

function clockAngles(now: Date) {
  const seconds = now.getSeconds();
  const minutes = now.getMinutes() + seconds / 60;
  const hours = (now.getHours() % 12) + minutes / 60;
  return {
    second: seconds * 6,
    minute: minutes * 6,
    hour: hours * 30,
  };
}


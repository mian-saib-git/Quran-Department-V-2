.lanyard-wrapper {
  position: relative;
  z-index: 0;
  width: 100%;
  height: 100%;
  min-height: 360px;
  overflow: hidden;
  border-radius: inherit;
  touch-action: none;
}

.lanyard-wrapper canvas {
  display: block;
  width: 100% !important;
  height: 100% !important;
}

.lanyard-help {
  position: absolute;
  left: 50%;
  bottom: 14px;
  transform: translateX(-50%);
  border: 1px solid rgba(255, 255, 255, 0.16);
  border-radius: 999px;
  background: rgba(15, 23, 42, 0.58);
  padding: 7px 12px;
  color: rgba(255, 255, 255, 0.82);
  font-size: 11px;
  font-weight: 700;
  letter-spacing: 0.01em;
  line-height: 1;
  white-space: nowrap;
  pointer-events: none;
  backdrop-filter: blur(10px);
}

@media (max-width: 767px) {
  .lanyard-wrapper {
    min-height: 330px;
  }

  .lanyard-help {
    bottom: 10px;
    font-size: 10px;
  }
}

@media (prefers-reduced-motion: reduce) {
  .lanyard-help {
    display: none;
  }
}

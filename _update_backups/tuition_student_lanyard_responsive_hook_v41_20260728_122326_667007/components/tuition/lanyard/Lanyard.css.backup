/* IVS_TUITION_STUDENT_PORTAL_V38_TOP_STRAP_DRAG_POLISH */
.lanyard-wrapper {
  position: absolute;
  inset: 0;
  z-index: 70;
  width: 100%;
  height: 100%;
  min-height: 100%;
  overflow: visible;
  pointer-events: none;
  touch-action: none;
  user-select: none;
  -webkit-user-select: none;
}

.lanyard-wrapper canvas {
  position: absolute;
  inset: 0;
  z-index: 2;
  display: block;
  width: 100% !important;
  height: 100% !important;
  overflow: visible;
  outline: none;
  pointer-events: none;
}

.tuition-overview-lanyard-layer {
  position: absolute;
  top: -104px;
  right: 0;
  bottom: 0;
  left: 0;
  min-height: calc(100% + 104px);
  z-index: 70;
  overflow: visible;
  pointer-events: none;
  isolation: isolate;
  user-select: none;
  -webkit-user-select: none;
}

body.lanyard-drag-active,
body.lanyard-drag-active * {
  user-select: none !important;
  -webkit-user-select: none !important;
  -webkit-touch-callout: none !important;
  cursor: grabbing !important;
}

@media (max-width: 1279px) {
  .tuition-overview-lanyard-layer {
    top: -84px;
    min-height: calc(100% + 84px);
  }
}

@media (max-width: 767px) {
  .tuition-overview-lanyard-layer {
    top: -48px;
    right: -10px;
    left: -10px;
    min-height: calc(100% + 48px);
  }
}

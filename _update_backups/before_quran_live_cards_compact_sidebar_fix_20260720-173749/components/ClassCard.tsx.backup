import React, { useMemo } from "react";
import { AttendanceRecord, AttendanceStatus, Student, Teacher } from "../types";
import { Check, X, Clock3, Minus } from "lucide-react";

type Props = {
  student: Student;
  teacher?: Teacher;
  attendanceToday?: AttendanceRecord;
  teacherAttendanceToday?: AttendanceRecord;
  onMarkAttendance: (studentId: string, status: AttendanceStatus) => void;
  onUnmarkAttendance: (studentId: string) => void;
  onMarkTeacherAttendance: (teacherId: string, status: AttendanceStatus) => void;
  onUnmarkTeacherAttendance: (teacherId: string) => void;
  isCurrentSession: boolean;
};

const formatTime12 = (time24: string): string => {
  const [h, m] = String(time24 || "").split(":");
  const hh = Number(h);
  if (!Number.isFinite(hh) || !m) return time24;
  const ampm = hh >= 12 ? "PM" : "AM";
  const h12 = hh % 12 || 12;
  return `${h12}:${m} ${ampm}`;
};

const daysToLabel = (days?: string[]) => {
  const count = days?.length ?? 0;
  if (!count) return "No class days";
  return `${count} day${count === 1 ? "" : "s"} / week`;
};

const minutesUntil = (time24: string) => {
  const [h, m] = String(time24 || "").split(":").map(Number);
  if (!Number.isFinite(h) || !Number.isFinite(m)) return null;
  const now = new Date();
  const target = new Date();
  target.setHours(h, m, 0, 0);
  return Math.round((target.getTime() - now.getTime()) / 60000);
};

function AttendanceButton({
  active,
  tone,
  icon,
  label,
  onClick,
}: {
  active: boolean;
  tone: "present" | "absent" | "leave" | "unmark";
  icon: React.ReactNode;
  label: string;
  onClick: () => void;
}) {
  const idle = {
    present:
      "border-emerald-200 bg-white text-emerald-700 hover:bg-emerald-50 dark:border-emerald-900/70 dark:bg-slate-900 dark:text-emerald-300",
    absent:
      "border-rose-200 bg-white text-rose-700 hover:bg-rose-50 dark:border-rose-900/70 dark:bg-slate-900 dark:text-rose-300",
    leave:
      "border-amber-200 bg-white text-amber-800 hover:bg-amber-50 dark:border-amber-900/70 dark:bg-slate-900 dark:text-amber-300",
    unmark:
      "border-slate-900 bg-slate-950 text-white hover:bg-slate-800 dark:border-slate-600 dark:bg-slate-100 dark:text-slate-950",
  } as const;

  const selected = {
    present: "border-emerald-500 bg-emerald-500 text-white",
    absent: "border-rose-500 bg-rose-500 text-white",
    leave: "border-amber-500 bg-amber-500 text-white",
    unmark: "border-slate-900 bg-slate-950 text-white",
  } as const;

  return (
    <button
      type="button"
      onClick={onClick}
      className={`inline-flex min-h-9 flex-1 items-center justify-center gap-1.5 rounded-xl border px-2.5 py-2 text-[11px] font-black transition-colors sm:min-h-10 sm:px-3 sm:text-xs ${
        active ? selected[tone] : idle[tone]
      }`}
    >
      {icon}
      <span>{label}</span>
    </button>
  );
}

function AttendancePanel({
  label,
  name,
  status,
  onSet,
  onClear,
}: {
  label: string;
  name: string;
  status: AttendanceStatus | null;
  onSet: (status: AttendanceStatus) => void;
  onClear: () => void;
}) {
  return (
    <div className="min-w-0 rounded-2xl border border-slate-200 bg-white p-3 shadow-sm dark:border-slate-700 dark:bg-slate-900">
      <div className="mb-2 flex items-start justify-between gap-2">
        <div className="min-w-0">
          <div className="text-[9px] font-black uppercase tracking-[0.12em] text-slate-400">
            {label}
          </div>
          <div className="truncate text-xs font-black text-slate-900 dark:text-white">{name}</div>
        </div>
        <span className="shrink-0 rounded-full bg-slate-100 px-2 py-1 text-[9px] font-black capitalize text-slate-600 dark:bg-slate-800 dark:text-slate-300">
          {status || "Unmarked"}
        </span>
      </div>

      <div className="grid grid-cols-2 gap-2 sm:flex">
        <AttendanceButton
          tone="present"
          active={status === AttendanceStatus.PRESENT}
          icon={<Check size={14} />}
          label="Present"
          onClick={() => onSet(AttendanceStatus.PRESENT)}
        />
        <AttendanceButton
          tone="absent"
          active={status === AttendanceStatus.ABSENT}
          icon={<X size={14} />}
          label="Absent"
          onClick={() => onSet(AttendanceStatus.ABSENT)}
        />
        <AttendanceButton
          tone="leave"
          active={status === AttendanceStatus.LEAVE}
          icon={<Clock3 size={14} />}
          label="Leave"
          onClick={() => onSet(AttendanceStatus.LEAVE)}
        />
        <AttendanceButton
          tone="unmark"
          active={!status}
          icon={<Minus size={14} />}
          label="Unmark"
          onClick={onClear}
        />
      </div>
    </div>
  );
}

export function ClassCard({
  student,
  teacher,
  attendanceToday,
  teacherAttendanceToday,
  onMarkAttendance,
  onUnmarkAttendance,
  onMarkTeacherAttendance,
  onUnmarkTeacherAttendance,
  isCurrentSession,
}: Props) {
  const timeLabel = useMemo(() => formatTime12(student.timeSlot), [student.timeSlot]);
  const studentStatus = attendanceToday?.status ?? null;
  const teacherStatus = teacherAttendanceToday?.status ?? null;
  const mins = useMemo(() => minutesUntil(student.timeSlot), [student.timeSlot]);
  const countdown = mins === null ? "Starts soon" : mins <= 0 ? "Starting" : `${mins} min`;

  return (
    <article
      className={`overflow-hidden rounded-2xl border bg-white shadow-[0_12px_30px_rgba(15,23,42,0.06)] dark:bg-slate-900 ${
        isCurrentSession
          ? "border-emerald-200 dark:border-emerald-900/70"
          : "border-indigo-200 dark:border-indigo-900/70"
      }`}
    >
      <div className="p-3 sm:p-4">
        <div className="flex items-start justify-between gap-3">
          <div className="min-w-0">
            <div className="flex flex-wrap items-center gap-2">
              <h4 className="truncate text-sm font-black text-slate-950 dark:text-white sm:text-base">
                {student.name}
              </h4>
              <span
                className={`rounded-full px-2.5 py-1 text-[9px] font-black uppercase tracking-wide ${
                  isCurrentSession
                    ? "bg-emerald-50 text-emerald-700 dark:bg-emerald-950/45 dark:text-emerald-300"
                    : "bg-indigo-50 text-indigo-700 dark:bg-indigo-950/45 dark:text-indigo-300"
                }`}
              >
                {isCurrentSession ? "Live" : "Up next"}
              </span>
            </div>
            <p className="mt-1 text-xs font-bold text-slate-600 dark:text-slate-400">
              With: <span className="text-slate-950 dark:text-slate-100">{teacher?.name ?? "—"}</span>
            </p>
          </div>

          <div className="inline-flex shrink-0 items-center gap-1.5 rounded-full border border-slate-200 bg-white px-3 py-1.5 text-[11px] font-black text-slate-700 shadow-sm dark:border-slate-700 dark:bg-slate-950 dark:text-slate-200">
            <Clock3 size={13} />
            <span className="whitespace-nowrap">{timeLabel}</span>
          </div>
        </div>

        <div className="mt-3 flex flex-wrap items-center gap-2">
          <span className="rounded-full bg-slate-100 px-3 py-1 text-[10px] font-black text-slate-600 dark:bg-slate-800 dark:text-slate-300">
            {daysToLabel(student.classDays)}
          </span>
          {!isCurrentSession && (
            <span className="inline-flex items-center gap-1.5 rounded-full border border-indigo-100 bg-indigo-50 px-3 py-1 text-[10px] font-black text-indigo-700 dark:border-indigo-900/70 dark:bg-indigo-950/40 dark:text-indigo-300">
              <span aria-hidden="true">⏳</span>
              {countdown}
            </span>
          )}
        </div>
      </div>

      {isCurrentSession && (
        <div className="border-t border-slate-100 bg-slate-50/75 p-3 dark:border-slate-800 dark:bg-slate-950/55 sm:p-4">
          <div className="mb-3 flex items-center justify-between gap-3">
            <div>
              <div className="text-xs font-black text-slate-900 dark:text-white">Live attendance</div>
              <div className="mt-0.5 text-[10px] font-semibold text-slate-500 dark:text-slate-400">
                Mark the student and teacher independently.
              </div>
            </div>
            <span className="inline-flex items-center gap-1 rounded-full border border-emerald-200 bg-emerald-50 px-2.5 py-1 text-[9px] font-black uppercase tracking-wide text-emerald-700 dark:border-emerald-900/70 dark:bg-emerald-950/40 dark:text-emerald-300">
              <span className="h-1.5 w-1.5 animate-pulse rounded-full bg-emerald-500" />
              Active
            </span>
          </div>

          <div className="grid gap-3 xl:grid-cols-2">
            <AttendancePanel
              label="Student"
              name={student.name}
              status={studentStatus}
              onSet={(status) => onMarkAttendance(student.id, status)}
              onClear={() => onUnmarkAttendance(student.id)}
            />
            <AttendancePanel
              label="Teacher"
              name={teacher?.name ?? "—"}
              status={teacherStatus}
              onSet={(status) => teacher && onMarkTeacherAttendance(teacher.id, status)}
              onClear={() => teacher && onUnmarkTeacherAttendance(teacher.id)}
            />
          </div>
        </div>
      )}
    </article>
  );
}

/* IVS_TUITION_STUDENT_PORTAL_V35_PREMIUM_ID_LANYARD */
.lanyard-wrapper {
  position: relative;
  z-index: 0;
  width: 100%;
  height: 100%;
  min-height: 500px;
  overflow: hidden;
  border-radius: inherit;
  touch-action: none;
  user-select: none;
}

.lanyard-wrapper::after {
  content: "";
  position: absolute;
  left: 50%;
  bottom: 22px;
  width: 150px;
  height: 24px;
  transform: translateX(-50%);
  border-radius: 999px;
  background: rgba(15, 23, 42, 0.16);
  filter: blur(14px);
  pointer-events: none;
}

.lanyard-wrapper canvas {
  position: relative;
  z-index: 1;
  display: block;
  width: 100% !important;
  height: 100% !important;
  outline: none;
}

@media (max-width: 767px) {
  .lanyard-wrapper {
    min-height: 470px;
  }

  .lanyard-wrapper::after {
    bottom: 18px;
    width: 128px;
  }
}

@media (prefers-reduced-motion: reduce) {
  .lanyard-wrapper::after {
    display: none;
  }
}

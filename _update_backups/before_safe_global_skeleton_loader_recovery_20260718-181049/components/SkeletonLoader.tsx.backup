import React from "react";

type SkeletonBlockProps = {
  className?: string;
  rounded?: string;
};

export function SkeletonBlock({
  className = "",
  rounded = "rounded-xl",
}: SkeletonBlockProps) {
  return <div aria-hidden="true" className={`ivs-skeleton ${rounded} ${className}`} />;
}

function LoadingStatus({ label }: { label: string }) {
  return <span className="sr-only">{label}</span>;
}

function SkeletonAvatar({ size = "h-11 w-11" }: { size?: string }) {
  return <SkeletonBlock className={`${size} shrink-0`} rounded="rounded-2xl" />;
}

function SkeletonLines({ compact = false }: { compact?: boolean }) {
  return (
    <div className="min-w-0 flex-1 space-y-2.5">
      <SkeletonBlock className={`${compact ? "h-3" : "h-3.5"} w-2/3`} />
      <SkeletonBlock className="h-2.5 w-2/5" />
    </div>
  );
}

export function TableSkeleton({
  rows = 7,
  columns = 6,
  className = "",
  showToolbar = false,
  label = "Loading table",
}: {
  rows?: number;
  columns?: number;
  className?: string;
  showToolbar?: boolean;
  label?: string;
}) {
  return (
    <div
      role="status"
      aria-live="polite"
      aria-busy="true"
      className={`ivs-skeleton-shell overflow-hidden rounded-[28px] border border-slate-200/80 bg-white shadow-[0_12px_32px_rgba(15,23,42,0.05)] dark:border-slate-700 dark:bg-slate-900 ${className}`}
    >
      <LoadingStatus label={label} />

      {showToolbar && (
        <div className="flex flex-col gap-4 border-b border-slate-200 p-5 sm:flex-row sm:items-center sm:justify-between dark:border-slate-700">
          <div className="flex gap-2">
            <SkeletonBlock className="h-10 w-28" rounded="rounded-2xl" />
            <SkeletonBlock className="h-10 w-24" rounded="rounded-2xl" />
          </div>
          <SkeletonBlock className="h-11 w-full sm:w-80" rounded="rounded-2xl" />
        </div>
      )}

      <div className="overflow-x-auto">
        <div
          className="grid min-w-[720px] gap-5 border-b border-slate-200 bg-slate-50/90 px-5 py-4 dark:border-slate-700 dark:bg-slate-800/65"
          style={{ gridTemplateColumns: `minmax(220px, 1.8fr) repeat(${Math.max(columns - 1, 1)}, minmax(90px, 1fr))` }}
        >
          {Array.from({ length: columns }).map((_, index) => (
            <SkeletonBlock key={`head-${index}`} className={`h-2.5 ${index === 0 ? "w-24" : "w-14"}`} />
          ))}
        </div>

        <div className="divide-y divide-slate-100 dark:divide-slate-800">
          {Array.from({ length: rows }).map((_, rowIndex) => (
            <div
              key={`row-${rowIndex}`}
              className="grid min-w-[720px] items-center gap-5 px-5 py-4"
              style={{ gridTemplateColumns: `minmax(220px, 1.8fr) repeat(${Math.max(columns - 1, 1)}, minmax(90px, 1fr))` }}
            >
              <div className="flex items-center gap-3">
                <SkeletonAvatar />
                <SkeletonLines compact />
              </div>
              {Array.from({ length: Math.max(columns - 1, 1) }).map((__, cellIndex) => (
                <SkeletonBlock
                  key={`cell-${rowIndex}-${cellIndex}`}
                  className={`h-3 ${cellIndex % 3 === 0 ? "w-20" : cellIndex % 3 === 1 ? "w-16" : "w-24"}`}
                />
              ))}
            </div>
          ))}
        </div>
      </div>
    </div>
  );
}

export function CardGridSkeleton({
  cards = 6,
  columns = "xl:grid-cols-2 2xl:grid-cols-3",
  className = "",
  label = "Loading cards",
}: {
  cards?: number;
  columns?: string;
  className?: string;
  label?: string;
}) {
  return (
    <div role="status" aria-live="polite" aria-busy="true" className={`ivs-skeleton-shell grid grid-cols-1 gap-4 ${columns} ${className}`}>
      <LoadingStatus label={label} />
      {Array.from({ length: cards }).map((_, index) => (
        <article
          key={`card-${index}`}
          className="rounded-[24px] border border-slate-200/80 bg-white p-4 shadow-[0_12px_32px_rgba(15,23,42,0.05)] dark:border-slate-700 dark:bg-slate-900"
        >
          <div className="flex items-start justify-between gap-4">
            <div className="flex min-w-0 flex-1 items-center gap-3">
              <SkeletonAvatar />
              <SkeletonLines />
            </div>
            <SkeletonBlock className="h-6 w-20" rounded="rounded-full" />
          </div>
          <SkeletonBlock className="mt-4 h-10 w-full" rounded="rounded-xl" />
          <div className="mt-4 grid grid-cols-2 gap-3">
            <SkeletonBlock className="h-14 w-full" rounded="rounded-2xl" />
            <SkeletonBlock className="h-14 w-full" rounded="rounded-2xl" />
          </div>
          <div className="mt-4 flex gap-2">
            <SkeletonBlock className="h-9 flex-1" rounded="rounded-xl" />
            <SkeletonBlock className="h-9 w-20" rounded="rounded-xl" />
          </div>
        </article>
      ))}
    </div>
  );
}

export function ListSkeleton({
  items = 5,
  className = "",
  label = "Loading list",
}: {
  items?: number;
  className?: string;
  label?: string;
}) {
  return (
    <div role="status" aria-live="polite" aria-busy="true" className={`ivs-skeleton-shell space-y-3 ${className}`}>
      <LoadingStatus label={label} />
      {Array.from({ length: items }).map((_, index) => (
        <div key={`list-${index}`} className="rounded-3xl border border-slate-200 bg-slate-50/70 p-4 dark:border-slate-700 dark:bg-slate-800/60">
          <div className="flex items-start justify-between gap-4">
            <div className="min-w-0 flex-1 space-y-2.5">
              <SkeletonBlock className="h-3.5 w-1/2" />
              <SkeletonBlock className="h-2.5 w-1/3" />
              <SkeletonBlock className="h-6 w-20" rounded="rounded-full" />
            </div>
            <SkeletonBlock className="h-9 w-9" rounded="rounded-xl" />
          </div>
        </div>
      ))}
    </div>
  );
}

export function AccountsSkeleton({
  rows = 7,
  label = "Loading accounts",
  className = "",
}: {
  rows?: number;
  label?: string;
  className?: string;
}) {
  return <TableSkeleton rows={rows} columns={6} label={label} className={className} />;
}

export function LessonsSkeleton({
  cards = 6,
  label = "Loading lessons",
}: {
  cards?: number;
  label?: string;
}) {
  return (
    <div role="status" aria-live="polite" aria-busy="true" className="ivs-skeleton-shell p-5">
      <LoadingStatus label={label} />
      <div className="grid grid-cols-1 gap-4 xl:grid-cols-2">
        {Array.from({ length: cards }).map((_, index) => (
          <article key={`lesson-${index}`} className="rounded-[26px] border border-slate-200 bg-white p-5 dark:border-slate-700 dark:bg-slate-900">
            <div className="flex items-center gap-3">
              <SkeletonAvatar size="h-12 w-12" />
              <SkeletonLines />
              <SkeletonBlock className="h-7 w-20" rounded="rounded-full" />
            </div>
            <div className="mt-5 grid grid-cols-2 gap-3 sm:grid-cols-3">
              {Array.from({ length: 6 }).map((__, cellIndex) => (
                <SkeletonBlock key={`lesson-cell-${index}-${cellIndex}`} className="h-14 w-full" rounded="rounded-2xl" />
              ))}
            </div>
            <div className="mt-4 flex gap-2">
              <SkeletonBlock className="h-10 flex-1" rounded="rounded-xl" />
              <SkeletonBlock className="h-10 w-24" rounded="rounded-xl" />
            </div>
          </article>
        ))}
      </div>
    </div>
  );
}

export function LessonPlansSkeleton({ label = "Loading lesson plans" }: { label?: string }) {
  return (
    <div role="status" aria-live="polite" aria-busy="true" className="ivs-skeleton-shell space-y-4 p-5">
      <LoadingStatus label={label} />
      {Array.from({ length: 4 }).map((_, index) => (
        <div key={`plan-${index}`} className="rounded-[26px] border border-slate-200 bg-white p-5 dark:border-slate-700 dark:bg-slate-900">
          <div className="flex flex-col gap-4 sm:flex-row sm:items-center sm:justify-between">
            <div className="flex min-w-0 flex-1 items-center gap-3">
              <SkeletonAvatar size="h-12 w-12" />
              <SkeletonLines />
            </div>
            <SkeletonBlock className="h-9 w-28" rounded="rounded-full" />
          </div>
          <div className="mt-5 grid grid-cols-2 gap-3 md:grid-cols-4">
            {Array.from({ length: 4 }).map((__, itemIndex) => (
              <SkeletonBlock key={`plan-stat-${index}-${itemIndex}`} className="h-16 w-full" rounded="rounded-2xl" />
            ))}
          </div>
        </div>
      ))}
    </div>
  );
}

export function SettingsSkeleton({
  groups = 6,
  label = "Loading settings",
}: {
  groups?: number;
  label?: string;
}) {
  return (
    <div role="status" aria-live="polite" aria-busy="true" className="ivs-skeleton-shell space-y-4">
      <LoadingStatus label={label} />
      {Array.from({ length: groups }).map((_, index) => (
        <div key={`setting-${index}`} className="rounded-3xl border border-slate-200 bg-white p-4 dark:border-slate-700 dark:bg-slate-900">
          <div className="flex items-center gap-4">
            <SkeletonBlock className="h-11 w-11 shrink-0" rounded="rounded-2xl" />
            <div className="min-w-0 flex-1 space-y-2.5">
              <SkeletonBlock className="h-3.5 w-2/5" />
              <SkeletonBlock className="h-2.5 w-3/5" />
            </div>
            <SkeletonBlock className="h-7 w-12" rounded="rounded-full" />
          </div>
        </div>
      ))}
    </div>
  );
}

export function TabSkeleton({ label = "Loading page" }: { label?: string }) {
  return (
    <div role="status" aria-live="polite" aria-busy="true" className="ivs-skeleton-shell min-h-[420px] w-full space-y-5 p-1 sm:p-2">
      <LoadingStatus label={label} />
      <div className="rounded-[30px] border border-slate-200/80 bg-white/90 p-5 shadow-[0_18px_55px_rgba(15,23,42,0.06)] dark:border-slate-700 dark:bg-slate-900/90">
        <div className="flex flex-col gap-4 sm:flex-row sm:items-center sm:justify-between">
          <div className="space-y-3">
            <SkeletonBlock className="h-6 w-52" />
            <SkeletonBlock className="h-3 w-72 max-w-full" />
          </div>
          <div className="flex gap-2">
            <SkeletonBlock className="h-11 w-28" rounded="rounded-2xl" />
            <SkeletonBlock className="h-11 w-11" rounded="rounded-2xl" />
          </div>
        </div>
      </div>

      <div className="grid grid-cols-2 gap-4 lg:grid-cols-4">
        {Array.from({ length: 4 }).map((_, index) => (
          <div key={`metric-${index}`} className="rounded-[24px] border border-slate-200/80 bg-white p-4 dark:border-slate-700 dark:bg-slate-900">
            <SkeletonBlock className="h-3 w-20" />
            <SkeletonBlock className="mt-4 h-8 w-16" />
            <SkeletonBlock className="mt-3 h-2.5 w-28 max-w-full" />
          </div>
        ))}
      </div>

      <TableSkeleton rows={6} columns={5} />
    </div>
  );
}

export function PortalSkeleton({ label = "Loading portal" }: { label?: string }) {
  return (
    <div role="status" aria-live="polite" aria-busy="true" className="ivs-skeleton-shell min-h-screen bg-slate-50 p-4 dark:bg-slate-950 sm:p-6 lg:p-8">
      <LoadingStatus label={label} />
      <div className="mx-auto max-w-[1500px] space-y-5">
        <div className="rounded-[30px] border border-slate-200 bg-white p-5 shadow-[0_18px_55px_rgba(15,23,42,0.06)] dark:border-slate-700 dark:bg-slate-900">
          <div className="flex items-center justify-between gap-4">
            <div className="flex min-w-0 items-center gap-4">
              <SkeletonAvatar size="h-14 w-14" />
              <div className="min-w-0 space-y-3">
                <SkeletonBlock className="h-5 w-52 max-w-full" />
                <SkeletonBlock className="h-3 w-72 max-w-full" />
              </div>
            </div>
            <SkeletonBlock className="h-11 w-28" rounded="rounded-2xl" />
          </div>
        </div>

        <div className="grid grid-cols-2 gap-4 lg:grid-cols-4">
          {Array.from({ length: 4 }).map((_, index) => (
            <div key={`portal-stat-${index}`} className="rounded-[24px] border border-slate-200 bg-white p-4 dark:border-slate-700 dark:bg-slate-900">
              <SkeletonBlock className="h-3 w-20" />
              <SkeletonBlock className="mt-4 h-8 w-14" />
              <SkeletonBlock className="mt-3 h-2.5 w-24" />
            </div>
          ))}
        </div>

        <div className="grid grid-cols-1 gap-5 xl:grid-cols-[1.5fr_0.8fr]">
          <TableSkeleton rows={6} columns={4} />
          <div className="space-y-4 rounded-[28px] border border-slate-200 bg-white p-5 dark:border-slate-700 dark:bg-slate-900">
            <SkeletonBlock className="h-5 w-36" />
            {Array.from({ length: 5 }).map((_, index) => (
              <div key={`portal-side-${index}`} className="flex items-center gap-3 rounded-2xl bg-slate-50 p-3 dark:bg-slate-800/60">
                <SkeletonAvatar size="h-10 w-10" />
                <SkeletonLines compact />
              </div>
            ))}
          </div>
        </div>
      </div>
    </div>
  );
}

export function WorkspaceSkeleton({ label = "Loading workspace" }: { label?: string }) {
  return (
    <div role="status" aria-live="polite" aria-busy="true" className="ivs-skeleton-shell flex min-h-screen bg-slate-50 dark:bg-slate-950">
      <LoadingStatus label={label} />
      <aside className="hidden w-72 shrink-0 border-r border-slate-200 bg-white p-5 dark:border-slate-800 dark:bg-slate-900 lg:block">
        <div className="flex items-center gap-3">
          <SkeletonBlock className="h-12 w-12" rounded="rounded-2xl" />
          <div className="flex-1 space-y-2.5">
            <SkeletonBlock className="h-4 w-32" />
            <SkeletonBlock className="h-2.5 w-20" />
          </div>
        </div>
        <div className="mt-10 space-y-3">
          {Array.from({ length: 7 }).map((_, index) => (
            <div key={`nav-${index}`} className="flex items-center gap-3 rounded-2xl px-3 py-3">
              <SkeletonBlock className="h-9 w-9" rounded="rounded-xl" />
              <SkeletonBlock className={`h-3 ${index % 2 === 0 ? "w-28" : "w-36"}`} />
            </div>
          ))}
        </div>
      </aside>

      <main className="min-w-0 flex-1 p-4 sm:p-6 lg:p-8">
        <TabSkeleton label={label} />
      </main>
    </div>
  );
}

export function CompactPanelSkeleton({
  rows = 4,
  label = "Loading panel",
}: {
  rows?: number;
  label?: string;
}) {
  return (
    <div role="status" aria-live="polite" aria-busy="true" className="ivs-skeleton-shell space-y-3 rounded-[24px] border border-slate-200 bg-white p-4 dark:border-slate-700 dark:bg-slate-900">
      <LoadingStatus label={label} />
      {Array.from({ length: rows }).map((_, index) => (
        <div key={`compact-${index}`} className="flex items-center gap-3 rounded-2xl bg-slate-50 p-3 dark:bg-slate-800/60">
          <SkeletonAvatar size="h-10 w-10" />
          <SkeletonLines compact />
          <SkeletonBlock className="h-7 w-16" rounded="rounded-full" />
        </div>
      ))}
    </div>
  );
}

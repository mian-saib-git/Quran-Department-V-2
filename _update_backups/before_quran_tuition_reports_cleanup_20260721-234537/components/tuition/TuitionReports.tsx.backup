// TUITION_REPORT_COMPLETED_OCCURRENCE_V1
function tuitionReportLocalDateKey(value: Date): string {
  const year = value.getFullYear();
  const month = String(value.getMonth() + 1).padStart(2, "0");
  const day = String(value.getDate()).padStart(2, "0");
  return `${year}-${month}-${day}`;
}

function tuitionReportClockMinutes(value: unknown): number | null {
  const text = String(value ?? "").trim();
  if (!text) return null;

  const twelveHour = text.match(
    /^(\d{1,2}):(\d{2})(?::\d{2})?\s*([ap]m)$/i,
  );
  if (twelveHour) {
    let hour = Number(twelveHour[1]);
    const minute = Number(twelveHour[2]);
    const suffix = twelveHour[3].toLowerCase();

    if (!Number.isFinite(hour) || !Number.isFinite(minute)) return null;
    if (hour === 12) hour = 0;
    if (suffix === "pm") hour += 12;
    return hour * 60 + minute;
  }

  const twentyFourHour = text.match(/^(\d{1,2}):(\d{2})(?::\d{2})?$/);
  if (!twentyFourHour) return null;

  const hour = Number(twentyFourHour[1]);
  const minute = Number(twentyFourHour[2]);
  if (
    !Number.isFinite(hour) ||
    !Number.isFinite(minute) ||
    hour < 0 ||
    hour > 23 ||
    minute < 0 ||
    minute > 59
  ) {
    return null;
  }

  return hour * 60 + minute;
}

function tuitionReportScheduleEndMinutes(schedule: unknown): number | null {
  const row = (schedule ?? {}) as Record<string, any>;
  const slot =
    (row.slot ??
      row.time_slot ??
      row.timeSlot ??
      row.standard_slot ??
      row.standardSlot ??
      {}) as Record<string, any>;
  const enrollment = (row.enrollment ?? {}) as Record<string, any>;

  const explicitEnd =
    row.end_time ??
    row.endTime ??
    row.slot_end_time ??
    row.slotEndTime ??
    row.time_slot_end ??
    row.timeSlotEnd ??
    slot.end_time ??
    slot.endTime ??
    enrollment.end_time ??
    enrollment.endTime;

  const parsedEnd = tuitionReportClockMinutes(explicitEnd);
  if (parsedEnd !== null) return parsedEnd;

  const start = tuitionReportClockMinutes(
    row.start_time ??
      row.startTime ??
      row.slot_start_time ??
      row.slotStartTime ??
      slot.start_time ??
      slot.startTime ??
      enrollment.start_time ??
      enrollment.startTime,
  );

  if (start === null) return null;

  const durationCandidate = Number(
    row.duration_minutes ??
      row.durationMinutes ??
      slot.duration_minutes ??
      slot.durationMinutes ??
      enrollment.duration_minutes ??
      enrollment.durationMinutes ??
      40,
  );

  const duration =
    Number.isFinite(durationCandidate) && durationCandidate > 0
      ? durationCandidate
      : 40;

  return start + duration;
}

function tuitionReportOccurrenceCompleted(
  schedule: unknown,
  attendanceDate: string,
): boolean {
  const now = new Date();
  const today = tuitionReportLocalDateKey(now);

  if (attendanceDate < today) return true;
  if (attendanceDate > today) return false;

  const endMinutes = tuitionReportScheduleEndMinutes(schedule);

  // Strict behavior for today's report: if the end time cannot be identified,
  // do not create a premature Unmarked row.
  if (endMinutes === null) return false;

  const currentMinutes =
    now.getHours() * 60 + now.getMinutes() + now.getSeconds() / 60;

  return currentMinutes >= endMinutes;
}

function tuitionReportDateOnly(value: unknown): string {
  const text = String(value ?? "").trim();
  const match = text.match(/^\d{4}-\d{2}-\d{2}/);
  return match?.[0] ?? "";
}

function tuitionAttendanceOccurrenceAllowed(
  schedule: unknown,
  attendanceDate: string,
): boolean {
  const row = (schedule ?? {}) as Record<string, any>;
  const enrollment = (row.enrollment ?? {}) as Record<string, any>;

  const startCandidates = [
    row.enrollment_start_date,
    row.enrollmentStartDate,
    enrollment.start_date,
    enrollment.startDate,
    row.enrollment_created_at,
    row.enrollmentCreatedAt,
    enrollment.created_at,
    enrollment.createdAt,
  ]
    .map(tuitionReportDateOnly)
    .filter(Boolean)
    .sort();

  // Never create expected attendance before either the declared start date
  // or the day the enrollment was actually created.
  const effectiveStart = startCandidates.at(-1) ?? "";
  const effectiveEnd = tuitionReportDateOnly(
    row.enrollment_end_date ??
      row.enrollmentEndDate ??
      enrollment.end_date ??
      enrollment.endDate,
  );

  if (effectiveStart && attendanceDate < effectiveStart) return false;
  if (effectiveEnd && attendanceDate > effectiveEnd) return false;
  return true;
}


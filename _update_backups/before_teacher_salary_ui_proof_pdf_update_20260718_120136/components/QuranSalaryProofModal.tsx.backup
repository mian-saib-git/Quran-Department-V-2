import React, { useEffect, useMemo, useState } from "react";
import {
  CalendarDays,
  CheckCircle2,
  CircleDollarSign,
  Database,
  Loader2,
  ShieldCheck,
  X,
  XCircle,
} from "lucide-react";

import {
  getQuranSalaryAudit,
  type QuranSalaryAuditResponse,
} from "../services/djangoApiService";

const STATUS_STYLE: Record<string, string> = {
  present: "bg-emerald-100 text-emerald-700",
  absent: "bg-rose-100 text-rose-700",
  leave: "bg-amber-100 text-amber-700",
  not_marked: "bg-slate-100 text-slate-400",
};

function formatDate(value: string) {
  const parsed = new Date(`${value}T00:00:00`);
  if (Number.isNaN(parsed.getTime())) return value;
  return parsed.toLocaleDateString(undefined, { day: "2-digit", month: "short" });
}

function formatTime12(value: string) {
  const match = String(value || "").match(/^(\d{1,2}):(\d{2})/);
  if (!match) return value;
  const hour = Number(match[1]);
  const suffix = hour >= 12 ? "PM" : "AM";
  return `${String(hour % 12 || 12).padStart(2, "0")}:${match[2]} ${suffix}`;
}

function proofDescription(metric: string, label: string) {
  if (metric === "achievement_points") {
    return "Only the achievement criteria used for this teacher and month are shown below.";
  }
  if (metric === "source_records") {
    return "Complete student source records for this teacher and month, including schedules, status, and attendance.";
  }
  if (metric === "attendance") {
    return "Only students included in the monthly attendance calculation are shown below.";
  }
  if (metric === "lesson_filled") {
    return "Each salary-running student is checked against attendance. Lesson dates must exactly match the dates marked Present. The automatic bonus is awarded only after month end when every student passes this reconciliation.";
  }
  return `Only records that qualify for “${label}” are shown below. No unrelated calculation or point data is included.`;
}

export default function QuranSalaryProofModal({
  teacherId,
  metric,
  month,
  year,
  onClose,
}: {
  teacherId: number;
  metric: string;
  month: number;
  year: number;
  onClose: () => void;
}) {
  const [data, setData] = useState<QuranSalaryAuditResponse | null>(null);
  const [loading, setLoading] = useState(true);
  const [message, setMessage] = useState("");
  const [expanded, setExpanded] = useState<number | null>(null);

  useEffect(() => {
    let active = true;
    setLoading(true);
    setMessage("");
    setData(null);
    getQuranSalaryAudit({ teacher_id: teacherId, metric, month, year })
      .then((response) => {
        if (active) setData(response);
      })
      .catch((error: any) => {
        if (active) setMessage(error?.message || "Could not load proof records.");
      })
      .finally(() => {
        if (active) setLoading(false);
      });
    return () => {
      active = false;
    };
  }, [teacherId, metric, month, year]);

  const awardedPoints = useMemo(
    () => (data?.achievement_point_proofs || []).filter((row: any) => row.awarded),
    [data]
  );

  return (
    <div className="fixed inset-0 z-[140] flex items-end justify-center bg-slate-950/60 p-0 backdrop-blur-sm sm:items-center sm:p-4">
      <div className="flex max-h-[94vh] w-full flex-col overflow-hidden rounded-t-[30px] border border-white/70 bg-slate-50 shadow-2xl sm:max-w-6xl sm:rounded-[32px]">
        <div className="shrink-0 border-b border-slate-200 bg-white/95 p-5 backdrop-blur-xl sm:p-6">
          <div className="flex items-start justify-between gap-4">
            <div className="min-w-0">
              <div className="text-[10px] font-black uppercase tracking-[0.16em] text-indigo-600">Focused salary proof</div>
              <h3 className="mt-1 break-words text-xl font-black text-slate-950 sm:text-2xl">
                {data?.label || "Salary Proof"}
              </h3>
              <p className="mt-1 text-sm font-semibold text-slate-500">
                {data ? `${data.teacher.name} · ${new Date(year, month - 1, 1).toLocaleDateString(undefined, { month: "long", year: "numeric" })}` : "Loading selected proof..."}
              </p>
            </div>
            <button type="button" onClick={onClose} className="flex h-11 w-11 shrink-0 items-center justify-center rounded-2xl border border-slate-200 bg-white text-slate-500">
              <X size={20} />
            </button>
          </div>
        </div>

        <div className="min-h-0 flex-1 overflow-y-auto p-4 sm:p-6">
          {loading && (
            <div className="flex min-h-[300px] items-center justify-center rounded-[26px] border border-slate-200 bg-white text-sm font-bold text-slate-500">
              <Loader2 className="mr-2 animate-spin" size={18} /> Loading selected proof...
            </div>
          )}

          {!loading && message && (
            <div className="rounded-[24px] border border-rose-200 bg-rose-50 p-5 text-sm font-bold text-rose-700">{message}</div>
          )}

          {!loading && data && (
            <div className="space-y-4">
              <section className="rounded-[24px] border border-indigo-100 bg-indigo-50/70 p-4 sm:p-5">
                <div className="flex flex-col gap-3 sm:flex-row sm:items-center sm:justify-between">
                  <div className="flex items-start gap-3">
                    <div className="flex h-11 w-11 shrink-0 items-center justify-center rounded-2xl bg-white text-indigo-600 shadow-sm">
                      {metric === "source_records" ? <Database size={20} /> : <ShieldCheck size={20} />}
                    </div>
                    <div>
                      <div className="font-black text-slate-950">Verified result for this button</div>
                      <p className="mt-1 text-xs font-semibold leading-relaxed text-slate-600">{proofDescription(metric, data.label)}</p>
                    </div>
                  </div>
                  <div className="rounded-2xl bg-slate-950 px-4 py-3 text-center text-white">
                    <div className="text-[9px] font-black uppercase tracking-wider text-slate-400">{metric === "lesson_filled" ? "Students with lesson logs" : "Verified count"}</div>
                    <div className="text-2xl font-black">{data.count}</div>
                  </div>
                </div>
              </section>

              {metric === "achievement_points" ? (
                <section className="rounded-[26px] border border-violet-200 bg-violet-50/50 p-4 sm:p-5">
                  <div className="flex flex-col gap-3 sm:flex-row sm:items-center sm:justify-between">
                    <div>
                      <h4 className="font-black text-violet-950">Achievement points earned</h4>
                      <p className="mt-1 text-xs font-semibold text-violet-700">Each row shows the exact actual value and the required rule.</p>
                    </div>
                    <div className="rounded-2xl bg-violet-600 px-4 py-2 text-center text-white">
                      <div className="text-[9px] font-black uppercase">Points</div>
                      <div className="text-xl font-black">{data.achievement_points || 0}/10</div>
                    </div>
                  </div>
                  <div className="mt-4 grid grid-cols-1 gap-2 md:grid-cols-2">
                    {(data.achievement_point_proofs || []).map((row: any) => (
                      <article key={row.key} className={`rounded-2xl border p-3 ${row.awarded ? "border-emerald-200 bg-white" : "border-slate-200 bg-slate-100/70"}`}>
                        <div className="flex items-start justify-between gap-3">
                          <div className="flex min-w-0 items-start gap-2">
                            {row.awarded ? <CheckCircle2 size={18} className="mt-0.5 shrink-0 text-emerald-600" /> : <XCircle size={18} className="mt-0.5 shrink-0 text-slate-400" />}
                            <div className="min-w-0">
                              <div className="font-black text-slate-900">{row.label}</div>
                              <div className="mt-1 text-xs font-bold text-slate-500">Actual: {String(row.actual)} · Rule: {row.rule}</div>
                            </div>
                          </div>
                          <span className={`shrink-0 rounded-full px-2.5 py-1 text-xs font-black ${row.awarded ? "bg-emerald-600 text-white" : "bg-slate-200 text-slate-500"}`}>
                            {row.awarded ? "+" : ""}{row.points} pt{row.points === 1 ? "" : "s"}
                          </span>
                        </div>
                      </article>
                    ))}
                  </div>
                  <div className="mt-3 text-xs font-bold text-slate-500">Awarded criteria: {awardedPoints.length} of {(data.achievement_point_proofs || []).length}</div>
                </section>
              ) : data.rows.length === 0 ? (
                <div className="rounded-[26px] border border-slate-200 bg-white p-10 text-center text-sm font-bold text-slate-500">
                  No student records match this selected proof for the chosen month.
                </div>
              ) : (
                <section className="space-y-3">
                  <div className="flex items-center gap-2 px-1 font-black text-slate-950">
                    <CircleDollarSign size={18} className="text-emerald-600" /> Matching student records only
                  </div>
                  {data.rows.map((row) => {
                    const open = expanded === row.student_id;
                    return (
                      <article key={row.student_id} className="overflow-hidden rounded-[24px] border border-slate-200 bg-white shadow-[0_12px_30px_rgba(15,23,42,0.05)]">
                        <button type="button" onClick={() => setExpanded(open ? null : row.student_id)} className="grid w-full grid-cols-1 gap-3 p-4 text-left sm:grid-cols-[minmax(0,1.2fr)_minmax(0,1fr)_auto] sm:items-center">
                          <div className="min-w-0">
                            <div className="break-words font-black text-slate-950">{row.student_name}</div>
                            <div className="mt-1 break-all text-xs font-bold text-slate-500">@{row.username} · Joined {row.enrollment_date}</div>
                          </div>
                          <div className="flex flex-wrap gap-2 text-[11px] font-black">
                            <span className="rounded-full bg-indigo-50 px-3 py-1.5 text-indigo-700">{row.student_type_label}</span>
                            <span className="rounded-full bg-emerald-50 px-3 py-1.5 text-emerald-700">{row.class_status_label}</span>
                            <span className="rounded-full bg-cyan-50 px-3 py-1.5 text-cyan-700">{row.active_sessions}/{row.full_month_sessions} sessions</span>
                            {metric === "lesson_filled" && row.lesson_summary && <span className={`rounded-full px-3 py-1.5 ${row.lesson_summary.completed ? "bg-emerald-100 text-emerald-700" : row.lesson_summary.started ? "bg-amber-100 text-amber-700" : "bg-slate-100 text-slate-500"}`}>{row.lesson_summary.completed ? "Present days matched" : row.lesson_summary.started ? "Lesson matching incomplete" : "No lesson logged"}</span>}
                          </div>
                          <span className="text-xs font-black text-indigo-600">{open ? "Hide logs" : "View logs"}</span>
                        </button>

                        {open && (
                          <div className="border-t border-slate-200 bg-slate-50/70 p-4">
                            <div className="grid grid-cols-2 gap-2 sm:grid-cols-4">
                              <div className="rounded-2xl bg-white p-3 text-xs font-bold text-slate-600"><b className="block text-base text-emerald-600">{row.attendance_summary.present}</b>Present</div>
                              <div className="rounded-2xl bg-white p-3 text-xs font-bold text-slate-600"><b className="block text-base text-rose-600">{row.attendance_summary.absent}</b>Absent</div>
                              <div className="rounded-2xl bg-white p-3 text-xs font-bold text-slate-600"><b className="block text-base text-amber-600">{row.attendance_summary.leave}</b>Leave</div>
                              <div className="rounded-2xl bg-white p-3 text-xs font-bold text-slate-600"><b className="block text-base text-indigo-600">{row.attendance_summary.marked}</b>Marked days</div>
                            </div>

                            {metric === "lesson_filled" && row.lesson_summary && (
                              <>
                              <div className="mt-3 grid grid-cols-2 gap-2 lg:grid-cols-5">
                                <div className="rounded-2xl border border-indigo-100 bg-indigo-50 p-3 text-xs font-bold text-indigo-700"><b className="block text-lg text-indigo-950">{row.lesson_summary.report_count}</b>Lesson-written days</div>
                                <div className="rounded-2xl border border-cyan-100 bg-cyan-50 p-3 text-xs font-bold text-cyan-700"><b className="block text-lg text-cyan-950">{row.lesson_summary.present_sessions ?? row.lesson_summary.expected_sessions}</b>Present attendance days</div>
                                <div className="rounded-2xl border border-emerald-100 bg-emerald-50 p-3 text-xs font-bold text-emerald-700"><b className="block text-lg text-emerald-950">{row.lesson_summary.logged_expected_sessions}/{row.lesson_summary.expected_sessions}</b>Present days with lessons</div>
                                <div className="rounded-2xl border border-amber-100 bg-amber-50 p-3 text-xs font-bold text-amber-700"><b className="block text-lg text-amber-950">{row.lesson_summary.missing_sessions}</b>Present days missing lessons</div>
                                <div className={`rounded-2xl border p-3 text-xs font-bold ${row.lesson_summary.completed ? "border-emerald-100 bg-emerald-50 text-emerald-700" : "border-slate-200 bg-slate-100 text-slate-600"}`}><b className="block text-lg">{row.lesson_summary.completed ? "Matched" : "Pending"}</b>{row.lesson_summary.bonus_eligible ? "Bonus eligible" : row.lesson_summary.month_closed ? "No automatic bonus" : "Final check at month end"}</div>
                              </div>
                              {(row.lesson_summary.unexpected_sessions || 0) > 0 && <div className="mt-2 rounded-xl border border-rose-200 bg-rose-50 px-3 py-2 text-xs font-bold text-rose-700">{row.lesson_summary.unexpected_sessions} lesson day(s) do not have matching Present attendance and must be corrected.</div>}
                              </>
                            )}

                            <div className="mt-3 flex flex-wrap gap-2 text-xs font-bold text-slate-600">
                              <span className="inline-flex items-center gap-1 rounded-full bg-white px-3 py-1.5"><CalendarDays size={14} /> {row.class_days.join(", ") || "No schedule days"}</span>
                              <span className="rounded-full bg-white px-3 py-1.5">{row.time_slots.map(formatTime12).join(", ") || "No time recorded"}</span>
                              <span className="rounded-full bg-white px-3 py-1.5">Assigned {row.assignment_start} to {row.assignment_end}</span>
                            </div>

                            <div className="mt-4 overflow-x-auto rounded-2xl border border-slate-200 bg-white p-3">
                              <div className="flex min-w-max gap-2">
                                {row.attendance.map((day) => (
                                  <div key={day.date} className="w-[72px] shrink-0 text-center">
                                    <div className={`rounded-xl px-1 py-2 text-[10px] font-black uppercase ${STATUS_STYLE[day.status] || STATUS_STYLE.not_marked}`}>
                                      {day.status === "not_marked" ? "—" : day.status.slice(0, 3)}
                                    </div>
                                    <div className="mt-1 text-[10px] font-bold text-slate-500">{formatDate(day.date)}</div>
                                    <div className="mt-1 flex items-center justify-center gap-1 text-[9px] font-bold text-slate-400">
                                      {day.scheduled ? "Class" : ""}{day.lesson_logged ? <CheckCircle2 size={10} className="text-emerald-500" /> : null}
                                    </div>
                                  </div>
                                ))}
                              </div>
                            </div>
                          </div>
                        )}
                      </article>
                    );
                  })}
                </section>
              )}
            </div>
          )}
        </div>
      </div>
    </div>
  );
}

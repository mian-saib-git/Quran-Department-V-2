/* IVS_TUITION_STUDENT_PORTAL_V42_COMPACT_CONNECTED_HOOK */
.lanyard-wrapper {
  position: absolute;
  inset: 0;
  z-index: 70;
  width: 100%;
  height: 100%;
  min-height: 100%;
  overflow: visible;
  pointer-events: none;
  touch-action: pan-y;
  user-select: none;
  -webkit-user-select: none;
}

.lanyard-wrapper canvas {
  position: absolute;
  inset: 0;
  z-index: 2;
  display: block;
  width: 100% !important;
  height: 100% !important;
  overflow: visible;
  outline: none;
  pointer-events: none;
}

.tuition-overview-lanyard-layer {
  position: absolute;
  top: -92px;
  right: 0;
  bottom: 0;
  left: 0;
  min-height: calc(100% + 92px);
  z-index: 70;
  overflow: visible;
  pointer-events: none;
  isolation: isolate;
  user-select: none;
  -webkit-user-select: none;
}

body.lanyard-drag-active,
body.lanyard-drag-active * {
  user-select: none !important;
  -webkit-user-select: none !important;
  -webkit-touch-callout: none !important;
  cursor: grabbing !important;
}

@media (max-width: 1439px) {
  .tuition-overview-lanyard-layer {
    top: -76px;
    min-height: calc(100% + 76px);
  }
}

@media (max-width: 1023px) {
  .tuition-overview-lanyard-layer {
    top: -58px;
    right: -8px;
    left: -8px;
    min-height: calc(100% + 58px);
  }
}

@media (max-width: 639px) {
  .tuition-overview-lanyard-layer {
    top: -36px;
    right: -6px;
    left: -6px;
    min-height: calc(100% + 36px);
  }

  .lanyard-wrapper {
    touch-action: pan-y;
  }
}

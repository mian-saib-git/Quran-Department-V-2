import React, { useCallback, useEffect, useMemo, useRef, useState } from "react";
import {
  Award,
  Calculator,
  ChevronLeft,
  ChevronRight,
  CircleDollarSign,
  Edit3,
  GraduationCap,
  Loader2,
  Plus,
  RefreshCw,
  Save,
  Settings2,
  Trash2,
  UsersRound,
  X,
} from "lucide-react";

import {
  getQuranSalaryDashboard,
  updateQuranSalarySettings,
  updateQuranSalarySlip,
  type AchievementPayout,
  type QuranSalaryConfiguration,
  type QuranSalaryDashboardResponse,
  type QuranTeacherSalarySlip,
  type SalaryDeductions,
  type SalaryTier,
} from "../services/djangoApiService";
import { useAcademyWS } from "../hooks/useAcademyWS";
import QuranSalaryProofModal from "./QuranSalaryProofModal";

const PKR = new Intl.NumberFormat("en-PK", {
  style: "currency",
  currency: "PKR",
  maximumFractionDigits: 0,
});

function money(value: unknown) {
  const number = Number(value || 0);
  return PKR.format(Number.isFinite(number) ? number : 0);
}

function monthLabel(month: number, year: number) {
  return new Date(year, month - 1, 1).toLocaleDateString(undefined, {
    month: "long",
    year: "numeric",
  });
}

function NumberInput({ value, onChange }: { value: any; onChange: (value: string) => void }) {
  return (
    <input
      type="number"
      min="0"
      step="1"
      value={value ?? ""}
      onChange={(event) => onChange(event.target.value)}
      className="w-full rounded-2xl border border-slate-200 bg-white px-3 py-2.5 text-sm font-black text-slate-900 outline-none focus:border-indigo-300"
    />
  );
}

function Metric({
  label,
  value,
  accent = "indigo",
  onClick,
}: {
  label: string;
  value: React.ReactNode;
  accent?: "indigo" | "emerald" | "amber" | "rose" | "cyan" | "slate";
  onClick?: () => void;
}) {
  const styles = {
    indigo: "border-indigo-100 bg-indigo-50 text-indigo-700",
    emerald: "border-emerald-100 bg-emerald-50 text-emerald-700",
    amber: "border-amber-100 bg-amber-50 text-amber-700",
    rose: "border-rose-100 bg-rose-50 text-rose-700",
    cyan: "border-cyan-100 bg-cyan-50 text-cyan-700",
    slate: "border-slate-200 bg-slate-100 text-slate-700",
  };
  const Tag = onClick ? "button" : "div";
  return (
    <Tag
      type={onClick ? "button" : undefined}
      onClick={onClick}
      className={`rounded-2xl border px-3 py-3 text-left ${styles[accent]} ${onClick ? "transition hover:-translate-y-0.5 hover:shadow-md" : ""}`}
    >
      <div className="text-[10px] font-black uppercase tracking-[0.12em] opacity-70">{label}</div>
      <div className="mt-1 text-lg font-black">{value}</div>
      {onClick && <div className="mt-1 text-[10px] font-black opacity-70">View proof</div>}
    </Tag>
  );
}

function BreakdownButton({ label, value, onClick }: { label: string; value: number; onClick: () => void }) {
  return (
    <button type="button" onClick={onClick} className="flex w-full items-center justify-between gap-3 rounded-xl px-2 py-1.5 text-left text-xs font-bold text-slate-600 transition hover:bg-white hover:text-indigo-700">
      <span>{label}</span><b className="text-slate-950">{value || 0}</b>
    </button>
  );
}

function SettingsPanel({ config, onSaved }: { config: QuranSalaryConfiguration; onSaved: (value: QuranSalaryConfiguration) => void }) {
  const [standard, setStandard] = useState<SalaryTier[]>(config.standard_tiers || []);
  const [threeDay, setThreeDay] = useState<SalaryTier[]>(config.three_day_tiers || []);
  const [bonuses, setBonuses] = useState(config.bonus_rates);
  const [payouts, setPayouts] = useState<AchievementPayout[]>(config.achievement_payouts || []);
  const [nightStart, setNightStart] = useState(config.night_start);
  const [nightEnd, setNightEnd] = useState(config.night_end);
  const [saving, setSaving] = useState(false);
  const [message, setMessage] = useState("");

  const updateTier = (setRows: React.Dispatch<React.SetStateAction<SalaryTier[]>>, index: number, key: keyof SalaryTier, value: string) => {
    setRows((rows) => rows.map((row, rowIndex) => rowIndex === index ? { ...row, [key]: key === "max" && value === "" ? null : Number(value || 0) } : row));
  };

  const save = async () => {
    setSaving(true); setMessage("");
    try {
      const saved = await updateQuranSalarySettings({
        standard_tiers: standard,
        three_day_tiers: threeDay,
        bonus_rates: bonuses,
        achievement_payouts: payouts,
        night_start: nightStart,
        night_end: nightEnd,
      });
      onSaved(saved);
      setMessage("Salary configuration saved.");
    } catch (error: any) {
      setMessage(error?.message || "Could not save salary settings.");
    } finally {
      setSaving(false);
    }
  };

  const TierTable = ({ title, rows, setRows }: { title: string; rows: SalaryTier[]; setRows: React.Dispatch<React.SetStateAction<SalaryTier[]>> }) => (
    <section className="rounded-[26px] border border-slate-200 bg-white p-4 sm:p-5">
      <h4 className="font-black text-slate-950">{title}</h4>
      <div className="mt-4 space-y-2">
        {rows.map((row, index) => (
          <div key={index} className="grid grid-cols-3 gap-2">
            <NumberInput value={row.min} onChange={(value) => updateTier(setRows, index, "min", value)} />
            <input type="number" min="0" value={row.max ?? ""} placeholder="No max" onChange={(event) => updateTier(setRows, index, "max", event.target.value)} className="w-full rounded-2xl border border-slate-200 bg-white px-3 py-2.5 text-sm font-black outline-none focus:border-indigo-300" />
            <NumberInput value={row.rate} onChange={(value) => updateTier(setRows, index, "rate", value)} />
          </div>
        ))}
      </div>
    </section>
  );

  return (
    <div className="space-y-4">
      {message && <div className="rounded-2xl border border-indigo-200 bg-indigo-50 p-4 text-sm font-bold text-indigo-700">{message}</div>}
      <div className="grid grid-cols-1 gap-4 xl:grid-cols-2">
        <TierTable title="3+ Days Class Tiers (Min · Max · PKR)" rows={standard} setRows={setStandard} />
        <TierTable title="Exactly 3-Day Class Tiers (Min · Max · PKR)" rows={threeDay} setRows={setThreeDay} />
        <section className="rounded-[26px] border border-slate-200 bg-white p-4 sm:p-5">
          <h4 className="font-black text-slate-950">Flat bonus rates</h4>
          <div className="mt-4 grid grid-cols-2 gap-3">
            {(["english", "lesson_filled", "night", "reference"] as const).map((key) => (
              <label key={key} className="text-xs font-black capitalize text-slate-600">
                {key.replace("_", " ")}
                <NumberInput value={bonuses[key]} onChange={(value) => setBonuses((prev) => ({ ...prev, [key]: Number(value || 0) }))} />
              </label>
            ))}
          </div>
          <div className="mt-4 grid grid-cols-2 gap-3">
            <label className="text-xs font-black text-slate-600">Night starts<input type="time" value={nightStart} onChange={(e) => setNightStart(e.target.value)} className="mt-1 w-full rounded-2xl border border-slate-200 px-3 py-2.5 font-black" /></label>
            <label className="text-xs font-black text-slate-600">Night ends<input type="time" value={nightEnd} onChange={(e) => setNightEnd(e.target.value)} className="mt-1 w-full rounded-2xl border border-slate-200 px-3 py-2.5 font-black" /></label>
          </div>
        </section>
        <section className="rounded-[26px] border border-slate-200 bg-white p-4 sm:p-5">
          <h4 className="font-black text-slate-950">Achievement payouts</h4>
          <div className="mt-4 space-y-2">
            {payouts.map((row, index) => (
              <div key={index} className="grid grid-cols-3 gap-2">
                <NumberInput value={row.min_points} onChange={(value) => setPayouts((items) => items.map((item, i) => i === index ? { ...item, min_points: Number(value || 0) } : item))} />
                <NumberInput value={row.max_points} onChange={(value) => setPayouts((items) => items.map((item, i) => i === index ? { ...item, max_points: Number(value || 0) } : item))} />
                <NumberInput value={row.amount} onChange={(value) => setPayouts((items) => items.map((item, i) => i === index ? { ...item, amount: Number(value || 0) } : item))} />
              </div>
            ))}
          </div>
        </section>
      </div>
      <button type="button" onClick={() => void save()} disabled={saving} className="inline-flex items-center gap-2 rounded-2xl bg-indigo-600 px-5 py-3 text-sm font-black text-white disabled:opacity-60">
        {saving ? <Loader2 className="animate-spin" size={17} /> : <Save size={17} />} Save Configuration
      </button>
    </div>
  );
}

function SalarySlipModal({ slip, onClose, onSaved }: { slip: QuranTeacherSalarySlip; onClose: () => void; onSaved: (slip: QuranTeacherSalarySlip) => void }) {
  const snapshot = slip.calculated_snapshot || {};
  const calculated = snapshot.calculated_components || {};
  const [behaviorGood, setBehaviorGood] = useState(Boolean(slip.behavior_good));
  const [status, setStatus] = useState<"draft" | "processed">(slip.status);
  const [note, setNote] = useState(slip.admin_note || "");
  const [overrides, setOverrides] = useState<Record<string, string>>(() => Object.fromEntries(Object.entries(slip.override_values || {}).map(([key, value]) => [key, String(value ?? "")])));
  const [bonuses, setBonuses] = useState<Array<{ reason: string; amount: string }>>((slip.other_bonuses || []).map((item) => ({ reason: item.reason, amount: String(item.amount) })));
  const initialDeductions = slip.deductions || {};
  const [deductions, setDeductions] = useState<Record<string, string>>({
    food: String(initialDeductions.food || ""),
    drop_leave: String(initialDeductions.drop_leave || ""),
    fine: String(initialDeductions.fine || ""),
    imam_hadya: String(initialDeductions.imam_hadya || ""),
    advance: String(initialDeductions.advance || ""),
  });
  const [manualDeductions, setManualDeductions] = useState<Array<{ reason: string; amount: string }>>((initialDeductions.manual || []).map((item) => ({ reason: item.reason, amount: String(item.amount) })));
  const [halfRows, setHalfRows] = useState<Array<{ student_id: number; student_name: string; amount: string }>>((snapshot.half_class_rows || []).map((item: any) => ({
    student_id: Number(item.student_id),
    student_name: String(item.student_name || "Student"),
    amount: String((slip.half_class_overrides || []).find((row) => Number(row.student_id) === Number(item.student_id))?.amount ?? item.amount ?? 0),
  })));
  const [saving, setSaving] = useState(false);
  const [message, setMessage] = useState("");

  const componentRows = [
    ["base_salary", "Base class salary", calculated.base_salary],
    ["english_bonus", "English language bonus", calculated.english_bonus],
    ["lesson_bonus", "Lesson filled bonus", calculated.lesson_bonus],
    ["night_bonus", "Night shift bonus", calculated.night_bonus],
    ["reference_bonus", "Reference bonus", calculated.reference_bonus],
    ["achievement_bonus", "Achievement payout", calculated.achievement_bonus],
    ["gross_total", "Gross salary override", slip.gross_total],
    ["final_total", "Net salary override", slip.final_total],
  ] as const;

  const save = async () => {
    setSaving(true); setMessage("");
    try {
      const cleanedOverrides: Record<string, number> = {};
      Object.entries(overrides).forEach(([key, value]) => { if (value.trim() !== "") cleanedOverrides[key] = Number(value || 0); });
      const manual = manualDeductions.filter((item) => item.reason.trim() && Number(item.amount || 0) > 0);
      if (manualDeductions.some((item) => Number(item.amount || 0) > 0 && !item.reason.trim())) throw new Error("A reason is mandatory for every manual cutting.");
      const saved = await updateQuranSalarySlip(slip.id, {
        behavior_good: behaviorGood,
        status,
        admin_note: note,
        override_values: cleanedOverrides,
        other_bonuses: bonuses.filter((item) => item.reason.trim() && Number(item.amount || 0) !== 0).map((item) => ({ reason: item.reason.trim(), amount: Number(item.amount || 0) })),
        deductions: {
          food: Number(deductions.food || 0),
          drop_leave: Number(deductions.drop_leave || 0),
          fine: Number(deductions.fine || 0),
          imam_hadya: Number(deductions.imam_hadya || 0),
          advance: Number(deductions.advance || 0),
          manual: manual.map((item) => ({ reason: item.reason.trim(), amount: Number(item.amount || 0) })),
        },
        half_class_overrides: halfRows.map((item) => ({ student_id: item.student_id, amount: Number(item.amount || 0) })),
      });
      onSaved(saved); onClose();
    } catch (error: any) {
      setMessage(error?.message || "Could not save salary slip.");
    } finally { setSaving(false); }
  };

  return (
    <div className="fixed inset-0 z-[120] flex items-end justify-center bg-slate-950/55 p-0 backdrop-blur-sm sm:items-center sm:p-4">
      <div className="max-h-[94vh] w-full overflow-y-auto rounded-t-[30px] border border-white/70 bg-slate-50 shadow-2xl sm:max-w-5xl sm:rounded-[32px]">
        <div className="sticky top-0 z-10 flex items-start justify-between gap-4 border-b border-slate-200 bg-white/95 p-5 backdrop-blur-xl sm:p-6">
          <div><div className="text-xs font-black uppercase tracking-[0.16em] text-indigo-600">Monthly salary slip</div><h3 className="mt-1 text-xl font-black text-slate-950 sm:text-2xl">{slip.teacher_name}</h3><p className="mt-1 text-sm font-semibold text-slate-500">{monthLabel(slip.month, slip.year)} · @{slip.teacher_username}</p></div>
          <button type="button" onClick={onClose} className="flex h-11 w-11 shrink-0 items-center justify-center rounded-2xl border border-slate-200 bg-white text-slate-500"><X size={20} /></button>
        </div>
        <div className="space-y-5 p-4 sm:p-6">
          {message && <div className="rounded-2xl border border-rose-200 bg-rose-50 p-4 text-sm font-bold text-rose-700">{message}</div>}
          <div className="grid grid-cols-2 gap-3 lg:grid-cols-4">
            <Metric label="Active classes" value={snapshot.final_active_classes || 0} />
            <Metric label="Gross salary" value={money(slip.gross_total)} accent="cyan" />
            <Metric label="Total cuttings" value={money(slip.deduction_total)} accent="rose" />
            <Metric label="Net salary" value={money(slip.final_total)} accent="emerald" />
          </div>

          <section className="rounded-[26px] border border-slate-200 bg-white p-4 sm:p-5">
            <h4 className="font-black text-slate-950">Calculated values and overrides</h4>
            <p className="mt-1 text-xs font-semibold text-slate-500">Leave an override blank to use the verified automatic value.</p>
            <div className="mt-4 grid grid-cols-1 gap-3 md:grid-cols-2">
              {componentRows.map(([key, label, value]) => (
                <label key={key} className="rounded-2xl border border-slate-200 bg-slate-50 p-3">
                  <div className="flex items-center justify-between gap-3 text-xs font-black text-slate-600"><span>{label}</span><span className="text-slate-950">Auto: {money(value)}</span></div>
                  <input type="number" min="0" placeholder="Use automatic value" value={overrides[key] || ""} onChange={(e) => setOverrides((prev) => ({ ...prev, [key]: e.target.value }))} className="mt-2 w-full rounded-xl border border-slate-200 bg-white px-3 py-2 text-sm font-black outline-none focus:border-indigo-300" />
                </label>
              ))}
            </div>
          </section>

          <section className="rounded-[26px] border border-rose-200 bg-rose-50/50 p-4 sm:p-5">
            <h4 className="font-black text-rose-950">Fines, cuttings and deductions</h4>
            <p className="mt-1 text-xs font-semibold text-rose-700">These values are subtracted from gross salary to produce the net salary.</p>
            <div className="mt-4 grid grid-cols-1 gap-3 sm:grid-cols-2 lg:grid-cols-3">
              {[
                ["food", "Food Cutting"], ["drop_leave", "Drop & Leave Cutting"], ["fine", "Fine Cutting"], ["imam_hadya", "Imam Hadya"], ["advance", "Advance Cutting"],
              ].map(([key, label]) => <label key={key} className="text-xs font-black text-rose-900">{label}<NumberInput value={deductions[key]} onChange={(value) => setDeductions((prev) => ({ ...prev, [key]: value }))} /></label>)}
            </div>
            <div className="mt-4 space-y-2">
              {manualDeductions.map((item, index) => (
                <div key={index} className="grid grid-cols-1 gap-2 rounded-2xl border border-rose-200 bg-white p-3 sm:grid-cols-[1fr_180px_44px]">
                  <input value={item.reason} onChange={(e) => setManualDeductions((rows) => rows.map((row, i) => i === index ? { ...row, reason: e.target.value } : row))} placeholder="Mandatory deduction reason" className="rounded-xl border border-slate-200 px-3 py-2 text-sm font-bold outline-none" />
                  <NumberInput value={item.amount} onChange={(value) => setManualDeductions((rows) => rows.map((row, i) => i === index ? { ...row, amount: value } : row))} />
                  <button type="button" onClick={() => setManualDeductions((rows) => rows.filter((_, i) => i !== index))} className="flex h-11 items-center justify-center rounded-xl border border-rose-200 text-rose-600"><Trash2 size={17} /></button>
                </div>
              ))}
              <button type="button" onClick={() => setManualDeductions((rows) => [...rows, { reason: "", amount: "" }])} className="inline-flex items-center gap-2 rounded-xl border border-rose-200 bg-white px-3 py-2 text-xs font-black text-rose-700"><Plus size={15} /> Add manual cutting</button>
            </div>
          </section>

          {halfRows.length > 0 && (
            <section className="rounded-[26px] border border-amber-200 bg-amber-50/60 p-4 sm:p-5">
              <h4 className="font-black text-amber-950">Auto-detected half-month classes: {halfRows.length}</h4>
              <p className="mt-1 text-xs font-semibold text-amber-700">The system detects the count from enrollment and transfer history. Enter only the salary amount manually.</p>
              <div className="mt-4 space-y-2">
                {halfRows.map((item, index) => <div key={item.student_id} className="grid grid-cols-1 gap-2 rounded-2xl border border-amber-200 bg-white p-3 sm:grid-cols-[1fr_180px] sm:items-center"><div className="font-black text-slate-900">{item.student_name}</div><NumberInput value={item.amount} onChange={(value) => setHalfRows((rows) => rows.map((row, i) => i === index ? { ...row, amount: value } : row))} /></div>)}
              </div>
            </section>
          )}

          <section className="rounded-[26px] border border-slate-200 bg-white p-4 sm:p-5">
            <div className="flex items-center justify-between gap-3"><h4 className="font-black text-slate-950">Other bonuses</h4><button type="button" onClick={() => setBonuses((rows) => [...rows, { reason: "", amount: "" }])} className="inline-flex items-center gap-1 rounded-xl border border-indigo-200 px-3 py-2 text-xs font-black text-indigo-700"><Plus size={14} /> Add</button></div>
            <div className="mt-3 space-y-2">{bonuses.map((item, index) => <div key={index} className="grid grid-cols-1 gap-2 rounded-2xl border border-slate-200 bg-slate-50 p-3 sm:grid-cols-[1fr_180px_44px]"><input value={item.reason} onChange={(e) => setBonuses((rows) => rows.map((row, i) => i === index ? { ...row, reason: e.target.value } : row))} placeholder="Bonus reason" className="rounded-xl border border-slate-200 px-3 py-2 text-sm font-bold" /><NumberInput value={item.amount} onChange={(value) => setBonuses((rows) => rows.map((row, i) => i === index ? { ...row, amount: value } : row))} /><button type="button" onClick={() => setBonuses((rows) => rows.filter((_, i) => i !== index))} className="flex h-11 items-center justify-center rounded-xl border border-rose-200 text-rose-600"><Trash2 size={17} /></button></div>)}</div>
          </section>

          <section className="rounded-[26px] border border-slate-200 bg-white p-4 sm:p-5">
            <label className="flex items-center justify-between gap-4 rounded-2xl bg-emerald-50 p-4"><div><div className="font-black text-emerald-950">Good behavior point</div><div className="text-xs font-semibold text-emerald-700">Adds one achievement point when approved.</div></div><input type="checkbox" checked={behaviorGood} onChange={(e) => setBehaviorGood(e.target.checked)} className="h-5 w-5 accent-emerald-600" /></label>
            <div className="mt-3 grid grid-cols-1 gap-3 sm:grid-cols-2"><label className="text-xs font-black text-slate-600">Slip status<select value={status} onChange={(e) => setStatus(e.target.value as any)} className="mt-1 w-full rounded-2xl border border-slate-200 bg-white px-3 py-3 text-sm font-black"><option value="draft">Draft</option><option value="processed">Processed</option></select></label><label className="text-xs font-black text-slate-600">Administrator note<textarea value={note} onChange={(e) => setNote(e.target.value)} className="mt-1 min-h-[80px] w-full rounded-2xl border border-slate-200 p-3 text-sm font-semibold" /></label></div>
          </section>

          <div className="flex flex-col-reverse gap-2 sm:flex-row sm:justify-end"><button type="button" onClick={onClose} className="rounded-2xl border border-slate-200 bg-white px-5 py-3 text-sm font-black text-slate-600">Cancel</button><button type="button" onClick={() => void save()} disabled={saving} className="inline-flex items-center justify-center gap-2 rounded-2xl bg-indigo-600 px-5 py-3 text-sm font-black text-white disabled:opacity-60">{saving ? <Loader2 className="animate-spin" size={17} /> : <Save size={17} />} Save Salary Slip</button></div>
        </div>
      </div>
    </div>
  );
}

export default function TeacherSalaryManagement() {
  const today = useMemo(() => new Date(), []);
  const [month, setMonth] = useState(today.getMonth() + 1);
  const [year, setYear] = useState(today.getFullYear());
  const [page, setPage] = useState(1);
  const [pageSize] = useState(12);
  const [data, setData] = useState<QuranSalaryDashboardResponse | null>(null);
  const [loading, setLoading] = useState(false);
  const [message, setMessage] = useState("");
  const [view, setView] = useState<"dashboard" | "settings">("dashboard");
  const [selectedSlip, setSelectedSlip] = useState<QuranTeacherSalarySlip | null>(null);
  const [proof, setProof] = useState<{ teacherId: number; metric: string } | null>(null);
  const requestId = useRef(0);

  const load = useCallback(async () => {
    const currentRequest = ++requestId.current;
    setLoading(true); setMessage("");
    try {
      const response = await getQuranSalaryDashboard(month, year, page, pageSize);
      if (currentRequest !== requestId.current) return;
      if (Number(response.month) !== month || Number(response.year) !== year) throw new Error("The server returned a different salary month. Please refresh and try again.");
      setData(response);
    } catch (error: any) {
      if (currentRequest === requestId.current) setMessage(error?.message || "Could not load teacher salaries.");
    } finally {
      if (currentRequest === requestId.current) setLoading(false);
    }
  }, [month, year, page, pageSize]);

  useEffect(() => { void load(); }, [load]);
  useAcademyWS((event) => { const name = String((event as any)?.event || ""); if (name.includes("salary") || name.includes("attendance") || name.includes("account")) void load(); });

  const changeMonth = (value: number) => { setPage(1); setSelectedSlip(null); setMonth(value); };
  const changeYear = (value: number) => { setPage(1); setSelectedSlip(null); setYear(value); };
  const years = useMemo(() => Array.from({ length: 10 }, (_, index) => today.getFullYear() - 6 + index), [today]);
  const teacherRows = data?.teachers || [];
  const settings = data?.configuration || null;

  const openProof = (teacherId: number, metric: string) => setProof({ teacherId, metric });

  return (
    <div className="space-y-5">
      <section className="rounded-[30px] border border-slate-200/80 bg-white/90 p-5 shadow-[0_18px_55px_rgba(15,23,42,0.08)] sm:p-6">
        <div className="flex flex-col gap-4 xl:flex-row xl:items-center xl:justify-between">
          <div className="flex items-start gap-3"><div className="flex h-12 w-12 shrink-0 items-center justify-center rounded-2xl border border-indigo-100 bg-indigo-50 text-indigo-600"><CircleDollarSign size={24} /></div><div><h2 className="text-xl font-black text-slate-950 sm:text-2xl">Teacher Salary Management</h2><p className="mt-1 text-sm font-semibold text-slate-500">Historical monthly salaries, verified proofs, bonuses, cuttings, pagination, and administrator overrides.</p></div></div>
          <div className="flex flex-col gap-2 sm:flex-row">
            <select value={month} onChange={(e) => changeMonth(Number(e.target.value))} className="rounded-2xl border border-slate-200 bg-white px-4 py-3 text-sm font-black outline-none">{Array.from({ length: 12 }, (_, index) => <option key={index + 1} value={index + 1}>{new Date(2026, index, 1).toLocaleDateString(undefined, { month: "long" })}</option>)}</select>
            <select value={year} onChange={(e) => changeYear(Number(e.target.value))} className="rounded-2xl border border-slate-200 bg-white px-4 py-3 text-sm font-black outline-none">{years.map((item) => <option key={item} value={item}>{item}</option>)}</select>
            <button type="button" onClick={() => void load()} className="inline-flex items-center justify-center gap-2 rounded-2xl border border-slate-200 bg-white px-4 py-3 text-sm font-black text-slate-700"><RefreshCw size={17} className={loading ? "animate-spin" : ""} /> Refresh</button>
          </div>
        </div>
        <div className="mt-5 grid grid-cols-2 gap-3 lg:grid-cols-4"><Metric label="Teachers" value={data?.summary.teachers || 0} /><Metric label="This page" value={data?.summary.page_teachers || 0} accent="slate" /><Metric label="Processed" value={data?.summary.processed || 0} accent="emerald" /><Metric label="Page net payout" value={money(data?.summary.page_payout || 0)} accent="cyan" /></div>
        <div className="mt-5 inline-flex max-w-full overflow-x-auto rounded-2xl border border-slate-200 bg-slate-50 p-1"><button type="button" onClick={() => setView("dashboard")} className={`whitespace-nowrap rounded-xl px-4 py-2 text-sm font-black ${view === "dashboard" ? "bg-white text-indigo-700 shadow-sm" : "text-slate-500"}`}><Calculator className="mr-1.5 inline" size={16} />Salary Dashboard</button><button type="button" onClick={() => setView("settings")} className={`whitespace-nowrap rounded-xl px-4 py-2 text-sm font-black ${view === "settings" ? "bg-white text-indigo-700 shadow-sm" : "text-slate-500"}`}><Settings2 className="mr-1.5 inline" size={16} />Configuration</button></div>
      </section>

      {message && <div className="rounded-2xl border border-rose-200 bg-rose-50 p-4 text-sm font-bold text-rose-700">{message}</div>}
      {view === "settings" && settings ? <SettingsPanel config={settings} onSaved={(config) => setData((prev) => prev ? { ...prev, configuration: config } : prev)} /> : loading && !data ? <div className="flex min-h-[360px] items-center justify-center rounded-[30px] border border-slate-200 bg-white text-sm font-bold text-slate-500"><Loader2 className="mr-2 animate-spin" size={18} /> Loading {monthLabel(month, year)} salaries...</div> : (
        <div className="space-y-4">
          {loading && <div className="rounded-2xl border border-indigo-200 bg-indigo-50 p-3 text-center text-xs font-black text-indigo-700">Refreshing {monthLabel(month, year)}...</div>}
          {teacherRows.map((slip) => {
            const snapshot: any = slip.calculated_snapshot || {};
            const type = snapshot.student_type_breakdown || {};
            const statuses = snapshot.class_status_breakdown || {};
            return (
              <article key={slip.id} className="overflow-hidden rounded-[30px] border border-slate-200/80 bg-white shadow-[0_16px_45px_rgba(15,23,42,0.06)]">
                <div className="flex flex-col gap-4 border-b border-slate-200 p-5 lg:flex-row lg:items-center lg:justify-between">
                  <div className="flex min-w-0 items-center gap-3"><div className="flex h-12 w-12 shrink-0 items-center justify-center rounded-2xl border border-indigo-100 bg-indigo-50 text-indigo-600"><GraduationCap size={23} /></div><div className="min-w-0"><h3 className="break-words text-lg font-black text-slate-950">{slip.teacher_name}</h3><p className="mt-1 text-xs font-bold text-slate-500">@{slip.teacher_username} · {monthLabel(slip.month, slip.year)} · {slip.status === "processed" ? "Processed" : "Draft"}</p></div></div>
                  <div className="grid grid-cols-1 gap-2 sm:grid-cols-3 sm:items-center"><div className="rounded-2xl bg-cyan-50 px-4 py-3 text-cyan-800"><div className="text-[10px] font-black uppercase">Gross</div><div className="text-lg font-black">{money(slip.gross_total)}</div></div><div className="rounded-2xl bg-rose-50 px-4 py-3 text-rose-800"><div className="text-[10px] font-black uppercase">Cuttings</div><div className="text-lg font-black">{money(slip.deduction_total)}</div></div><button type="button" onClick={() => setSelectedSlip(slip)} className="inline-flex h-full items-center justify-center gap-2 rounded-2xl bg-slate-950 px-4 py-3 text-sm font-black text-white"><Edit3 size={17} /> Net {money(slip.final_total)}</button></div>
                </div>

                <div className="grid grid-cols-1 gap-4 p-5 xl:grid-cols-3">
                  <section className="rounded-[24px] border border-slate-200 bg-slate-50/70 p-4"><div className="flex items-center gap-2 font-black text-slate-950"><UsersRound size={18} className="text-indigo-600" /> Student Type Breakdown</div><div className="mt-3 space-y-1"><BreakdownButton label="Old Students" value={type.old_students} onClick={() => openProof(slip.teacher_id, "old_students")} /><BreakdownButton label="New Trials" value={type.new_trials} onClick={() => openProof(slip.teacher_id, "new_trials")} /><BreakdownButton label="Transferred In" value={type.transferred_from_teacher} onClick={() => openProof(slip.teacher_id, "transferred_from_teacher")} /><BreakdownButton label="Returned Leave" value={type.returns_from_leave} onClick={() => openProof(slip.teacher_id, "returns_from_leave")} /><BreakdownButton label="Transferred Out" value={type.transferred_to_other_teachers} onClick={() => openProof(slip.teacher_id, "transferred_to_other_teachers")} /></div></section>
                  <section className="rounded-[24px] border border-slate-200 bg-slate-50/70 p-4"><div className="flex items-center gap-2 font-black text-slate-950"><Award size={18} className="text-emerald-600" /> Class Status Breakdown</div><div className="mt-3 space-y-1"><BreakdownButton label="Running" value={statuses.running} onClick={() => openProof(slip.teacher_id, "running")} /><BreakdownButton label="On Leave" value={statuses.on_leave} onClick={() => openProof(slip.teacher_id, "on_leave")} /><BreakdownButton label="Old Dropped" value={statuses.old_dropped} onClick={() => openProof(slip.teacher_id, "old_dropped")} /><BreakdownButton label="Trial Dropped" value={statuses.trial_dropped} onClick={() => openProof(slip.teacher_id, "trial_dropped")} /><BreakdownButton label="Other Dropped" value={statuses.old_dropped_other} onClick={() => openProof(slip.teacher_id, "old_dropped_other")} /><BreakdownButton label="Not Counted" value={statuses.not_counted} onClick={() => openProof(slip.teacher_id, "not_counted")} /></div></section>
                  <section className="rounded-[24px] border border-slate-200 bg-slate-50/70 p-4"><div className="flex items-center gap-2 font-black text-slate-950"><CircleDollarSign size={18} className="text-amber-600" /> Salary & Performance Proofs</div><div className="mt-3 grid grid-cols-2 gap-2"><Metric label="Active" value={snapshot.final_active_classes || 0} onClick={() => openProof(slip.teacher_id, "active_classes")} /><Metric label="Half month" value={snapshot.half_classes || 0} accent="amber" onClick={() => openProof(slip.teacher_id, "half_classes")} /><Metric label="3+ days" value={snapshot.standard_classes || 0} accent="cyan" onClick={() => openProof(slip.teacher_id, "standard_classes")} /><Metric label="3 days" value={snapshot.three_day_classes || 0} accent="slate" onClick={() => openProof(slip.teacher_id, "three_day_classes")} /><Metric label="English" value={snapshot.english_class_count || 0} accent="cyan" onClick={() => openProof(slip.teacher_id, "english_classes")} /><Metric label="Night" value={snapshot.night_class_count || 0} accent="amber" onClick={() => openProof(slip.teacher_id, "night_classes")} /><Metric label="Lessons" value={snapshot.lesson_filled_count || 0} accent="emerald" onClick={() => openProof(slip.teacher_id, "lesson_filled")} /><Metric label="Attendance" value={`${snapshot.attendance_rate || 0}%`} accent="emerald" onClick={() => openProof(slip.teacher_id, "attendance")} /></div></section>
                </div>
              </article>
            );
          })}
          {teacherRows.length === 0 && !loading && <div className="rounded-[30px] border border-slate-200 bg-white p-12 text-center text-sm font-bold text-slate-500">No Quran teachers found for {monthLabel(month, year)}.</div>}

          {data && data.pagination.total_pages > 1 && <div className="flex flex-col gap-3 rounded-[24px] border border-slate-200 bg-white p-4 sm:flex-row sm:items-center sm:justify-between"><div className="text-sm font-bold text-slate-500">Page {data.pagination.page} of {data.pagination.total_pages} · {data.pagination.total_items} teachers</div><div className="flex gap-2"><button type="button" disabled={!data.pagination.has_previous || loading} onClick={() => setPage((value) => Math.max(1, value - 1))} className="inline-flex items-center gap-1 rounded-xl border border-slate-200 px-4 py-2 text-sm font-black disabled:opacity-40"><ChevronLeft size={16} /> Previous</button><button type="button" disabled={!data.pagination.has_next || loading} onClick={() => setPage((value) => value + 1)} className="inline-flex items-center gap-1 rounded-xl bg-indigo-600 px-4 py-2 text-sm font-black text-white disabled:opacity-40">Next <ChevronRight size={16} /></button></div></div>}
        </div>
      )}

      {selectedSlip && <SalarySlipModal slip={selectedSlip} onClose={() => setSelectedSlip(null)} onSaved={(saved) => setData((prev) => prev ? { ...prev, teachers: prev.teachers.map((item) => item.id === saved.id ? saved : item) } : prev)} />}
      {proof && <QuranSalaryProofModal teacherId={proof.teacherId} metric={proof.metric} month={month} year={year} onClose={() => setProof(null)} />}
    </div>
  );
}

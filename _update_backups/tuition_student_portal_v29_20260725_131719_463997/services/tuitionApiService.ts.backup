      subject__name: string;
      subject__code: string;
    }>;
  }>;
  students: Array<{
    id: number;
    user_id: number;
    name: string;
    username: string;
  }>;
  classes: TuitionClassLevel[];
  subjects: TuitionSubject[];
};

export type TuitionFoundation = {
  department: {
    id: number;
    name: string;
    code: string;
    department_type: string;
  };
  classes: TuitionClassLevel[];
  subjects: TuitionSubject[];
  features: Record<string, boolean>;
};


import { authenticatedRequest } from "./authenticatedRequest";


async function request<T>(path: string, options: RequestInit = {}): Promise<T> {
  return authenticatedRequest<T>(path, options);
}

function query(params?: Record<string, unknown>) {
  const search = new URLSearchParams();

  Object.entries(params || {}).forEach(([key, value]) => {
    if (value === undefined || value === null || value === "") return;
    search.set(key, String(value));
  });

  const text = search.toString();
  return text ? `?${text}` : "";
}

export type TuitionClassLevel = {
  id: number;
  code: string;
  name: string;
  board: string;
  sort_order: number;
  is_active: boolean;
};

export type TuitionSubject = {
  id: number;
  code: string;
  name: string;
  is_standard: boolean;
  sort_order: number;
  is_active: boolean;
};

export type TuitionAccount = {
  id: number;
  username: string;
  email: string;
  first_name: string;
  last_name: string;
  full_name: string;
  role: "teacher" | "student";
  global_is_active: boolean;
  tuition_access_active: boolean;
  institution_id: number;
  department_id: number;
  active_enrollment_count: number;
  teacher_profile: null | {
    id: number;
    father_name: string;
    phone: string;
    address: string;
    joining_date: string | null;
    notes: string;
    zoom_link: string;
    available_schedule_slots?: string[];
    capabilities: Array<{
      id: number;
      subject_id: number;
      subject_code: string;
      subject_name: string;
      is_active: boolean;
      notes: string;
    }>;
  };
  student_profile: null | {
    id: number;
    phone: string;
    notes: string;
    legacy_primary_teacher_id: number;
    legacy_primary_teacher_name: string;
  };
};

export type TuitionEnrollment = {
  id: number;
  student_id: number;
  student_user_id: number;
  student_name: string;
  teacher_id: number;
  teacher_user_id: number;
  teacher_name: string;
  program_type: "regular" | "crash";
  class_level_id: number | null;
  class_name: string;
  subject_id: number | null;
  subject_name: string;
  custom_class_name: string;
  custom_subject_name: string;
  start_date: string;
  end_date: string | null;
  notes: string;
  is_active: boolean;
  schedule_country?: string;
  schedule_slot?: string;
  schedule_label?: string;
  schedule_start_time?: string | null;
  schedule_end_time?: string | null;
  duration_minutes?: number;
  schedule_days?: string[];
  created_at: string;
  updated_at: string;
};

export type TuitionOptions = {
  teachers: Array<{
    id: number;
    user_id: number;
    name: string;
    username: string;

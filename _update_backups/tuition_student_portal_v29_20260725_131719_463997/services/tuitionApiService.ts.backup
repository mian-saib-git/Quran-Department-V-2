export type TuitionStudentBundleInput = {
  department_id?: number;
  bulk_import?: boolean;
  account: {
    username: string;
    password?: string;
    email?: string;
    first_name?: string;
    last_name?: string;
    phone?: string;
    notes?: string;
    tuition_access_active?: boolean;
  };
  enrollments: TuitionEnrollmentInput[];
};

export type TuitionStudentBundleResponse = {
  account: TuitionAccount;
  enrollments: TuitionEnrollment[];
};

export async function getTuitionFoundation(departmentId?: number) {
  return request<TuitionFoundation>(
    `/api/tuition/foundation/${query({ department_id: departmentId })}`
  );
}

export async function getTuitionAccounts(params: {
  department_id?: number;
  role: "teacher" | "student";
  search?: string;
  page?: number;
  page_size?: number;
}) {
  return request<{
    results: TuitionAccount[];
    counts: Record<string, number>;
    pagination: Record<string, number>;
  }>(`/api/tuition/accounts/${query(params)}`);
}

export async function createTuitionAccount(input: TuitionAccountInput) {
  return request<TuitionAccount>("/api/tuition/accounts/", {
    method: "POST",
    body: JSON.stringify(input),
  });
}

export async function updateTuitionAccount(
  userId: number,
  input: Record<string, unknown>
) {
  return request<TuitionAccount>(`/api/tuition/accounts/${userId}/`, {
    method: "PATCH",
    body: JSON.stringify(input),
  });
}

export async function removeTuitionAccount(
  userId: number,
  departmentId?: number,
  permanent = false
) {
  return request<{ detail: string }>(
    `/api/tuition/accounts/${userId}/${query({
      department_id: departmentId,
      permanent,
    })}`,
    { method: "DELETE" }
  );
}

export async function getTuitionOptions(departmentId?: number) {
  return request<TuitionOptions>(
    `/api/tuition/options/${query({ department_id: departmentId })}`
  );
}

export async function getTuitionEnrollments(
  params?: Record<string, unknown>
) {
  return request<{
    results: TuitionEnrollment[];
    pagination: Record<string, number>;
  }>(`/api/tuition/enrollments/${query(params)}`);
}

export async function createTuitionStudentBundle(
